@using CityWebsiteAuditDashboard.Models
@model CityWebsiteAuditDashboard.ViewModels.AccessibilityWorkflowRetestDetailsViewModel

@{
    ViewData["Title"] = "Formal Workflow Retest Details";

    int verificationCandidateCount =
        Model.Items.Count(item =>
            item.CanVerify);

    string workflowVerificationBadgeClass =
        Model.VerificationState switch
        {
            "Fully Verified" =>
                "text-bg-success",

            "Partially Verified" =>
                "text-bg-warning",

            _ =>
                "text-bg-secondary"
        };
}


<div class="container py-4">

    <div class="d-flex flex-wrap
                justify-content-between
                align-items-start
                gap-3
                mb-4">

        <div>

            <h1 class="h2 mb-1">
                Formal Workflow Retest Details
            </h1>

            <p class="text-muted mb-0">
                Saved full-workflow accessibility retest results for
                @Model.ApplicationName.
            </p>

        </div>


        <div class="d-flex flex-wrap gap-2">

            <a asp-controller="AccessibilityWorkflowRetests"
               asp-action="Index"
               asp-route-originalAuditRunId="@Model.OriginalAuditRunId"
               class="btn btn-outline-secondary">
                Back to Workflow Retests
            </a>

            <a asp-controller="AuthenticatedAudits"
               asp-action="Details"
               asp-route-id="@Model.OriginalAuditRunId"
               class="btn btn-outline-primary">
                View Original Audit
            </a>

            <a asp-controller="AuthenticatedAudits"
               asp-action="Details"
               asp-route-id="@Model.RetestAuditRunId"
               class="btn btn-primary">
                View Retest Audit
            </a>

        </div>

    </div>


    @if (TempData["WorkflowVerificationSuccess"]
        is string verificationSuccess)
    {
        <div class="alert alert-success"
             role="status">

            @verificationSuccess

        </div>
    }


    @if (TempData["WorkflowVerificationError"]
        is string verificationError)
    {
        <div class="alert alert-danger"
             role="alert">

            @verificationError

        </div>
    }


    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex flex-wrap
                        justify-content-between
                        align-items-center
                        gap-3">

                <div>

                    <div class="text-muted small mb-1">
                        Formal Workflow Retest Status
                    </div>

                    <div class="d-flex flex-wrap
                                align-items-center
                                gap-2">

                        <span class="badge
                                     @workflowVerificationBadgeClass
                                     fs-6">
                            @Model.VerificationState
                        </span>

                    </div>

                    @if (Model.NotDetected > 0)
                    {
                        <div class="small text-muted mt-2">

                            @Model.VerifiedFromThisRetest of
                            @Model.NotDetected issue(s) that were
                            Not Detected are currently verified from
                            this retest evidence.

                        </div>
                    }
                    else
                    {
                        <div class="small text-muted mt-2">

                            This retest did not produce any
                            Not Detected results eligible for verification.

                        </div>
                    }

                </div>


                @if (Model.NotDetected > 0)
                {
                    double verificationPercent =
                        Model.VerifiedFromThisRetest *
                        100.0 /
                        Model.NotDetected;

                    <div style="min-width: 220px;">

                        <div class="d-flex
                                    justify-content-between
                                    small
                                    mb-1">

                            <span>
                                Verification progress
                            </span>

                            <strong>
                                @verificationPercent.ToString("0.0")%
                            </strong>

                        </div>

                        <div class="progress"
                             role="progressbar"
                             aria-label="Formal workflow verification progress"
                             aria-valuenow="@verificationPercent"
                             aria-valuemin="0"
                             aria-valuemax="100"
                             style="height: 10px;">

                            <div class="progress-bar bg-success"
                                 style="width: @verificationPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;">
                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>


        <div class="card-footer bg-transparent">

            <p class="small text-muted mb-0">

                This status describes remediation verification workflow.
                It is not an ADA or WCAG compliance determination.

            </p>

        </div>

    </div>


    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-12 col-md-6 col-xl-3">

                    <div class="text-muted small">
                        Application
                    </div>

                    <div class="fw-semibold">
                        @Model.ApplicationName
                    </div>

                </div>


                <div class="col-12 col-md-6 col-xl-3">

                    <div class="text-muted small">
                        Original Audit
                    </div>

                    <div>

                        <a asp-controller="AuthenticatedAudits"
                           asp-action="Details"
                           asp-route-id="@Model.OriginalAuditRunId">

                            Run #@Model.OriginalAuditRunId

                        </a>

                    </div>

                </div>


                <div class="col-12 col-md-6 col-xl-3">

                    <div class="text-muted small">
                        Retest Audit
                    </div>

                    <div>

                        <a asp-controller="AuthenticatedAudits"
                           asp-action="Details"
                           asp-route-id="@Model.RetestAuditRunId">

                            Run #@Model.RetestAuditRunId

                        </a>

                    </div>

                </div>


                <div class="col-12 col-md-6 col-xl-3">

                    <div class="text-muted small">
                        Formal Retest Recorded
                    </div>

                    <div>
                        @Model.RetestedAt.ToString("MMM d, yyyy HH:mm:ss")
                        UTC
                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="row g-3 mb-4">

        <div class="col-6 col-md-4 col-xl-2">

            <article class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Tracked
                    </div>

                    <div class="fs-2 fw-bold">
                        @Model.TotalTracked
                    </div>

                </div>

            </article>

        </div>


        <div class="col-6 col-md-4 col-xl-2">

            <article class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Still Detected
                    </div>

                    <div class="fs-2 fw-bold text-danger">
                        @Model.StillDetected
                    </div>

                </div>

            </article>

        </div>


        <div class="col-6 col-md-4 col-xl-2">

            <article class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Not Detected
                    </div>

                    <div class="fs-2 fw-bold text-success">
                        @Model.NotDetected
                    </div>

                </div>

            </article>

        </div>


        <div class="col-6 col-md-4 col-xl-2">

            <article class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Reopened
                    </div>

                    <div class="fs-2 fw-bold text-warning">
                        @Model.Reopened
                    </div>

                </div>

            </article>

        </div>


        <div class="col-6 col-md-4 col-xl-2">

            <article class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Inconclusive
                    </div>

                    <div class="fs-2 fw-bold">
                        @Model.Inconclusive
                    </div>

                </div>

            </article>

        </div>


        <div class="col-6 col-md-4 col-xl-2">

            <article class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Failed
                    </div>

                    <div class="fs-2 fw-bold">
                        @Model.Failed
                    </div>

                </div>

            </article>

        </div>

    </div>


    <form asp-controller="AccessibilityWorkflowRetests"
          asp-action="VerifySelected"
          method="post"
          id="workflowVerificationForm">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="originalAuditRunId"
               value="@Model.OriginalAuditRunId" />

        <input type="hidden"
               name="retestAuditRunId"
               value="@Model.RetestAuditRunId" />


        <div class="card shadow-sm">

            <div class="card-header bg-transparent">

                <div class="d-flex flex-wrap
                            justify-content-between
                            align-items-center
                            gap-2">

                    <div>

                        <h2 class="h4 mb-1">
                            Saved Retest Results
                        </h2>

                        <p class="small text-muted mb-0">
                            Historical result saved when this formal
                            workflow retest was applied.
                        </p>

                    </div>


                    @if (verificationCandidateCount > 0)
                    {
                        <span class="badge text-bg-success">

                            @verificationCandidateCount awaiting
                            verification

                        </span>
                    }

                </div>

            </div>


            <div class="table-responsive">

                <table class="table table-hover
                              align-middle mb-0">

                    <caption class="visually-hidden">
                        Saved formal workflow accessibility retest results
                    </caption>


                    <thead>

                        <tr>

                            <th scope="col"
                                style="width: 48px;">

                                @if (verificationCandidateCount > 0)
                                {
                                    <input type="checkbox"
                                           id="selectAllEligible"
                                           class="form-check-input"
                                           aria-label="Select all issues eligible for verification" />
                                }
                                else
                                {
                                    <span class="visually-hidden">
                                        Select
                                    </span>
                                }

                            </th>

                            <th scope="col">
                                Finding
                            </th>

                            <th scope="col">
                                Original State
                            </th>

                            <th scope="col">
                                Retest State
                            </th>

                            <th scope="col">
                                Saved Result
                            </th>

                            <th scope="col">
                                Match Evidence
                            </th>

                            <th scope="col">
                                Current Status
                            </th>

                            <th scope="col">
                                Details
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item
                            in Model.Items)
                        {
                            string resultBadgeClass =
                                item.Result switch
                                {
                                    AccessibilityRemediationRetestResult
                                        .Detected =>
                                            "text-bg-danger",

                                    AccessibilityRemediationRetestResult
                                        .NotDetected =>
                                            "text-bg-success",

                                    AccessibilityRemediationRetestResult
                                        .Inconclusive =>
                                            "text-bg-warning",

                                    AccessibilityRemediationRetestResult
                                        .Failed =>
                                            "text-bg-secondary",

                                    _ =>
                                        "text-bg-secondary"
                                };

                            string resultLabel =
                                item.Result switch
                                {
                                    AccessibilityRemediationRetestResult
                                        .Detected =>
                                            "Still Detected",

                                    AccessibilityRemediationRetestResult
                                        .NotDetected =>
                                            "Not Detected",

                                    AccessibilityRemediationRetestResult
                                        .Inconclusive =>
                                            "Inconclusive",

                                    AccessibilityRemediationRetestResult
                                        .Failed =>
                                            "Scan Failed",

                                    _ =>
                                        item.Result.ToString()
                                };

                            string statusLabel =
                                item.CurrentStatus switch
                                {
                                    AccessibilityRemediationStatus.Open =>
                                        "Open",

                                    AccessibilityRemediationStatus.InProgress =>
                                        "In Progress",

                                    AccessibilityRemediationStatus.Fixed =>
                                        "Fixed – Awaiting Verification",

                                    AccessibilityRemediationStatus.Verified =>
                                        "Verified",

                                    AccessibilityRemediationStatus.WontFix =>
                                        "Won't Fix",

                                    _ =>
                                        item.CurrentStatus.ToString()
                                };

                            string statusBadgeClass =
                                item.CurrentStatus switch
                                {
                                    AccessibilityRemediationStatus.Open =>
                                        "text-bg-secondary",

                                    AccessibilityRemediationStatus.InProgress =>
                                        "text-bg-primary",

                                    AccessibilityRemediationStatus.Fixed =>
                                        "text-bg-warning",

                                    AccessibilityRemediationStatus.Verified =>
                                        "text-bg-success",

                                    AccessibilityRemediationStatus.WontFix =>
                                        "text-bg-dark",

                                    _ =>
                                        "text-bg-secondary"
                                };

                            <tr>

                                <td>

                                    @if (item.CanVerify)
                                    {
                                        <input type="checkbox"
                                               name="remediationItemIds"
                                               value="@item.RemediationItemId"
                                               class="form-check-input verification-item-checkbox"
                                               aria-label="Select remediation item @item.RemediationItemId for verification" />
                                    }

                                </td>


                                <td style="min-width: 190px;">

                                    <div class="fw-semibold">
                                        @item.RuleId
                                    </div>

                                    <div class="small text-muted">
                                        @item.FindingType
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(
                                        item.Impact))
                                    {
                                        <div class="small text-muted">
                                            Severity: @item.Impact
                                        </div>
                                    }


                                    <div class="small mt-2">

                                        <span class="text-muted">
                                            Remediation:
                                        </span>

                                        #@item.RemediationItemId

                                    </div>


                                    @if (item
                                        .OriginalAuthenticatedAuditFindingId
                                        .HasValue)
                                    {
                                        <div class="small">

                                            <span class="text-muted">
                                                Original finding:
                                            </span>

                                            #@item.OriginalAuthenticatedAuditFindingId.Value

                                        </div>
                                    }


                                    <div class="small">

                                        <span class="text-muted">
                                            Matched retest finding:
                                        </span>

                                        @if (item
                                            .MatchedAuthenticatedAuditFindingId
                                            .HasValue)
                                        {
                                            <span>
                                                #@item.MatchedAuthenticatedAuditFindingId.Value
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                None
                                            </span>
                                        }

                                    </div>

                                </td>


                                <td style="min-width: 180px;">

                                    <div class="fw-semibold">
                                        Step @item.OriginalStepNumber
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(
                                        item.OriginalStepName))
                                    {
                                        <div class="small text-muted">
                                            @item.OriginalStepName
                                        </div>
                                    }

                                    <div class="small
                                                text-muted
                                                text-break
                                                mt-1">
                                        @item.OriginalUrl
                                    </div>

                                </td>


                                <td style="min-width: 180px;">

                                    @if (item.RetestStepNumber.HasValue)
                                    {
                                        <div class="fw-semibold">
                                            Step @item.RetestStepNumber.Value
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(
                                            item.RetestStepName))
                                        {
                                            <div class="small text-muted">
                                                @item.RetestStepName
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(
                                            item.RetestUrl))
                                        {
                                            <div class="small
                                                        text-muted
                                                        text-break
                                                        mt-1">
                                                @item.RetestUrl
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No matched workflow state
                                        </span>
                                    }

                                </td>


                                <td>

                                    <span class="badge @resultBadgeClass">
                                        @resultLabel
                                    </span>

                                    @if (item.WasReopened)
                                    {
                                        <div class="mt-1">

                                            <span class="badge text-bg-warning">
                                                Reopened
                                            </span>

                                        </div>
                                    }

                                    @if (item.VerifiedFromThisRetest)
                                    {
                                        <div class="mt-1">

                                            <span class="badge text-bg-success">
                                                Verified from this retest
                                            </span>

                                        </div>
                                    }
                                    else if (item.CanVerify)
                                    {
                                        <div class="mt-1">

                                            <span class="badge
                                                         border
                                                         text-bg-light">
                                                Eligible to verify
                                            </span>

                                        </div>
                                    }

                                </td>


                                <td>

                                    @if (item.MatchConfidence.HasValue)
                                    {
                                        <div class="fw-semibold">
                                            @item.MatchConfidence.Value.ToString("P0")
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted">
                                            —
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(
                                        item.MatchMethod))
                                    {
                                        <div class="small text-muted">
                                            @item.MatchMethod
                                        </div>
                                    }

                                </td>


                                <td style="min-width: 150px;">

                                    <span class="badge @statusBadgeClass">
                                        @statusLabel
                                    </span>

                                </td>


                                <td class="text-end">

                                    <a asp-controller="AccessibilityRemediations"
                                       asp-action="Details"
                                       asp-route-id="@item.RemediationItemId"
                                       class="btn btn-sm
                                              btn-outline-primary">

                                        View Remediation

                                    </a>

                                </td>

                            </tr>


                            @if (!string.IsNullOrWhiteSpace(
                                item.Notes))
                            {
                                <tr>

                                    <td colspan="8"
                                        class="bg-light">

                                        <div class="small">

                                            <strong>
                                                Retest notes:
                                            </strong>

                                            @item.Notes

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>


            @if (verificationCandidateCount > 0)
            {
                <div class="card-footer bg-transparent">

                    <div class="row g-3
                                align-items-end">

                        <div class="col-12 col-lg">

                            <label for="verificationNotes"
                                   class="form-label fw-semibold">

                                Verification Notes

                            </label>

                            <textarea id="verificationNotes"
                                      name="notes"
                                      rows="3"
                                      maxlength="4000"
                                      class="form-control"
                                      placeholder="Optional notes about the verification review..."></textarea>

                        </div>


                        <div class="col-12 col-lg-auto">

                            <div class="small mb-2">

                                Selected:

                                <strong id="selectedVerificationCount">
                                    0
                                </strong>

                                of @verificationCandidateCount eligible

                            </div>

                            <button type="submit"
                                    id="verifySelectedButton"
                                    class="btn btn-success"
                                    disabled>

                                Verify Selected Issues

                            </button>

                        </div>

                    </div>


                    <div class="small text-muted mt-3">

                        Only Fixed – Awaiting Verification items whose
                        latest retest evidence is Not Detected can be
                        verified. Verification is explicit and is never
                        performed automatically by the retest.

                    </div>

                </div>
            }
            else
            {
                <div class="card-footer bg-transparent">

                    <p class="small text-muted mb-0">

                        There are currently no issues from this formal
                        workflow retest awaiting verification.

                    </p>

                </div>
            }

        </div>

    </form>

</div>


@section Scripts
{
    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const form =
                    document.getElementById(
                        "workflowVerificationForm");

                const selectAll =
                    document.getElementById(
                        "selectAllEligible");

                const itemCheckboxes =
                    Array.from(
                        document.querySelectorAll(
                            ".verification-item-checkbox"));

                const selectedCount =
                    document.getElementById(
                        "selectedVerificationCount");

                const verifyButton =
                    document.getElementById(
                        "verifySelectedButton");


                function updateSelectionState() {

                    const checkedCount =
                        itemCheckboxes.filter(
                            checkbox =>
                                checkbox.checked
                        ).length;

                    if (selectedCount) {
                        selectedCount.textContent =
                            checkedCount.toString();
                    }

                    if (verifyButton) {
                        verifyButton.disabled =
                            checkedCount === 0;
                    }

                    if (selectAll) {

                        selectAll.checked =
                            itemCheckboxes.length > 0 &&
                            checkedCount ===
                                itemCheckboxes.length;

                        selectAll.indeterminate =
                            checkedCount > 0 &&
                            checkedCount <
                                itemCheckboxes.length;
                    }
                }


                if (selectAll) {

                    selectAll.addEventListener(
                        "change",
                        function () {

                            itemCheckboxes.forEach(
                                checkbox => {

                                    checkbox.checked =
                                        selectAll.checked;
                                });

                            updateSelectionState();
                        });
                }


                itemCheckboxes.forEach(
                    checkbox => {

                        checkbox.addEventListener(
                            "change",
                            updateSelectionState);
                    });


                if (form) {

                    form.addEventListener(
                        "submit",
                        function (event) {

                            const checkedCount =
                                itemCheckboxes.filter(
                                    checkbox =>
                                        checkbox.checked
                                ).length;

                            if (checkedCount === 0) {

                                event.preventDefault();

                                return;
                            }

                            const confirmed =
                                window.confirm(
                                    "Verify the selected accessibility issues? " +
                                    "Only issues supported by the latest " +
                                    "Not Detected retest evidence will be verified."
                                );

                            if (!confirmed) {
                                event.preventDefault();
                            }
                        });
                }


                updateSelectionState();
            });
    </script>
}
