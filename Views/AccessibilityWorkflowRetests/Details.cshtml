@using CityWebsiteAuditDashboard.Models
@model CityWebsiteAuditDashboard.ViewModels.AccessibilityWorkflowRetestDetailsViewModel

@{
    ViewData["Title"] =
        "Formal Workflow Retest Details";


    int verificationCandidateCount =
        Model.Items.Count(item =>
            item.CanVerify);


    double verificationPercent =
        Model.NotDetected > 0
            ? Model.VerifiedFromThisRetest *
              100.0 /
              Model.NotDetected
            : 0;


    string verificationPercentWidth =
        verificationPercent.ToString(
            "0.##",
            System.Globalization.CultureInfo.InvariantCulture);


    string workflowVerificationBadgeClass =
        Model.VerificationState switch
        {
            "Fully Verified" =>
                "text-bg-success",

            "Partially Verified" =>
                "text-bg-warning",

            _ =>
                "text-bg-secondary"
        };


    string comparisonSummary =
        Model.TotalTracked == 0
            ? "No tracked remediation items were included in this retest."
            : Model.StillDetected == 0 &&
              Model.Inconclusive == 0 &&
              Model.Failed == 0
                ? $"{Model.NotDetected} of {Model.TotalTracked} tracked findings were not detected."
                : $"{Model.StillDetected} still detected, " +
                  $"{Model.NotDetected} not detected, " +
                  $"{Model.Inconclusive} inconclusive, and " +
                  $"{Model.Failed} failed.";
}


<!-- =========================================================
     Messages
     ========================================================= -->

@if (TempData["WorkflowVerificationSuccess"]
    is string verificationSuccess)
{
    <div class="alert alert-success"
         role="status">
        @verificationSuccess
    </div>
}


@if (TempData["WorkflowVerificationError"]
    is string verificationError)
{
    <div class="alert alert-danger"
         role="alert">
        @verificationError
    </div>
}


<!-- =========================================================
     Page heading
     ========================================================= -->

<header class="mb-4">

    <div class="d-flex
                flex-wrap
                justify-content-between
                align-items-start
                gap-3">

        <div style="max-width: 800px;">

            <div class="small
                        fw-bold
                        text-uppercase
                        text-muted
                        mb-2"
                 style="letter-spacing: 0.06em;">
                Accessibility Retesting
            </div>


            <h1 class="h2 mb-2">
                Formal Workflow Retest
            </h1>


            <p class="text-muted mb-1">
                @Model.ApplicationName
            </p>


            <p class="small text-muted mb-0">

                Original Run #@Model.OriginalAuditRunId

                <span class="mx-1"
                      aria-hidden="true">
                    →
                </span>

                Retest Run #@Model.RetestAuditRunId

            </p>

        </div>


        <div class="d-flex
                    flex-wrap
                    gap-2">

            <a asp-controller="AccessibilityWorkflowRetests"
               asp-action="Index"
               asp-route-originalAuditRunId="@Model.OriginalAuditRunId"
               class="btn btn-outline-secondary">
                Back to Workflow Retests
            </a>


            <a asp-controller="AuthenticatedAudits"
               asp-action="Details"
               asp-route-id="@Model.OriginalAuditRunId"
               class="btn btn-outline-primary">
                Original Audit
            </a>


            <a asp-controller="AuthenticatedAudits"
               asp-action="Details"
               asp-route-id="@Model.RetestAuditRunId"
               class="btn btn-primary">
                Retest Audit
            </a>

        </div>

    </div>

</header>


<!-- =========================================================
     Retest outcome
     ========================================================= -->

<section aria-labelledby="retest-outcome-heading"
         class="card shadow-sm mb-4">

    <div class="card-header">

        <div class="d-flex
                    flex-wrap
                    justify-content-between
                    align-items-center
                    gap-2">

            <div>

                <h2 id="retest-outcome-heading"
                    class="h5 mb-1">
                    Retest Outcome
                </h2>

                <p class="small text-muted mb-0">
                    Current verification state for this saved
                    formal workflow retest.
                </p>

            </div>


            <span class="badge
                         @workflowVerificationBadgeClass
                         px-3
                         py-2">
                @Model.VerificationState
            </span>

        </div>

    </div>


    <div class="card-body">

        <div class="row g-4 align-items-center">

            <div class="col-12 col-lg">

                <div class="dashboard-card-label mb-1">
                    Result Summary
                </div>

                <div class="fs-5 fw-semibold">
                    @comparisonSummary
                </div>


                @if (Model.NotDetected > 0)
                {
                    <div class="small text-muted mt-2">

                        @Model.VerifiedFromThisRetest of
                        @Model.NotDetected Not Detected
                        finding@(Model.NotDetected == 1 ? "" : "s")
                        @(Model.VerifiedFromThisRetest == 1
                            ? "is"
                            : "are")
                        currently verified from this retest.

                    </div>
                }

            </div>


            @if (Model.NotDetected > 0)
            {
                <div class="col-12 col-lg-4">

                    <div class="d-flex
                                justify-content-between
                                align-items-center
                                gap-2
                                small
                                mb-2">

                        <span class="fw-semibold">
                            Verification Progress
                        </span>

                        <strong>
                            @verificationPercent.ToString("0.0")%
                        </strong>

                    </div>


                    <div class="progress"
                         role="progressbar"
                         aria-label="Formal workflow verification progress"
                         aria-valuenow="@verificationPercent"
                         aria-valuemin="0"
                         aria-valuemax="100"
                         style="height: 10px;">

                        <div class="progress-bar bg-success"
                             style="width: @verificationPercentWidth%;">
                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</section>


<!-- =========================================================
     Retest metadata
     ========================================================= -->

<section aria-labelledby="retest-information-heading"
         class="card shadow-sm mb-4">

    <div class="card-header">

        <h2 id="retest-information-heading"
            class="h5 mb-0">
            Retest Information
        </h2>

    </div>


    <div class="card-body">

        <div class="row g-3">

            <div class="col-12 col-md-6 col-xl-3">

                <div class="dashboard-card-label">
                    Application
                </div>

                <div class="fw-semibold">
                    @Model.ApplicationName
                </div>

            </div>


            <div class="col-12 col-md-6 col-xl-3">

                <div class="dashboard-card-label">
                    Original Audit
                </div>

                <div>

                    <a asp-controller="AuthenticatedAudits"
                       asp-action="Details"
                       asp-route-id="@Model.OriginalAuditRunId">
                        Run #@Model.OriginalAuditRunId
                    </a>

                </div>

            </div>


            <div class="col-12 col-md-6 col-xl-3">

                <div class="dashboard-card-label">
                    Retest Audit
                </div>

                <div>

                    <a asp-controller="AuthenticatedAudits"
                       asp-action="Details"
                       asp-route-id="@Model.RetestAuditRunId">
                        Run #@Model.RetestAuditRunId
                    </a>

                </div>

            </div>


            <div class="col-12 col-md-6 col-xl-3">

                <div class="dashboard-card-label">
                    Recorded
                </div>

                <div>
                    @Model.RetestedAt.ToString(
                        "MMM d, yyyy h:mm tt")
                    UTC
                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     Result metrics
     ========================================================= -->

<section aria-labelledby="retest-summary-heading"
         class="mb-4">

    <div class="mb-3">

        <h2 id="retest-summary-heading"
            class="h3 mb-1">
            Result Summary
        </h2>

        <p class="text-muted mb-0">
            Saved outcomes across all tracked remediation items
            included in this workflow retest.
        </p>

    </div>


    <div class="row
                row-cols-2
                row-cols-md-3
                row-cols-xl-6
                g-3">

        <!-- Tracked -->

        <div class="col">

            <article class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="dashboard-card-label">
                        Tracked
                    </div>

                    <div class="dashboard-card-value">
                        @Model.TotalTracked
                    </div>

                </div>

            </article>

        </div>


        <!-- Still Detected -->

        <div class="col">

            <article class="card
                            shadow-sm
                            h-100
                            border-start
                            border-danger
                            border-4">

                <div class="card-body">

                    <div class="dashboard-card-label">
                        Still Detected
                    </div>

                    <div class="dashboard-card-value
                                text-danger">
                        @Model.StillDetected
                    </div>

                </div>

            </article>

        </div>


        <!-- Not Detected -->

        <div class="col">

            <article class="card
                            shadow-sm
                            h-100
                            border-start
                            border-success
                            border-4">

                <div class="card-body">

                    <div class="dashboard-card-label">
                        Not Detected
                    </div>

                    <div class="dashboard-card-value
                                text-success">
                        @Model.NotDetected
                    </div>

                </div>

            </article>

        </div>


        <!-- Reopened -->

        <div class="col">

            <article class="card
                            shadow-sm
                            h-100
                            border-start
                            border-warning
                            border-4">

                <div class="card-body">

                    <div class="dashboard-card-label">
                        Reopened
                    </div>

                    <div class="dashboard-card-value">
                        @Model.Reopened
                    </div>

                </div>

            </article>

        </div>


        <!-- Inconclusive -->

        <div class="col">

            <article class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="dashboard-card-label">
                        Inconclusive
                    </div>

                    <div class="dashboard-card-value">
                        @Model.Inconclusive
                    </div>

                </div>

            </article>

        </div>


        <!-- Failed -->

        <div class="col">

            <article class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="dashboard-card-label">
                        Failed
                    </div>

                    <div class="dashboard-card-value">
                        @Model.Failed
                    </div>

                </div>

            </article>

        </div>

    </div>

</section>


<!-- =========================================================
     Saved results and verification
     ========================================================= -->

<form asp-controller="AccessibilityWorkflowRetests"
      asp-action="VerifySelected"
      method="post"
      id="workflowVerificationForm">

    @Html.AntiForgeryToken()


    <input type="hidden"
           name="originalAuditRunId"
           value="@Model.OriginalAuditRunId" />

    <input type="hidden"
           name="retestAuditRunId"
           value="@Model.RetestAuditRunId" />


    <section aria-labelledby="saved-retest-results-heading"
             class="card shadow-sm">

        <div class="card-header">

            <div class="d-flex
                        flex-wrap
                        justify-content-between
                        align-items-center
                        gap-3">

                <div>

                    <h2 id="saved-retest-results-heading"
                        class="h5 mb-1">
                        Saved Retest Results
                    </h2>

                    <p class="small text-muted mb-0">
                        Finding-level results recorded when this
                        formal workflow retest was applied.
                    </p>

                </div>


                <div class="d-flex
                            flex-wrap
                            gap-2">

                    <span class="badge
                                 text-bg-light
                                 border
                                 text-dark">
                        @Model.Items.Count results
                    </span>


                    @if (verificationCandidateCount > 0)
                    {
                        <span class="badge
                                     text-bg-success">
                            @verificationCandidateCount awaiting
                            verification
                        </span>
                    }

                </div>

            </div>

        </div>


        @if (Model.Items.Count == 0)
        {
            <div class="card-body text-center py-5">

                <h3 class="h6">
                    No Saved Retest Results
                </h3>

                <p class="text-muted mb-0">
                    No tracked findings were saved for this formal
                    workflow retest.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table
                              table-hover
                              align-middle
                              mb-0">

                    <caption class="visually-hidden">
                        Saved formal workflow accessibility retest
                        results
                    </caption>


                    <thead>

                        <tr>

                            <th scope="col"
                                style="width: 48px;">

                                @if (verificationCandidateCount > 0)
                                {
                                    <input type="checkbox"
                                           id="selectAllEligible"
                                           class="form-check-input"
                                           aria-label="Select all issues eligible for verification" />
                                }
                                else
                                {
                                    <span class="visually-hidden">
                                        Select
                                    </span>
                                }

                            </th>


                            <th scope="col">
                                Finding
                            </th>

                            <th scope="col">
                                Original State
                            </th>

                            <th scope="col">
                                Retest State
                            </th>

                            <th scope="col">
                                Result
                            </th>

                            <th scope="col">
                                Current Status
                            </th>

                            <th scope="col">
                                <span class="visually-hidden">
                                    Actions
                                </span>
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item
                            in Model.Items)
                        {
                            string resultBadgeClass =
                                item.Result switch
                                {
                                    AccessibilityRemediationRetestResult
                                        .Detected =>
                                            "text-bg-danger",

                                    AccessibilityRemediationRetestResult
                                        .NotDetected =>
                                            "text-bg-success",

                                    AccessibilityRemediationRetestResult
                                        .Inconclusive =>
                                            "text-bg-warning",

                                    AccessibilityRemediationRetestResult
                                        .Failed =>
                                            "text-bg-secondary",

                                    _ =>
                                        "text-bg-secondary"
                                };


                            string resultLabel =
                                item.Result switch
                                {
                                    AccessibilityRemediationRetestResult
                                        .Detected =>
                                            "Still Detected",

                                    AccessibilityRemediationRetestResult
                                        .NotDetected =>
                                            "Not Detected",

                                    AccessibilityRemediationRetestResult
                                        .Inconclusive =>
                                            "Inconclusive",

                                    AccessibilityRemediationRetestResult
                                        .Failed =>
                                            "Scan Failed",

                                    _ =>
                                        item.Result.ToString()
                                };


                            string statusLabel =
                                item.CurrentStatus switch
                                {
                                    AccessibilityRemediationStatus.Open =>
                                        "Open",

                                    AccessibilityRemediationStatus.InProgress =>
                                        "In Progress",

                                    AccessibilityRemediationStatus.Fixed =>
                                        "Awaiting Verification",

                                    AccessibilityRemediationStatus.Verified =>
                                        "Verified",

                                    AccessibilityRemediationStatus.WontFix =>
                                        "Won't Fix",

                                    _ =>
                                        item.CurrentStatus.ToString()
                                };


                            string statusBadgeClass =
                                item.CurrentStatus switch
                                {
                                    AccessibilityRemediationStatus.Open =>
                                        "text-bg-danger",

                                    AccessibilityRemediationStatus.InProgress =>
                                        "text-bg-primary",

                                    AccessibilityRemediationStatus.Fixed =>
                                        "text-bg-warning",

                                    AccessibilityRemediationStatus.Verified =>
                                        "text-bg-success",

                                    AccessibilityRemediationStatus.WontFix =>
                                        "text-bg-secondary",

                                    _ =>
                                        "text-bg-secondary"
                                };


                            string findingTypeLabel =
                                string.Equals(
                                    item.FindingType,
                                    "NeedsReview",
                                    StringComparison.OrdinalIgnoreCase)
                                    ? "Needs Manual Review"
                                    : item.FindingType;


                            <tr>

                                <!-- Selection -->

                                <td>

                                    @if (item.CanVerify)
                                    {
                                        <input type="checkbox"
                                               name="remediationItemIds"
                                               value="@item.RemediationItemId"
                                               class="form-check-input
                                                      verification-item-checkbox"
                                               aria-label="Select remediation item @item.RemediationItemId for verification" />
                                    }

                                </td>


                                <!-- Finding -->

                                <td style="min-width: 220px;">

                                    <div class="fw-semibold">
                                        @item.RuleId
                                    </div>


                                    <div class="small text-muted">
                                        @findingTypeLabel
                                    </div>


                                    @if (!string.IsNullOrWhiteSpace(
                                        item.Impact))
                                    {
                                        <div class="small mt-1">

                                            <span class="text-muted">
                                                Severity:
                                            </span>

                                            @item.Impact

                                        </div>
                                    }


                                    <div class="small mt-1">

                                        <span class="text-muted">
                                            Remediation:
                                        </span>

                                        #@item.RemediationItemId

                                    </div>


                                    <details class="small mt-2">

                                        <summary>
                                            Technical Match Details
                                        </summary>


                                        <dl class="mt-2 mb-0">

                                            @if (item
                                                .OriginalAuthenticatedAuditFindingId
                                                .HasValue)
                                            {
                                                <dt>
                                                    Original Finding ID
                                                </dt>

                                                <dd>
                                                    #@item.OriginalAuthenticatedAuditFindingId.Value
                                                </dd>
                                            }


                                            <dt>
                                                Matched Retest Finding
                                            </dt>

                                            <dd>

                                                @if (item
                                                    .MatchedAuthenticatedAuditFindingId
                                                    .HasValue)
                                                {
                                                    <span>
                                                        #@item.MatchedAuthenticatedAuditFindingId.Value
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        None
                                                    </span>
                                                }

                                            </dd>


                                            @if (item
                                                .RetestStepId
                                                .HasValue)
                                            {
                                                <dt>
                                                    Retest Step ID
                                                </dt>

                                                <dd>
                                                    @item.RetestStepId.Value
                                                </dd>
                                            }


                                            <dt>
                                                Match Method
                                            </dt>

                                            <dd>
                                                @(string.IsNullOrWhiteSpace(
                                                    item.MatchMethod)
                                                    ? "Not available"
                                                    : item.MatchMethod)
                                            </dd>


                                            <dt>
                                                Match Confidence
                                            </dt>

                                            <dd class="mb-0">

                                                @if (item.MatchConfidence
                                                    .HasValue)
                                                {
                                                    @item.MatchConfidence.Value.ToString("P0")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        Not available
                                                    </span>
                                                }

                                            </dd>

                                        </dl>

                                    </details>

                                </td>


                                <!-- Original State -->

                                <td style="min-width: 190px;">

                                    <div class="fw-semibold">
                                        Step @item.OriginalStepNumber
                                    </div>


                                    @if (!string.IsNullOrWhiteSpace(
                                        item.OriginalStepName))
                                    {
                                        <div class="small text-muted">
                                            @item.OriginalStepName
                                        </div>
                                    }


                                    <details class="small mt-2">

                                        <summary>
                                            View URL
                                        </summary>

                                        <div class="text-muted
                                                    text-break
                                                    mt-1">
                                            @item.OriginalUrl
                                        </div>

                                    </details>

                                </td>


                                <!-- Retest State -->

                                <td style="min-width: 190px;">

                                    @if (item.RetestStepNumber.HasValue)
                                    {
                                        <div class="fw-semibold">
                                            Step @item.RetestStepNumber.Value
                                        </div>


                                        @if (!string.IsNullOrWhiteSpace(
                                            item.RetestStepName))
                                        {
                                            <div class="small text-muted">
                                                @item.RetestStepName
                                            </div>
                                        }


                                        @if (!string.IsNullOrWhiteSpace(
                                            item.RetestUrl))
                                        {
                                            <details class="small mt-2">

                                                <summary>
                                                    View URL
                                                </summary>

                                                <div class="text-muted
                                                            text-break
                                                            mt-1">
                                                    @item.RetestUrl
                                                </div>

                                            </details>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No matched workflow state
                                        </span>
                                    }

                                </td>


                                <!-- Result -->

                                <td style="min-width: 155px;">

                                    <span class="badge
                                                 @resultBadgeClass">
                                        @resultLabel
                                    </span>


                                    @if (item.WasReopened)
                                    {
                                        <div class="mt-2">

                                            <span class="badge
                                                         text-bg-warning">
                                                Reopened
                                            </span>

                                        </div>
                                    }


                                    @if (item.VerifiedFromThisRetest)
                                    {
                                        <div class="mt-2">

                                            <span class="badge
                                                         text-bg-success">
                                                Verified
                                            </span>

                                        </div>
                                    }
                                    else if (item.CanVerify)
                                    {
                                        <div class="mt-2">

                                            <span class="badge
                                                         text-bg-light
                                                         border
                                                         text-dark">
                                                Eligible to Verify
                                            </span>

                                        </div>
                                    }


                                    @if (!string.IsNullOrWhiteSpace(
                                        item.Notes))
                                    {
                                        <details class="small mt-2">

                                            <summary>
                                                Retest Notes
                                            </summary>

                                            <div class="border
                                                        rounded
                                                        bg-light
                                                        p-2
                                                        mt-2"
                                                 style="white-space: pre-line;">
                                                @item.Notes
                                            </div>

                                        </details>
                                    }

                                </td>


                                <!-- Current Status -->

                                <td style="min-width: 150px;">

                                    <span class="badge
                                                 @statusBadgeClass">
                                        @statusLabel
                                    </span>

                                </td>


                                <!-- Action -->

                                <td class="text-end">

                                    <a asp-controller="AccessibilityRemediations"
                                       asp-action="Details"
                                       asp-route-id="@item.RemediationItemId"
                                       class="btn
                                              btn-sm
                                              btn-outline-primary">
                                        View Remediation
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }


        <!-- =================================================
             Verification action
             ================================================= -->

        @if (verificationCandidateCount > 0)
        {
            <div class="card-footer">

                <div class="row
                            g-3
                            align-items-end">

                    <div class="col-12 col-lg">

                        <label for="verificationNotes"
                               class="form-label fw-semibold">
                            Verification Notes
                        </label>

                        <textarea id="verificationNotes"
                                  name="notes"
                                  rows="3"
                                  maxlength="4000"
                                  class="form-control"
                                  placeholder="Optional notes about the verification review..."></textarea>

                    </div>


                    <div class="col-12 col-lg-auto">

                        <div class="small mb-2">

                            Selected:

                            <strong id="selectedVerificationCount">
                                0
                            </strong>

                            of @verificationCandidateCount eligible

                        </div>


                        <button type="submit"
                                id="verifySelectedButton"
                                class="btn btn-success"
                                disabled>
                            Verify Selected Issues
                        </button>

                    </div>

                </div>


                <div class="small
                            text-muted
                            mt-3">
                    Only eligible items selected above will be
                    verified.
                </div>

            </div>
        }
        else
        {
            <div class="card-footer">

                <p class="small text-muted mb-0">
                    There are currently no findings from this formal
                    workflow retest awaiting verification.
                </p>

            </div>
        }

    </section>

</form>


@section Scripts
{
    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const form =
                    document.getElementById(
                        "workflowVerificationForm");

                const selectAll =
                    document.getElementById(
                        "selectAllEligible");

                const itemCheckboxes =
                    Array.from(
                        document.querySelectorAll(
                            ".verification-item-checkbox"));

                const selectedCount =
                    document.getElementById(
                        "selectedVerificationCount");

                const verifyButton =
                    document.getElementById(
                        "verifySelectedButton");


                function updateSelectionState() {

                    const checkedCount =
                        itemCheckboxes.filter(
                            checkbox =>
                                checkbox.checked
                        ).length;


                    if (selectedCount) {

                        selectedCount.textContent =
                            checkedCount.toString();
                    }


                    if (verifyButton) {

                        verifyButton.disabled =
                            checkedCount === 0;
                    }


                    if (selectAll) {

                        selectAll.checked =
                            itemCheckboxes.length > 0 &&
                            checkedCount ===
                                itemCheckboxes.length;

                        selectAll.indeterminate =
                            checkedCount > 0 &&
                            checkedCount <
                                itemCheckboxes.length;
                    }
                }


                if (selectAll) {

                    selectAll.addEventListener(
                        "change",
                        function () {

                            itemCheckboxes.forEach(
                                checkbox => {

                                    checkbox.checked =
                                        selectAll.checked;
                                });

                            updateSelectionState();
                        });
                }


                itemCheckboxes.forEach(
                    checkbox => {

                        checkbox.addEventListener(
                            "change",
                            updateSelectionState);
                    });


                if (form) {

                    form.addEventListener(
                        "submit",
                        function (event) {

                            const checkedCount =
                                itemCheckboxes.filter(
                                    checkbox =>
                                        checkbox.checked
                                ).length;


                            if (checkedCount === 0) {

                                event.preventDefault();

                                return;
                            }


                            const confirmed =
                                window.confirm(
                                    "Verify the selected accessibility issues?"
                                );


                            if (!confirmed) {

                                event.preventDefault();
                            }
                        });
                }


                updateSelectionState();
            });
    </script>
}
