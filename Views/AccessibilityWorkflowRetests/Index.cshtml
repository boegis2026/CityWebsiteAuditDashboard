@using CityWebsiteAuditDashboard.Models
@model CityWebsiteAuditDashboard.ViewModels.AccessibilityWorkflowRetestViewModel

@{
    ViewData["Title"] = "Workflow Retests";
}


<!-- =========================================================
     Page heading
     ========================================================= -->

<header class="mb-4">

    <div class="d-flex
                flex-wrap
                justify-content-between
                align-items-start
                gap-3">

        <div style="max-width: 780px;">

            <div class="small
                        fw-bold
                        text-uppercase
                        text-muted
                        mb-2"
                 style="letter-spacing: 0.06em;">
                Accessibility Management
            </div>

            <h1 class="h2 mb-2">
                Workflow Retests
            </h1>

            <p class="text-muted mb-0">
                Compare accessibility findings from an earlier
                authenticated audit against a later audit of the same
                application. Workflow state counts do not have to match.
            </p>

        </div>


        <div class="d-flex
                    flex-wrap
                    gap-2">

            <a asp-controller="AccessibilityRemediations"
               asp-action="Index"
               class="btn btn-primary">
                Remediation Tracker
            </a>

            <a asp-controller="AuthenticatedAudits"
               asp-action="History"
               class="btn btn-outline-primary">
                Audit History
            </a>

            <a asp-controller="AccessibilityOverview"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Accessibility Overview
            </a>

        </div>

    </div>

</header>


<!-- =========================================================
     Status messages
     ========================================================= -->

@if (TempData["WorkflowRetestSuccess"]
    is string workflowRetestSuccess)
{
    <div class="alert alert-success"
         role="status">
        @workflowRetestSuccess
    </div>
}


@if (TempData["WorkflowRetestError"]
    is string workflowRetestError)
{
    <div class="alert alert-danger"
         role="alert">
        @workflowRetestError
    </div>
}


@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>
}


<!-- =========================================================
     Audit selection
     ========================================================= -->

<section aria-labelledby="audit-selection-heading"
         class="card shadow-sm mb-4">

    <div class="card-header">

        <h2 id="audit-selection-heading"
            class="h5 mb-1">
            Select Workflow Audits
        </h2>

        <p class="small text-muted mb-0">
            Choose a baseline audit, then compare it with a newer
            completed audit of the same application.
        </p>

    </div>


    <div class="card-body">

        <form method="get"
              asp-controller="AccessibilityWorkflowRetests"
              asp-action="Index">

            <div class="row g-4">

                <!-- Original audit -->

                <div class="col-12 col-lg-6">

                    <div class="border
                                rounded
                                p-3
                                h-100">

                        <div class="dashboard-card-label">
                            Step 1
                        </div>

                        <label for="originalAuditRunId"
                               class="form-label fw-semibold">
                            Original Audit
                        </label>

                        <select id="originalAuditRunId"
                                name="originalAuditRunId"
                                class="form-select"
                                required>

                            <option value="">
                                Select original audit...
                            </option>


                            @foreach (var run
                                in Model.AuditRuns)
                            {
                                string originalRunLabel =
                                    $"{run.ApplicationName} — " +
                                    $"Run #{run.Id} — " +
                                    $"{run.StartedAt:MMM d, yyyy HH:mm} UTC — " +
                                    $"{run.StepCount} states";


                                if (Model.OriginalAuditRunId ==
                                    run.Id)
                                {
                                    <option value="@run.Id"
                                            selected>
                                        @originalRunLabel
                                    </option>
                                }
                                else
                                {
                                    <option value="@run.Id">
                                        @originalRunLabel
                                    </option>
                                }
                            }

                        </select>

                        <div class="form-text">
                            This audit becomes the baseline for the
                            comparison.
                        </div>

                    </div>

                </div>


                <!-- Retest audit -->

                <div class="col-12 col-lg-6">

                    <div class="border
                                rounded
                                p-3
                                h-100">

                        <div class="dashboard-card-label">
                            Step 2
                        </div>

                        <label for="retestAuditRunId"
                               class="form-label fw-semibold">
                            Later Audit
                        </label>

                        <select id="retestAuditRunId"
                                name="retestAuditRunId"
                                class="form-select">

                            @if (!Model.OriginalAuditRunId.HasValue)
                            {
                                <option value="">
                                    Select an original audit first...
                                </option>
                            }
                            else if (Model.EligibleRetestRuns.Count == 0)
                            {
                                <option value="">
                                    No compatible later audits found
                                </option>
                            }
                            else
                            {
                                <option value="">
                                    Select later audit...
                                </option>
                            }


                            @foreach (var run
                                in Model.EligibleRetestRuns)
                            {
                                string retestRunLabel =
                                    $"{run.ApplicationName} — " +
                                    $"Run #{run.Id} — " +
                                    $"{run.StartedAt:MMM d, yyyy HH:mm} UTC — " +
                                    $"{run.StepCount} states";


                                if (Model.RetestAuditRunId ==
                                    run.Id)
                                {
                                    <option value="@run.Id"
                                            selected>
                                        @retestRunLabel
                                    </option>
                                }
                                else
                                {
                                    <option value="@run.Id">
                                        @retestRunLabel
                                    </option>
                                }
                            }

                        </select>

                        <div class="form-text">
                            State counts may be different. Matching is
                            based on the saved page and workflow-state
                            evidence.
                        </div>

                    </div>

                </div>

            </div>


            <div class="d-flex
                        flex-wrap
                        gap-2
                        mt-4">

                <button type="submit"
                        class="btn btn-primary">

                    @if (Model.OriginalAuditRunId.HasValue &&
                         Model.RetestAuditRunId.HasValue)
                    {
                        <span>
                            Compare Workflow Audits
                        </span>
                    }
                    else
                    {
                        <span>
                            Load Compatible Audits
                        </span>
                    }

                </button>


                <a asp-controller="AccessibilityWorkflowRetests"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Clear Selection
                </a>

            </div>

        </form>

    </div>

</section>


@if (Model.OriginalAuditRunId.HasValue &&
     Model.EligibleRetestRuns.Count == 0 &&
     Model.RetestAuditRunId is null)
{
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="h5 mb-1">
                No Later Workflow Audit Available
            </h2>

            <p class="text-muted mb-0">
                Run another authenticated audit for this application
                before creating a comparison.
            </p>

        </div>

    </div>
}


<!-- =========================================================
     Previous formal retests
     ========================================================= -->

@if (Model.OriginalAuditRunId.HasValue &&
     Model.FormalWorkflowRetests.Count > 0)
{
    <section aria-labelledby="previous-formal-retests-heading"
             class="mb-4">

        <div class="d-flex
                    flex-wrap
                    justify-content-between
                    align-items-end
                    gap-2
                    mb-3">

            <div>

                <h2 id="previous-formal-retests-heading"
                    class="h3 mb-1">
                    Formal Retest History
                </h2>

                <p class="text-muted mb-0">
                    Saved remediation retests associated with Original
                    Run #@Model.OriginalAuditRunId.Value.
                </p>

            </div>


            <span class="badge
                         text-bg-light
                         border
                         px-3
                         py-2">

                @Model.FormalWorkflowRetests.Count
                recorded

            </span>

        </div>


        <div class="card shadow-sm">

            <div class="table-responsive">

                <table class="table
                              table-hover
                              align-middle
                              mb-0">

                    <caption class="visually-hidden">
                        Saved formal accessibility workflow retests
                    </caption>


                    <thead>

                        <tr>

                            <th scope="col">
                                Retest
                            </th>

                            <th scope="col">
                                Date
                            </th>

                            <th scope="col"
                                class="text-end">
                                Tracked
                            </th>

                            <th scope="col"
                                class="text-end">
                                Still Detected
                            </th>

                            <th scope="col"
                                class="text-end">
                                Not Detected
                            </th>

                            <th scope="col"
                                class="text-end">
                                Reopened
                            </th>

                            <th scope="col">
                                Verification
                            </th>

                            <th scope="col">
                                Other Results
                            </th>

                            <th scope="col">
                                <span class="visually-hidden">
                                    Actions
                                </span>
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var history
                            in Model.FormalWorkflowRetests)
                        {
                            string verificationBadgeClass =
                                history.VerificationState
                                switch
                                {
                                    "Fully Verified" =>
                                        "text-bg-success",

                                    "Partially Verified" =>
                                        "text-bg-warning",

                                    _ =>
                                        "text-bg-secondary"
                                };


                            <tr>

                                <td>

                                    <div class="fw-semibold">
                                        Run #@history.RetestAuditRunId
                                    </div>

                                    <div class="small text-muted">
                                        @history.ApplicationName
                                    </div>

                                </td>


                                <td class="text-nowrap">

                                    @history.RetestedAt.ToString(
                                        "MMM d, yyyy")

                                    <div class="small text-muted">

                                        @history.RetestedAt.ToString(
                                            "HH:mm")
                                        UTC

                                    </div>

                                </td>


                                <td class="text-end fw-semibold">
                                    @history.TotalTracked
                                </td>


                                <td class="text-end">

                                    @if (history.StillDetected > 0)
                                    {
                                        <span class="badge
                                                     text-bg-danger">
                                            @history.StillDetected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            0
                                        </span>
                                    }

                                </td>


                                <td class="text-end">

                                    @if (history.NotDetected > 0)
                                    {
                                        <span class="badge
                                                     text-bg-success">
                                            @history.NotDetected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            0
                                        </span>
                                    }

                                </td>


                                <td class="text-end">

                                    @if (history.Reopened > 0)
                                    {
                                        <span class="badge
                                                     text-bg-warning">
                                            @history.Reopened
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            0
                                        </span>
                                    }

                                </td>


                                <td>

                                    <span class="badge
                                                 @verificationBadgeClass">
                                        @history.VerificationState
                                    </span>


                                    @if (history.NotDetected > 0)
                                    {
                                        <div class="small
                                                    text-muted
                                                    mt-1">

                                            @history.VerifiedFromThisRetest
                                            /
                                            @history.NotDetected
                                            verified

                                        </div>
                                    }

                                </td>


                                <td>

                                    @if (history.Inconclusive == 0 &&
                                         history.Failed == 0)
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }
                                    else
                                    {
                                        @if (history.Inconclusive > 0)
                                        {
                                            <div class="small">

                                                <strong>
                                                    @history.Inconclusive
                                                </strong>

                                                inconclusive

                                            </div>
                                        }


                                        @if (history.Failed > 0)
                                        {
                                            <div class="small">

                                                <strong>
                                                    @history.Failed
                                                </strong>

                                                failed

                                            </div>
                                        }
                                    }

                                </td>


                                <td class="text-end">

                                    <a asp-controller="AccessibilityWorkflowRetests"
                                       asp-action="Details"
                                       asp-route-originalAuditRunId="@Model.OriginalAuditRunId.Value"
                                       asp-route-retestAuditRunId="@history.RetestAuditRunId"
                                       class="btn
                                              btn-sm
                                              btn-outline-primary">
                                        Review
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </section>
}


<!-- =========================================================
     Current comparison
     ========================================================= -->

@if (Model.Comparison is not null)
{
    var comparison =
        Model.Comparison;


    string comparisonHeadline;

    if (comparison.TotalCompared == 0)
    {
        comparisonHeadline =
            "The original audit does not contain saved accessibility " +
            "findings to compare.";
    }
    else if (comparison.StillDetected == 0 &&
             comparison.Inconclusive == 0 &&
             comparison.Failed == 0)
    {
        comparisonHeadline =
            $"{comparison.NotDetected} of " +
            $"{comparison.TotalCompared} findings were not detected " +
            "in their matched later workflow states.";
    }
    else
    {
        comparisonHeadline =
            $"{comparison.StillDetected} still detected, " +
            $"{comparison.NotDetected} not detected, " +
            $"{comparison.Inconclusive} inconclusive, and " +
            $"{comparison.Failed} failed.";
    }


    <section aria-labelledby="comparison-results-heading"
             class="mb-4">

        <div class="d-flex
                    flex-wrap
                    justify-content-between
                    align-items-end
                    gap-3
                    mb-3">

            <div>

                <div class="small
                            fw-bold
                            text-uppercase
                            text-muted
                            mb-2"
                     style="letter-spacing: 0.05em;">
                    Current Comparison
                </div>

                <h2 id="comparison-results-heading"
                    class="h3 mb-1">
                    @comparison.ApplicationName
                </h2>

                <div class="text-muted">

                    Original Run
                    #@comparison.OriginalAuditRunId

                    <span aria-hidden="true">
                        →
                    </span>

                    Later Run
                    #@comparison.RetestAuditRunId

                </div>

            </div>


            <div class="d-flex
                        flex-wrap
                        gap-2">

                <a asp-controller="AuthenticatedAudits"
                   asp-action="Details"
                   asp-route-id="@comparison.OriginalAuditRunId"
                   class="btn
                          btn-sm
                          btn-outline-secondary">
                    Original Audit
                </a>

                <a asp-controller="AuthenticatedAudits"
                   asp-action="Details"
                   asp-route-id="@comparison.RetestAuditRunId"
                   class="btn
                          btn-sm
                          btn-outline-primary">
                    Later Audit
                </a>

            </div>

        </div>


        <!-- =================================================
             Workflow-state coverage
             ================================================= -->

        <div class="card shadow-sm mb-3">

            <div class="card-header">

                <div class="d-flex
                            flex-wrap
                            justify-content-between
                            align-items-center
                            gap-2">

                    <h3 class="h5 mb-0">
                        Workflow State Coverage
                    </h3>


                    @if (comparison.StateCountDiffers)
                    {
                        <span class="badge
                                     text-bg-primary">
                            State Count Changed
                        </span>
                    }
                    else
                    {
                        <span class="badge
                                     text-bg-success">
                            Same State Count
                        </span>
                    }

                </div>

            </div>


            <div class="card-body">

                <div class="row
                            g-3
                            align-items-center">

                    <div class="col-12 col-md">

                        <div class="border
                                    rounded
                                    p-3">

                            <div class="dashboard-card-label">
                                Original Workflow
                            </div>

                            <div class="fs-4 fw-bold">
                                @comparison.OriginalStateCount
                                state@(comparison.OriginalStateCount == 1
                                    ? ""
                                    : "s")
                            </div>

                        </div>

                    </div>


                    <div class="col-auto
                                d-none
                                d-md-block
                                text-muted
                                fs-4"
                         aria-hidden="true">
                        →
                    </div>


                    <div class="col-12 col-md">

                        <div class="border
                                    rounded
                                    p-3">

                            <div class="dashboard-card-label">
                                Later Workflow
                            </div>

                            <div class="fs-4 fw-bold">
                                @comparison.RetestStateCount
                                state@(comparison.RetestStateCount == 1
                                    ? ""
                                    : "s")
                            </div>

                        </div>

                    </div>

                </div>


                @if (comparison.StateCountDiffers)
                {
                    <div class="small
                                text-muted
                                mt-3">

                        The workflows contain different numbers of
                        rendered states. Comparison still continues by
                        matching each original state to the strongest
                        corresponding state in the later audit.

                    </div>
                }

            </div>

        </div>


        <!-- =================================================
             Summary
             ================================================= -->

        <div class="card shadow-sm mb-3">

            <div class="card-body">

                <div class="dashboard-card-label">
                    Comparison Summary
                </div>

                <div class="fs-5 fw-semibold">
                    @comparisonHeadline
                </div>

            </div>

        </div>


        <!-- =================================================
             Metrics
             ================================================= -->

        <div class="row
                    row-cols-2
                    row-cols-md-3
                    row-cols-xl-6
                    g-3">

            <div class="col">

                <article class="card
                                shadow-sm
                                h-100">

                    <div class="card-body">

                        <div class="dashboard-card-label">
                            Compared
                        </div>

                        <div class="dashboard-card-value">
                            @comparison.TotalCompared
                        </div>

                        <div class="small text-muted">
                            Original findings
                        </div>

                    </div>

                </article>

            </div>


            <div class="col">

                <article class="card
                                shadow-sm
                                h-100
                                border-start
                                border-danger
                                border-4">

                    <div class="card-body">

                        <div class="dashboard-card-label">
                            Still Detected
                        </div>

                        <div class="dashboard-card-value
                                    text-danger">
                            @comparison.StillDetected
                        </div>

                        <div class="small text-muted">
                            Remains present
                        </div>

                    </div>

                </article>

            </div>


            <div class="col">

                <article class="card
                                shadow-sm
                                h-100
                                border-start
                                border-success
                                border-4">

                    <div class="card-body">

                        <div class="dashboard-card-label">
                            Not Detected
                        </div>

                        <div class="dashboard-card-value
                                    text-success">
                            @comparison.NotDetected
                        </div>

                        <div class="small text-muted">
                            Absent from matched state
                        </div>

                    </div>

                </article>

            </div>


            <div class="col">

                <article class="card
                                shadow-sm
                                h-100
                                border-start
                                border-warning
                                border-4">

                    <div class="card-body">

                        <div class="dashboard-card-label">
                            Inconclusive
                        </div>

                        <div class="dashboard-card-value">
                            @comparison.Inconclusive
                        </div>

                        <div class="small text-muted">
                            Match uncertain
                        </div>

                    </div>

                </article>

            </div>


            <div class="col">

                <article class="card
                                shadow-sm
                                h-100">

                    <div class="card-body">

                        <div class="dashboard-card-label">
                            Failed
                        </div>

                        <div class="dashboard-card-value">
                            @comparison.Failed
                        </div>

                        <div class="small text-muted">
                            Scan unavailable
                        </div>

                    </div>

                </article>

            </div>


            <div class="col">

                <article class="card
                                shadow-sm
                                h-100">

                    <div class="card-body">

                        <div class="dashboard-card-label">
                            Remediation
                        </div>

                        <div class="dashboard-card-value">
                            @comparison.TotalTracked
                        </div>

                        <div class="small text-muted">
                            tracked ·
                            @comparison.UntrackedFindingCount untracked
                        </div>

                    </div>

                </article>

            </div>

        </div>

    </section>


    <!-- =====================================================
         Preview status
         ===================================================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body py-3">

            <div class="d-flex
                        flex-wrap
                        justify-content-between
                        align-items-center
                        gap-3">

                <div>

                    <div class="fw-semibold">
                        Audit Comparison
                    </div>

                    <div class="small text-muted">
                        All saved accessibility findings from the
                        original audit are included whether or not they
                        are currently in the Remediation Tracker.
                    </div>

                </div>


                @if (comparison.FormalRetestAlreadyApplied)
                {
                    <span class="badge
                                 text-bg-success
                                 px-3
                                 py-2">
                        Formal Retest Recorded
                    </span>
                }
                else
                {
                    <span class="badge
                                 text-bg-light
                                 border
                                 text-dark
                                 px-3
                                 py-2">
                        Comparison Preview
                    </span>
                }

            </div>

        </div>

    </div>


    <!-- =====================================================
         Formal remediation retest
         ===================================================== -->

    @if (comparison.TotalTracked == 0)
    {
        <div class="card
                    border-primary
                    shadow-sm
                    mb-4">

            <div class="card-body">

                <div class="d-flex
                            flex-wrap
                            justify-content-between
                            align-items-start
                            gap-3">

                    <div>

                        <h3 class="h5 mb-1">
                            Audit Comparison Complete
                        </h3>

                        <p class="text-muted mb-0">
                            The audits can be reviewed below, but none
                            of the original findings are currently
                            connected to remediation work. A formal
                            remediation retest is only recorded for
                            tracked items.
                        </p>

                    </div>


                    <a asp-controller="AuthenticatedAudits"
                       asp-action="Details"
                       asp-route-id="@comparison.OriginalAuditRunId"
                       class="btn btn-outline-primary">
                        Review Original Audit
                    </a>

                </div>

            </div>

        </div>
    }
    else if (!comparison.FormalRetestAlreadyApplied)
    {
        <section aria-labelledby="apply-formal-retest-heading"
                 class="card
                        border-warning
                        shadow-sm
                        mb-4">

            <div class="card-header">

                <h3 id="apply-formal-retest-heading"
                    class="h5 mb-1">
                    Record Formal Workflow Retest
                </h3>

                <p class="small text-muted mb-0">
                    Save retest evidence for the
                    @comparison.TotalTracked tracked remediation
                    item@(comparison.TotalTracked == 1 ? "" : "s")
                    included in this comparison.
                </p>

            </div>


            <div class="card-body">

                @if (comparison.UntrackedFindingCount > 0)
                {
                    <div class="alert
                                alert-info
                                mb-4">

                        <strong>
                            @comparison.UntrackedFindingCount
                            comparison
                            finding@(comparison.UntrackedFindingCount == 1
                                ? " is"
                                : "s are")
                            not tracked.
                        </strong>

                        <div class="mt-1">
                            Those findings remain visible in the
                            read-only comparison but will not be written
                            as formal remediation retest records.
                        </div>

                    </div>
                }


                <div class="alert
                            alert-warning
                            mb-4">

                    <strong>
                        This action updates remediation records.
                    </strong>

                    <div class="mt-2">
                        A formal retest will be saved for the tracked
                        remediation items. Findings detected again may
                        return to
                        <strong>In Progress</strong>.
                    </div>

                </div>


                <form asp-controller="AccessibilityWorkflowRetests"
                      asp-action="Apply"
                      method="post"
                      id="applyWorkflowRetestForm">

                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           name="originalAuditRunId"
                           value="@comparison.OriginalAuditRunId" />

                    <input type="hidden"
                           name="retestAuditRunId"
                           value="@comparison.RetestAuditRunId" />


                    <div class="mb-3">

                        <label for="workflowRetestNotes"
                               class="form-label fw-semibold">
                            Retest Notes
                        </label>

                        <textarea id="workflowRetestNotes"
                                  name="notes"
                                  rows="3"
                                  maxlength="4000"
                                  class="form-control"
                                  placeholder="Optional notes about this workflow retest..."></textarea>

                    </div>


                    <button type="submit"
                            class="btn btn-warning">
                        Record Formal Retest
                    </button>

                </form>

            </div>

        </section>
    }
    else
    {
        <div class="card
                    border-success
                    shadow-sm
                    mb-4">

            <div class="card-body">

                <div class="d-flex
                            flex-wrap
                            align-items-center
                            gap-2
                            mb-2">

                    <span class="badge text-bg-success">
                        Recorded
                    </span>

                    <h3 class="h5 mb-0">
                        Formal Retest Already Saved
                    </h3>

                </div>

                <p class="text-muted mb-0">
                    Retest Run #@comparison.RetestAuditRunId has
                    already been recorded as formal evidence for the
                    tracked remediation items in this comparison.
                </p>

            </div>

        </div>
    }


    <!-- =====================================================
         Finding comparison
         ===================================================== -->

    <section aria-labelledby="finding-comparison-heading"
             class="mb-4">

        <div class="d-flex
                    flex-wrap
                    justify-content-between
                    align-items-end
                    gap-2
                    mb-3">

            <div>

                <h2 id="finding-comparison-heading"
                    class="h3 mb-1">
                    Finding Comparison
                </h2>

                <p class="text-muted mb-0">
                    Each original finding compared against its strongest
                    matching state in the later workflow audit.
                </p>

            </div>


            @if (comparison.Items.Count > 0)
            {
                <span class="badge
                             text-bg-light
                             border
                             text-dark
                             px-3
                             py-2">

                    @comparison.Items.Count
                    finding@(comparison.Items.Count == 1
                        ? ""
                        : "s")

                </span>
            }

        </div>


        <div class="card shadow-sm">

            @if (comparison.Items.Count == 0)
            {
                <div class="card-body">

                    <h3 class="h6 mb-1">
                        No Accessibility Findings to Compare
                    </h3>

                    <p class="text-muted mb-0">
                        The selected original audit does not contain
                        saved violation or manual-review findings.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table
                                  table-hover
                                  align-middle
                                  mb-0">

                        <caption class="visually-hidden">
                            Accessibility finding comparison between
                            the original and later workflow audits
                        </caption>


                        <thead>

                            <tr>

                                <th scope="col">
                                    Finding
                                </th>

                                <th scope="col">
                                    Original State
                                </th>

                                <th scope="col">
                                    Matched Later State
                                </th>

                                <th scope="col">
                                    Result
                                </th>

                                <th scope="col">
                                    Match
                                </th>

                                <th scope="col">
                                    Remediation
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item
                                in comparison.Items)
                            {
                                string resultBadgeClass =
                                    item.Result switch
                                    {
                                        AccessibilityRemediationRetestResult
                                            .Detected =>
                                                "text-bg-danger",

                                        AccessibilityRemediationRetestResult
                                            .NotDetected =>
                                                "text-bg-success",

                                        AccessibilityRemediationRetestResult
                                            .Inconclusive =>
                                                "text-bg-warning",

                                        AccessibilityRemediationRetestResult
                                            .Failed =>
                                                "text-bg-secondary",

                                        _ =>
                                                "text-bg-secondary"
                                    };


                                string resultLabel =
                                    item.Result switch
                                    {
                                        AccessibilityRemediationRetestResult
                                            .Detected =>
                                                "Still Detected",

                                        AccessibilityRemediationRetestResult
                                            .NotDetected =>
                                                "Not Detected",

                                        AccessibilityRemediationRetestResult
                                            .Inconclusive =>
                                                "Inconclusive",

                                        AccessibilityRemediationRetestResult
                                            .Failed =>
                                                "Scan Failed",

                                        _ =>
                                                item.Result.ToString()
                                    };


                                string remediationStatusLabel =
                                    item.CurrentStatus switch
                                    {
                                        AccessibilityRemediationStatus
                                            .Open =>
                                                "Open",

                                        AccessibilityRemediationStatus
                                            .InProgress =>
                                                "In Progress",

                                        AccessibilityRemediationStatus
                                            .Fixed =>
                                                "Awaiting Verification",

                                        AccessibilityRemediationStatus
                                            .Verified =>
                                                "Verified",

                                        AccessibilityRemediationStatus
                                            .WontFix =>
                                                "Won't Fix",

                                        null =>
                                                "Not Tracked",

                                        _ =>
                                                "Tracked"
                                    };


                                string remediationBadgeClass =
                                    item.CurrentStatus switch
                                    {
                                        AccessibilityRemediationStatus
                                            .Open =>
                                                "text-bg-danger",

                                        AccessibilityRemediationStatus
                                            .InProgress =>
                                                "text-bg-primary",

                                        AccessibilityRemediationStatus
                                            .Fixed =>
                                                "text-bg-warning",

                                        AccessibilityRemediationStatus
                                            .Verified =>
                                                "text-bg-success",

                                        AccessibilityRemediationStatus
                                            .WontFix =>
                                                "text-bg-secondary",

                                        null =>
                                                "text-bg-light border text-dark",

                                        _ =>
                                                "text-bg-secondary"
                                    };


                                <tr>

                                    <!-- Finding -->

                                    <td style="min-width: 220px;">

                                        <div class="fw-semibold">
                                            @item.RuleId
                                        </div>


                                        <div class="small text-muted">

                                            @if (string.Equals(
                                                item.FindingType,
                                                "NeedsReview",
                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span>
                                                    Needs Manual Review
                                                </span>
                                            }
                                            else
                                            {
                                                @item.FindingType
                                            }

                                        </div>


                                        @if (!string.IsNullOrWhiteSpace(
                                            item.Impact))
                                        {
                                            <div class="small
                                                        text-muted
                                                        mt-1">
                                                Severity:
                                                @item.Impact
                                            </div>
                                        }


                                        <div class="mt-2">

                                            @if (item.IsTracked)
                                            {
                                                <span class="badge
                                                             text-bg-primary">
                                                    Tracked
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge
                                                             text-bg-light
                                                             border
                                                             text-dark">
                                                    Not Tracked
                                                </span>
                                            }

                                        </div>

                                    </td>


                                    <!-- Original state -->

                                    <td style="min-width: 200px;">

                                        <div class="fw-semibold">
                                            Step @item.OriginalStepNumber
                                        </div>


                                        @if (!string.IsNullOrWhiteSpace(
                                            item.OriginalStepName))
                                        {
                                            <div class="small text-muted">
                                                @item.OriginalStepName
                                            </div>
                                        }


                                        <details class="small mt-2">

                                            <summary>
                                                View URL
                                            </summary>

                                            <div class="text-muted
                                                        text-break
                                                        mt-1">
                                                @item.OriginalUrl
                                            </div>

                                        </details>

                                    </td>


                                    <!-- Later state -->

                                    <td style="min-width: 215px;">

                                        @if (item.RetestStepNumber.HasValue)
                                        {
                                            <div class="fw-semibold">
                                                Step
                                                @item.RetestStepNumber.Value
                                            </div>


                                            @if (!string.IsNullOrWhiteSpace(
                                                item.RetestStepName))
                                            {
                                                <div class="small
                                                            text-muted">
                                                    @item.RetestStepName
                                                </div>
                                            }


                                            @if (item.StateConfidence.HasValue)
                                            {
                                                <div class="small mt-1">

                                                    <span class="text-muted">
                                                        State match:
                                                    </span>

                                                    @item.StateConfidence.Value.ToString("P0")

                                                </div>
                                            }


                                            @if (!string.IsNullOrWhiteSpace(
                                                item.RetestUrl))
                                            {
                                                <details class="small mt-2">

                                                    <summary>
                                                        View URL
                                                    </summary>

                                                    <div class="text-muted
                                                                text-break
                                                                mt-1">
                                                        @item.RetestUrl
                                                    </div>

                                                </details>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge
                                                         text-bg-warning">
                                                State Not Matched
                                            </span>

                                            <div class="small
                                                        text-muted
                                                        mt-2">
                                                No sufficiently similar
                                                state was found in the
                                                later workflow.
                                            </div>
                                        }

                                    </td>


                                    <!-- Result -->

                                    <td style="min-width: 170px;">

                                        <span class="badge
                                                     @resultBadgeClass">
                                            @resultLabel
                                        </span>


                                        @if (!string.IsNullOrWhiteSpace(
                                            item.Message))
                                        {
                                            <details class="small mt-2">

                                                <summary>
                                                    Result Details
                                                </summary>

                                                <div class="text-muted
                                                            mt-2">
                                                    @item.Message
                                                </div>

                                            </details>
                                        }

                                    </td>


                                    <!-- Match -->

                                    <td style="min-width: 145px;">

                                        @if (item.MatchConfidence > 0m)
                                        {
                                            <div class="fw-semibold">
                                                @item.MatchConfidence.ToString("P0")
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-muted">
                                                —
                                            </div>
                                        }


                                        @if (!string.IsNullOrWhiteSpace(
                                            item.MatchMethod))
                                        {
                                            <details class="small mt-1">

                                                <summary>
                                                    Technical
                                                </summary>

                                                <div class="text-muted
                                                            mt-1">
                                                    @item.MatchMethod
                                                </div>


                                                <div class="text-muted
                                                            mt-1">
                                                    Original Finding
                                                    #@item.OriginalAuthenticatedAuditFindingId
                                                </div>


                                                @if (item
                                                    .MatchedAuthenticatedAuditFindingId
                                                    .HasValue)
                                                {
                                                    <div class="text-muted
                                                                mt-1">
                                                        Later Finding
                                                        #@item.MatchedAuthenticatedAuditFindingId.Value
                                                    </div>
                                                }

                                            </details>
                                        }

                                    </td>


                                    <!-- Remediation -->

                                    <td style="min-width: 185px;">

                                        <div class="mb-2">

                                            <span class="badge
                                                         @remediationBadgeClass">
                                                @remediationStatusLabel
                                            </span>

                                        </div>


                                        @if (item.IsTracked &&
                                             item.RemediationItemId.HasValue)
                                        {
                                            <a asp-controller="AccessibilityRemediations"
                                               asp-action="Details"
                                               asp-route-id="@item.RemediationItemId.Value"
                                               class="btn
                                                      btn-sm
                                                      btn-outline-primary">
                                                View Remediation
                                            </a>
                                        }
                                        else
                                        {
                                            <div class="small text-muted">
                                                This finding has not
                                                been added to the
                                                Remediation Tracker.
                                            </div>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </section>
}


@section Scripts
{
    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const form =
                    document.getElementById(
                        "applyWorkflowRetestForm");

                if (!form) {
                    return;
                }


                form.addEventListener(
                    "submit",
                    function (event) {

                        const confirmed =
                            window.confirm(
                                "Record this comparison as a formal workflow retest? " +
                                "This will save retest evidence for tracked " +
                                "remediation items and may move detected items " +
                                "back to In Progress."
                            );


                        if (!confirmed) {
                            event.preventDefault();
                        }
                    });
            });
    </script>
}
