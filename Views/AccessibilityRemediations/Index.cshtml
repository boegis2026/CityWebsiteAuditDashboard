@model CityWebsiteAuditDashboard.ViewModels.AccessibilityRemediationIndexViewModel

@{
    ViewData["Title"] = "Accessibility Remediation Tracker";

    bool hasActiveFilters =
        !string.IsNullOrWhiteSpace(Model.StatusFilter) ||
        !string.IsNullOrWhiteSpace(Model.ApplicationFilter) ||
        !string.IsNullOrWhiteSpace(Model.SeverityFilter) ||
        !string.IsNullOrWhiteSpace(Model.AssigneeFilter);
}


<!-- =========================================================
     Page heading
     ========================================================= -->

<header class="mb-4">

    <div class="d-flex
                flex-wrap
                justify-content-between
                align-items-start
                gap-3">

        <div style="max-width: 760px;">

            <div class="small
                        fw-bold
                        text-uppercase
                        text-muted
                        mb-2"
                 style="letter-spacing: 0.06em;">
                Accessibility Management
            </div>

            <h1 class="h2 mb-2">
                Remediation Tracker
            </h1>

            <p class="text-muted mb-0">
                Manage detected accessibility findings from initial
                assignment through remediation, retesting, and
                verification.
            </p>

        </div>


        <div class="d-flex
                    flex-wrap
                    gap-2">

            <a asp-controller="AccessibilityWorkflowRetests"
               asp-action="Index"
               class="btn btn-primary">
                Workflow Retests
            </a>

            <a asp-controller="AccessibilityOverview"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Accessibility Overview
            </a>

        </div>

    </div>

</header>


<!-- =========================================================
     Workflow status summary
     ========================================================= -->

<section aria-labelledby="remediation-status-heading"
         class="mb-4">

    <div class="d-flex
                flex-wrap
                justify-content-between
                align-items-end
                gap-2
                mb-3">

        <div>

            <h2 id="remediation-status-heading"
                class="h3 mb-1">
                Current Remediation Status
            </h2>

            <p class="text-muted mb-0">
                Current lifecycle state of tracked accessibility
                findings.
            </p>

        </div>


        <span class="badge
                     text-bg-light
                     border
                     px-3
                     py-2">
            @Model.TotalCount total tracked
        </span>

    </div>


    <div class="row
                row-cols-1
                row-cols-sm-2
                row-cols-xl-5
                g-3">

        <!-- Open -->

        <div class="col">

            <a asp-controller="AccessibilityRemediations"
               asp-action="Index"
               asp-route-statusFilter="Open"
               class="text-decoration-none">

                <article class="card
                                shadow-sm
                                h-100
                                border-start
                                border-danger
                                border-4">

                    <div class="card-body">

                        <div class="dashboard-card-label">
                            Open
                        </div>

                        <div class="dashboard-card-value
                                    text-danger">
                            @Model.OpenCount
                        </div>

                        <div class="small text-muted">
                            Not yet in active remediation
                        </div>

                    </div>

                </article>

            </a>

        </div>


        <!-- In Progress -->

        <div class="col">

            <a asp-controller="AccessibilityRemediations"
               asp-action="Index"
               asp-route-statusFilter="InProgress"
               class="text-decoration-none">

                <article class="card
                                shadow-sm
                                h-100
                                border-start
                                border-primary
                                border-4">

                    <div class="card-body">

                        <div class="dashboard-card-label">
                            In Progress
                        </div>

                        <div class="dashboard-card-value">
                            @Model.InProgressCount
                        </div>

                        <div class="small text-muted">
                            Currently being addressed
                        </div>

                    </div>

                </article>

            </a>

        </div>


        <!-- Awaiting Verification -->

        <div class="col">

            <a asp-controller="AccessibilityRemediations"
               asp-action="Index"
               asp-route-statusFilter="Fixed"
               class="text-decoration-none">

                <article class="card
                                shadow-sm
                                h-100
                                border-start
                                border-warning
                                border-4">

                    <div class="card-body">

                        <div class="dashboard-card-label">
                            Awaiting Verification
                        </div>

                        <div class="dashboard-card-value">
                            @Model.FixedCount
                        </div>

                        <div class="small text-muted">
                            Reported fixed and ready for retesting
                        </div>

                    </div>

                </article>

            </a>

        </div>


        <!-- Verified -->

        <div class="col">

            <a asp-controller="AccessibilityRemediations"
               asp-action="Index"
               asp-route-statusFilter="Verified"
               class="text-decoration-none">

                <article class="card
                                shadow-sm
                                h-100
                                border-start
                                border-success
                                border-4">

                    <div class="card-body">

                        <div class="dashboard-card-label">
                            Verified
                        </div>

                        <div class="dashboard-card-value
                                    text-success">
                            @Model.VerifiedCount
                        </div>

                        <div class="small text-muted">
                            Remediation successfully verified
                        </div>

                    </div>

                </article>

            </a>

        </div>


        <!-- Won't Fix -->

        <div class="col">

            <a asp-controller="AccessibilityRemediations"
               asp-action="Index"
               asp-route-statusFilter="WontFix"
               class="text-decoration-none">

                <article class="card
                                shadow-sm
                                h-100
                                border-start
                                border-secondary
                                border-4">

                    <div class="card-body">

                        <div class="dashboard-card-label">
                            Won't Fix
                        </div>

                        <div class="dashboard-card-value">
                            @Model.WontFixCount
                        </div>

                        <div class="small text-muted">
                            Closed without remediation
                        </div>

                    </div>

                </article>

            </a>

        </div>

    </div>

</section>


<!-- =========================================================
     Workflow explanation
     ========================================================= -->

<div class="card shadow-sm mb-4">

    <div class="card-body py-3">

        <div class="d-flex
                    flex-wrap
                    align-items-center
                    gap-2">

            <span class="fw-semibold">
                Standard workflow:
            </span>

            <span class="badge text-bg-danger">
                Open
            </span>

            <span class="text-muted"
                  aria-hidden="true">
                →
            </span>

            <span class="badge text-bg-primary">
                In Progress
            </span>

            <span class="text-muted"
                  aria-hidden="true">
                →
            </span>

            <span class="badge text-bg-warning">
                Fixed – Awaiting Verification
            </span>

            <span class="text-muted"
                  aria-hidden="true">
                →
            </span>

            <span class="badge text-bg-success">
                Verified
            </span>

        </div>

    </div>

</div>


<!-- =========================================================
     Filters
     ========================================================= -->

<section aria-labelledby="remediation-filters-heading"
         class="card shadow-sm mb-4">

    <div class="card-header">

        <div class="d-flex
                    flex-wrap
                    justify-content-between
                    align-items-center
                    gap-2">

            <div>

                <h2 id="remediation-filters-heading"
                    class="h5 mb-1">
                    Remediation Filters
                </h2>

                <p class="small text-muted mb-0">
                    Filter the work queue by status, application,
                    severity, or assignee.
                </p>

            </div>


            @if (hasActiveFilters)
            {
                <span class="badge text-bg-primary">
                    Filters Applied
                </span>
            }

        </div>

    </div>


    <div class="card-body">

        <form method="get"
              asp-controller="AccessibilityRemediations"
              asp-action="Index">

            <div class="row g-3">

                <!-- Status -->

                <div class="col-12 col-md-6 col-xl-3">

                    <label for="statusFilter"
                           class="form-label fw-semibold">
                        Status
                    </label>

                    <select id="statusFilter"
                            name="statusFilter"
                            class="form-select">

                        <option value="">
                            All statuses
                        </option>


                        @if (Model.StatusFilter == "Open")
                        {
                            <option value="Open"
                                    selected>
                                Open
                            </option>
                        }
                        else
                        {
                            <option value="Open">
                                Open
                            </option>
                        }


                        @if (Model.StatusFilter == "InProgress")
                        {
                            <option value="InProgress"
                                    selected>
                                In Progress
                            </option>
                        }
                        else
                        {
                            <option value="InProgress">
                                In Progress
                            </option>
                        }


                        @if (Model.StatusFilter == "Fixed")
                        {
                            <option value="Fixed"
                                    selected>
                                Fixed – Awaiting Verification
                            </option>
                        }
                        else
                        {
                            <option value="Fixed">
                                Fixed – Awaiting Verification
                            </option>
                        }


                        @if (Model.StatusFilter == "Verified")
                        {
                            <option value="Verified"
                                    selected>
                                Verified
                            </option>
                        }
                        else
                        {
                            <option value="Verified">
                                Verified
                            </option>
                        }


                        @if (Model.StatusFilter == "WontFix")
                        {
                            <option value="WontFix"
                                    selected>
                                Won't Fix
                            </option>
                        }
                        else
                        {
                            <option value="WontFix">
                                Won't Fix
                            </option>
                        }

                    </select>

                </div>


                <!-- Application -->

                <div class="col-12 col-md-6 col-xl-3">

                    <label for="applicationFilter"
                           class="form-label fw-semibold">
                        Application
                    </label>

                    <select id="applicationFilter"
                            name="applicationFilter"
                            class="form-select">

                        <option value="">
                            All applications
                        </option>

                        @foreach (var application
                            in Model.ApplicationOptions)
                        {
                            if (Model.ApplicationFilter ==
                                application)
                            {
                                <option value="@application"
                                        selected>
                                    @application
                                </option>
                            }
                            else
                            {
                                <option value="@application">
                                    @application
                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- Severity -->

                <div class="col-12 col-md-6 col-xl-3">

                    <label for="severityFilter"
                           class="form-label fw-semibold">
                        Severity
                    </label>

                    <select id="severityFilter"
                            name="severityFilter"
                            class="form-select">

                        <option value="">
                            All severities
                        </option>


                        @if (Model.SeverityFilter ==
                            "critical")
                        {
                            <option value="critical"
                                    selected>
                                Critical
                            </option>
                        }
                        else
                        {
                            <option value="critical">
                                Critical
                            </option>
                        }


                        @if (Model.SeverityFilter ==
                            "serious")
                        {
                            <option value="serious"
                                    selected>
                                Serious
                            </option>
                        }
                        else
                        {
                            <option value="serious">
                                Serious
                            </option>
                        }


                        @if (Model.SeverityFilter ==
                            "moderate")
                        {
                            <option value="moderate"
                                    selected>
                                Moderate
                            </option>
                        }
                        else
                        {
                            <option value="moderate">
                                Moderate
                            </option>
                        }


                        @if (Model.SeverityFilter ==
                            "minor")
                        {
                            <option value="minor"
                                    selected>
                                Minor
                            </option>
                        }
                        else
                        {
                            <option value="minor">
                                Minor
                            </option>
                        }

                    </select>

                </div>


                <!-- Assignee -->

                <div class="col-12 col-md-6 col-xl-3">

                    <label for="assigneeFilter"
                           class="form-label fw-semibold">
                        Assigned To
                    </label>

                    <select id="assigneeFilter"
                            name="assigneeFilter"
                            class="form-select">

                        <option value="">
                            All assignees
                        </option>


                        @if (Model.AssigneeFilter ==
                            "Unassigned")
                        {
                            <option value="Unassigned"
                                    selected>
                                Unassigned
                            </option>
                        }
                        else
                        {
                            <option value="Unassigned">
                                Unassigned
                            </option>
                        }


                        @foreach (var assignee
                            in Model.AssigneeOptions)
                        {
                            if (Model.AssigneeFilter ==
                                assignee)
                            {
                                <option value="@assignee"
                                        selected>
                                    @assignee
                                </option>
                            }
                            else
                            {
                                <option value="@assignee">
                                    @assignee
                                </option>
                            }
                        }

                    </select>

                </div>

            </div>


            <div class="d-flex
                        flex-wrap
                        gap-2
                        mt-4">

                <button type="submit"
                        class="btn btn-primary">
                    Apply Filters
                </button>

                <a asp-controller="AccessibilityRemediations"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Clear Filters
                </a>

            </div>

        </form>

    </div>

</section>


<!-- =========================================================
     Work queue
     ========================================================= -->

<section aria-labelledby="remediation-items-heading">

    <div class="d-flex
                flex-wrap
                justify-content-between
                align-items-end
                gap-2
                mb-3">

        <div>

            <h2 id="remediation-items-heading"
                class="h3 mb-1">
                Remediation Work Queue
            </h2>

            <p class="text-muted mb-0">
                Findings currently included in the selected
                remediation scope.
            </p>

        </div>


        @if (Model.Items.Count > 0)
        {
            <span class="badge
                         text-bg-light
                         border
                         px-3
                         py-2">

                @Model.Items.Count
                item@(Model.Items.Count == 1 ? "" : "s")

            </span>
        }

    </div>


    @if (Model.Items.Count == 0)
    {
        <div class="card shadow-sm">

            <div class="card-body
                        text-center
                        py-5">

                @if (Model.TotalCount == 0)
                {
                    <h3 class="h5">
                        No remediation items yet
                    </h3>

                    <p class="text-muted mb-0">
                        Accessibility findings will appear here after
                        remediation tracking is started from an
                        authenticated audit.
                    </p>
                }
                else
                {
                    <h3 class="h5">
                        No matching remediation items
                    </h3>

                    <p class="text-muted mb-3">
                        No tracked findings match the selected filters.
                    </p>

                    <a asp-controller="AccessibilityRemediations"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Clear Filters
                    </a>
                }

            </div>

        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="table-responsive">

                <table class="table
                              table-hover
                              align-middle
                              mb-0">

                    <caption class="visually-hidden">
                        Accessibility remediation work queue
                    </caption>


                    <thead>

                        <tr>

                            <th scope="col">
                                Status
                            </th>

                            <th scope="col">
                                Application
                            </th>

                            <th scope="col">
                                Finding
                            </th>

                            <th scope="col">
                                Priority
                            </th>

                            <th scope="col">
                                Page / State
                            </th>

                            <th scope="col">
                                Assigned To
                            </th>

                            <th scope="col">
                                Detected
                            </th>

                            <th scope="col">
                                <span class="visually-hidden">
                                    Actions
                                </span>
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item
                            in Model.Items)
                        {
                            string statusBadgeClass =
                                item.Status switch
                                {
                                    "Open" =>
                                        "text-bg-danger",

                                    "InProgress" =>
                                        "text-bg-primary",

                                    "Fixed" =>
                                        "text-bg-warning",

                                    "Verified" =>
                                        "text-bg-success",

                                    "WontFix" =>
                                        "text-bg-secondary",

                                    _ =>
                                        "text-bg-secondary"
                                };


                            string statusLabel =
                                item.Status switch
                                {
                                    "InProgress" =>
                                        "In Progress",

                                    "Fixed" =>
                                        "Awaiting Verification",

                                    "WontFix" =>
                                        "Won't Fix",

                                    _ =>
                                        item.Status
                                };


                            string impactBadgeClass =
                                item.Impact?
                                    .ToLowerInvariant()
                                switch
                                {
                                    "critical" =>
                                        "text-bg-danger",

                                    "serious" =>
                                        "text-bg-danger",

                                    "moderate" =>
                                        "text-bg-warning",

                                    "minor" =>
                                        "text-bg-info",

                                    _ =>
                                        "text-bg-secondary"
                                };


                            bool isFixFirst =
                                (
                                    string.Equals(
                                        item.Impact,
                                        "critical",
                                        StringComparison.OrdinalIgnoreCase) ||

                                    string.Equals(
                                        item.Impact,
                                        "serious",
                                        StringComparison.OrdinalIgnoreCase)
                                ) &&
                                (
                                    string.Equals(
                                        item.WcagLevel,
                                        "A",
                                        StringComparison.OrdinalIgnoreCase) ||

                                    string.Equals(
                                        item.WcagLevel,
                                        "AA",
                                        StringComparison.OrdinalIgnoreCase)
                                );


                            <tr>

                                <!-- Status -->

                                <td>

                                    <span class="badge
                                                 @statusBadgeClass">
                                        @statusLabel
                                    </span>

                                </td>


                                <!-- Application -->

                                <td>

                                    <div class="fw-semibold">
                                        @item.ApplicationName
                                    </div>

                                </td>


                                <!-- Finding -->

                                <td style="min-width: 240px;">

                                    <div class="fw-semibold">
                                        @item.RuleId
                                    </div>


                                    <div class="small
                                                text-muted
                                                mt-1">

                                        @if (string.Equals(
                                            item.FindingType,
                                            "NeedsReview",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span>
                                                Needs Manual Review
                                            </span>
                                        }
                                        else
                                        {
                                            @item.FindingType
                                        }

                                    </div>


                                    <div class="small text-muted">

                                        @item.AffectedElementCount
                                        affected
                                        element@(item.AffectedElementCount == 1
                                            ? ""
                                            : "s")

                                    </div>

                                </td>


                                <!-- Priority -->

                                <td>

                                    <div class="d-flex
                                                flex-wrap
                                                gap-1">

                                        @if (isFixFirst)
                                        {
                                            <span class="badge
                                                         text-bg-danger">
                                                Fix First
                                            </span>
                                        }


                                        <span class="badge
                                                     @impactBadgeClass">

                                            @(string.IsNullOrWhiteSpace(
                                                item.Impact)
                                                ? "Unknown"
                                                : item.Impact)

                                        </span>


                                        @if (!string.IsNullOrWhiteSpace(
                                            item.WcagLevel))
                                        {
                                            <span class="badge
                                                         text-bg-primary">

                                                WCAG
                                                @item.WcagLevel

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge
                                                         text-bg-secondary">
                                                Other
                                            </span>
                                        }

                                    </div>

                                </td>


                                <!-- Page / State -->

                                <td style="min-width: 230px;">

                                    <div class="fw-semibold">
                                        @item.StepName
                                    </div>


                                    <div class="small
                                                text-muted
                                                text-truncate"
                                         style="max-width: 300px;"
                                         title="@item.Url">
                                        @item.Url
                                    </div>

                                </td>


                                <!-- Assigned -->

                                <td>

                                    @if (string.IsNullOrWhiteSpace(
                                        item.AssignedTo))
                                    {
                                        <span class="badge
                                                     text-bg-light
                                                     border
                                                     text-dark">
                                            Unassigned
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="fw-semibold">
                                            @item.AssignedTo
                                        </span>
                                    }

                                </td>


                                <!-- Detected -->

                                <td class="text-nowrap">

                                    @item.DetectedAt.ToString(
                                        "MMM d, yyyy")

                                </td>


                                <!-- Action -->

                                <td class="text-end">

                                    <a asp-controller="AccessibilityRemediations"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn
                                              btn-sm
                                              btn-outline-primary">
                                        Manage
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</section>
