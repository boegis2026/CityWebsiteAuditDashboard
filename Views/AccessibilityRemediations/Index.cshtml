@model CityWebsiteAuditDashboard.ViewModels.AccessibilityRemediationIndexViewModel

@{
    ViewData["Title"] = "Accessibility Remediation Tracker";
}

<div class="container py-4">

    <div class="d-flex flex-wrap
                justify-content-between
                align-items-start
                gap-3
                mb-4">

        <div>
            <h1 class="h2 mb-1">
                Accessibility Remediation Tracker
            </h1>

            <p class="text-muted mb-0">
                Track detected accessibility issues from assignment
                through remediation, retesting, and verification.
            </p>
        </div>

        <a asp-controller="AccessibilityOverview"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Accessibility Overview
        </a>
    </div>

    <div class="alert alert-info">
        <strong>Workflow:</strong>
        Open → In Progress → Fixed – Awaiting Verification → Verified
    </div>

    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-xl">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">
                        Open
                    </div>
                    <div class="fs-3 fw-semibold text-danger">
                        @Model.OpenCount
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">
                        In Progress
                    </div>
                    <div class="fs-3 fw-semibold">
                        @Model.InProgressCount
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">
                        Awaiting Verification
                    </div>
                    <div class="fs-3 fw-semibold">
                        @Model.FixedCount
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">
                        Verified
                    </div>
                    <div class="fs-3 fw-semibold text-success">
                        @Model.VerifiedCount
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">
                        Won't Fix
                    </div>
                    <div class="fs-3 fw-semibold">
                        @Model.WontFixCount
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h2 class="h5 mb-0">
                Filters
            </h2>
        </div>

        <div class="card-body">

            <form method="get"
                  asp-controller="AccessibilityRemediations"
                  asp-action="Index">

                <div class="row g-3">

                    <div class="col-md-3">
                        <label class="form-label">
                            Status
                        </label>

                        <select name="statusFilter"
                                class="form-select">

                            <option value="">
                                All statuses
                            </option>

                            <option value="Open"
                                    selected="@(Model.StatusFilter == "Open")">
                                Open
                            </option>

                            <option value="InProgress"
                                    selected="@(Model.StatusFilter == "InProgress")">
                                In Progress
                            </option>

                            <option value="Fixed"
                                    selected="@(Model.StatusFilter == "Fixed")">
                                Fixed – Awaiting Verification
                            </option>

                            <option value="Verified"
                                    selected="@(Model.StatusFilter == "Verified")">
                                Verified
                            </option>

                            <option value="WontFix"
                                    selected="@(Model.StatusFilter == "WontFix")">
                                Won't Fix
                            </option>

                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">
                            Application
                        </label>

                        <select name="applicationFilter"
                                class="form-select">

                            <option value="">
                                All applications
                            </option>

                            @foreach (var application
                                in Model.ApplicationOptions)
                            {
                                <option value="@application"
                                        selected="@(
                                        Model.ApplicationFilter
                                        == application)">
                                    @application
                                </option>
                            }

                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">
                            Severity
                        </label>

                        <select name="severityFilter"
                                class="form-select">

                            <option value="">
                                All severities
                            </option>

                            <option value="critical"
                                    selected="@(
                                    Model.SeverityFilter
                                    == "critical")">
                                Critical
                            </option>

                            <option value="serious"
                                    selected="@(
                                    Model.SeverityFilter
                                    == "serious")">
                                Serious
                            </option>

                            <option value="moderate"
                                    selected="@(
                                    Model.SeverityFilter
                                    == "moderate")">
                                Moderate
                            </option>

                            <option value="minor"
                                    selected="@(
                                    Model.SeverityFilter
                                    == "minor")">
                                Minor
                            </option>

                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">
                            Assigned To
                        </label>

                        <select name="assigneeFilter"
                                class="form-select">

                            <option value="">
                                All assignees
                            </option>

                            <option value="Unassigned"
                                    selected="@(
                                    Model.AssigneeFilter
                                    == "Unassigned")">
                                Unassigned
                            </option>

                            @foreach (var assignee
                                in Model.AssigneeOptions)
                            {
                                <option value="@assignee"
                                        selected="@(
                                        Model.AssigneeFilter
                                        == assignee)">
                                    @assignee
                                </option>
                            }

                        </select>
                    </div>

                </div>

                <div class="d-flex gap-2 mt-3">

                    <button type="submit"
                            class="btn btn-primary">
                        Apply Filters
                    </button>

                    <a asp-controller="AccessibilityRemediations"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Clear
                    </a>

                </div>

            </form>

        </div>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">

                <h2 class="h5">
                    No remediation items yet
                </h2>

                <p class="text-muted mb-0">
                    Accessibility findings will appear here after
                    remediation tracking is started for them.
                </p>

            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-header">
                <div class="d-flex flex-wrap
                            justify-content-between
                            align-items-center
                            gap-2">

                    <h2 class="h5 mb-0">
                        Remediation Items
                    </h2>

                    <span class="badge text-bg-secondary">
                        @Model.Items.Count total
                    </span>

                </div>
            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Status</th>
                            <th>Application</th>
                            <th>Finding</th>
                            <th>Severity</th>
                            <th>WCAG</th>
                            <th>Page / State</th>
                            <th>Assigned To</th>
                            <th>Detected</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.Items)
                        {
                            string statusBadgeClass =
                                item.Status switch
                                {
                                    "Open" =>
                                        "text-bg-danger",

                                    "InProgress" =>
                                        "text-bg-primary",

                                    "Fixed" =>
                                        "text-bg-warning",

                                    "Verified" =>
                                        "text-bg-success",

                                    "WontFix" =>
                                        "text-bg-secondary",

                                    _ =>
                                        "text-bg-secondary"
                                };

                            string statusLabel =
                                item.Status switch
                                {
                                    "InProgress" =>
                                        "In Progress",

                                    "Fixed" =>
                                        "Fixed – Awaiting Verification",

                                    "WontFix" =>
                                        "Won't Fix",

                                    _ =>
                                        item.Status
                                };

                            string impactBadgeClass =
                                item.Impact?.ToLowerInvariant() switch
                                {
                                    "critical" =>
                                        "text-bg-danger",

                                    "serious" =>
                                        "text-bg-danger",

                                    "moderate" =>
                                        "text-bg-warning",

                                    "minor" =>
                                        "text-bg-info",

                                    _ =>
                                        "text-bg-secondary"
                                };

                            <tr>

                                <td>
                                    <span class="badge @statusBadgeClass">
                                        @statusLabel
                                    </span>
                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        @item.ApplicationName
                                    </div>
                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        @item.RuleId
                                    </div>

                                    <div class="small text-muted">
                                        @item.FindingType
                                    </div>

                                    <div class="small text-muted">
                                        @item.AffectedElementCount
                                        affected
                                    </div>
                                </td>

                                <td>
                                    <span class="badge @impactBadgeClass">
                                        @(item.Impact ?? "Unknown")
                                    </span>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(
                                        item.WcagLevel))
                                    {
                                        <span class="badge text-bg-primary">
                                            @item.WcagLevel
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            Other
                                        </span>
                                    }
                                </td>

                                <td style="min-width: 220px;">

                                    <div>
                                        @item.StepName
                                    </div>

                                    <div class="small text-muted text-truncate"
                                         style="max-width: 300px;"
                                         title="@item.Url">
                                        @item.Url
                                    </div>

                                </td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(
                                        item.AssignedTo))
                                    {
                                        <span class="text-muted">
                                            Unassigned
                                        </span>
                                    }
                                    else
                                    {
                                        @item.AssignedTo
                                    }
                                </td>

                                <td class="text-nowrap">
                                    @item.DetectedAt.ToString(
                                        "yyyy-MM-dd")
                                </td>

                                <td class="text-end">
                                    <a asp-controller="AccessibilityRemediations"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Manage
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>
    }
</div>
