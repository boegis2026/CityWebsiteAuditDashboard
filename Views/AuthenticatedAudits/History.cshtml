@model CityWebsiteAuditDashboard.ViewModels.AuthenticatedAuditHistoryViewModel

@{
    ViewData["Title"] = "Audit History";

    int completedCount =
        Model.Runs.Count(run =>
            string.Equals(
                run.Status,
                "Completed",
                StringComparison.OrdinalIgnoreCase));

    int runningCount =
        Model.Runs.Count(run =>
            string.Equals(
                run.Status,
                "Running",
                StringComparison.OrdinalIgnoreCase));

    int unsuccessfulCount =
        Model.Runs.Count(run =>
            string.Equals(
                run.Status,
                "Failed",
                StringComparison.OrdinalIgnoreCase) ||

            string.Equals(
                run.Status,
                "Cancelled",
                StringComparison.OrdinalIgnoreCase) ||

            string.Equals(
                run.Status,
                "Interrupted",
                StringComparison.OrdinalIgnoreCase));

    int totalStatesScanned =
        Model.Runs.Sum(run =>
            run.StepCount);

    int totalSuccessfulStates =
        Model.Runs.Sum(run =>
            run.SuccessfulStepCount);
}


<!-- =========================================================
     Page heading
     ========================================================= -->

<header class="mb-4">

    <div class="d-flex
                flex-wrap
                justify-content-between
                align-items-start
                gap-3">

        <div style="max-width: 760px;">

            <div class="small
                        fw-bold
                        text-uppercase
                        text-muted
                        mb-2"
                 style="letter-spacing: 0.06em;">
                Accessibility Auditing
            </div>

            <h1 class="h2 mb-2">
                Audit History
            </h1>

            <p class="text-muted mb-0">
                Review saved authenticated accessibility audits,
                open detailed findings, compare later workflow runs,
                and download reports.
            </p>

        </div>


        <div class="d-flex
                    flex-wrap
                    gap-2">

            <a asp-controller="AuthenticatedAudits"
               asp-action="Index"
               class="btn btn-primary">
                Start New Audit
            </a>

            <a asp-controller="AccessibilityWorkflowRetests"
               asp-action="Index"
               class="btn btn-outline-primary">
                Workflow Retests
            </a>

        </div>

    </div>

</header>


<!-- =========================================================
     Validation
     ========================================================= -->

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>
}


<!-- =========================================================
     History summary
     ========================================================= -->

<section aria-labelledby="history-summary-heading"
         class="mb-4">

    <div class="mb-3">

        <h2 id="history-summary-heading"
            class="h3 mb-1">
            Audit Activity
        </h2>

        <p class="text-muted mb-0">

            @if (Model.HasActiveFilters)
            {
                <span>
                    Summary of the audit runs matching the current
                    history filters.
                </span>
            }
            else
            {
                <span>
                    Summary of authenticated audit runs currently
                    saved in the dashboard.
                </span>
            }

        </p>

    </div>


    <div class="row
                row-cols-1
                row-cols-sm-2
                row-cols-xl-4
                g-3">

        <!-- Visible runs -->

        <div class="col">

            <article class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="dashboard-card-label">
                        Audit Runs
                    </div>

                    <div class="dashboard-card-value">
                        @Model.Runs.Count
                    </div>

                    <div class="small text-muted">

                        @if (Model.HasActiveFilters)
                        {
                            <span>
                                of @Model.TotalAvailableRuns saved audits
                            </span>
                        }
                        else
                        {
                            <span>
                                Saved authenticated audits
                            </span>
                        }

                    </div>

                </div>

            </article>

        </div>


        <!-- Completed -->

        <div class="col">

            <article class="card
                            shadow-sm
                            h-100
                            border-start
                            border-success
                            border-4">

                <div class="card-body">

                    <div class="dashboard-card-label">
                        Completed
                    </div>

                    <div class="dashboard-card-value
                                text-success">
                        @completedCount
                    </div>

                    <div class="small text-muted">
                        Completed audit runs
                    </div>

                </div>

            </article>

        </div>


        <!-- States -->

        <div class="col">

            <article class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="dashboard-card-label">
                        States Scanned
                    </div>

                    <div class="dashboard-card-value">
                        @totalStatesScanned
                    </div>

                    <div class="small text-muted">
                        @totalSuccessfulStates successful states
                    </div>

                </div>

            </article>

        </div>


        <!-- Attention -->

        <div class="col">

            <article class="card
                            shadow-sm
                            h-100
                            border-start
                            @(unsuccessfulCount > 0
                                ? "border-warning"
                                : "border-secondary")
                            border-4">

                <div class="card-body">

                    <div class="dashboard-card-label">
                        Needs Attention
                    </div>

                    <div class="dashboard-card-value">
                        @unsuccessfulCount
                    </div>

                    <div class="small text-muted">

                        Failed, cancelled, or interrupted

                        @if (runningCount > 0)
                        {
                            <span>
                                · @runningCount running
                            </span>
                        }

                    </div>

                </div>

            </article>

        </div>

    </div>

</section>


<!-- =========================================================
     History filters
     ========================================================= -->

<section aria-labelledby="history-filters-heading"
         class="card shadow-sm mb-4">

    <div class="card-header">

        <div class="d-flex
                    flex-wrap
                    justify-content-between
                    align-items-center
                    gap-2">

            <div>

                <h2 id="history-filters-heading"
                    class="h5 mb-1">
                    Audit History Filters
                </h2>

                <p class="small text-muted mb-0">
                    Narrow saved audits by application, status, or
                    audit start date.
                </p>

            </div>


            @if (Model.HasActiveFilters)
            {
                <span class="badge
                             text-bg-primary
                             px-3
                             py-2">
                    Filters Applied
                </span>
            }

        </div>

    </div>


    <div class="card-body">

        <form method="get"
              asp-controller="AuthenticatedAudits"
              asp-action="History">

            <div class="row g-3">

                <!-- Application -->

                <div class="col-12 col-md-6 col-xl-3">

                    <label for="applicationFilter"
                           class="form-label fw-semibold">
                        Application
                    </label>

                    <select id="applicationFilter"
                            name="applicationFilter"
                            class="form-select">

                        <option value="">
                            All applications
                        </option>


                        @foreach (string application
                            in Model.ApplicationOptions)
                        {
                            if (string.Equals(
                                Model.ApplicationFilter,
                                application,
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@application"
                                        selected>
                                    @application
                                </option>
                            }
                            else
                            {
                                <option value="@application">
                                    @application
                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- Status -->

                <div class="col-12 col-md-6 col-xl-3">

                    <label for="statusFilter"
                           class="form-label fw-semibold">
                        Status
                    </label>

                    <select id="statusFilter"
                            name="statusFilter"
                            class="form-select">

                        <option value="">
                            All statuses
                        </option>


                        @foreach (string status
                            in Model.StatusOptions)
                        {
                            if (string.Equals(
                                Model.StatusFilter,
                                status,
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@status"
                                        selected>
                                    @status
                                </option>
                            }
                            else
                            {
                                <option value="@status">
                                    @status
                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- From -->

                <div class="col-12 col-md-6 col-xl-3">

                    <label for="startDate"
                           class="form-label fw-semibold">
                        From
                    </label>

                    <input id="startDate"
                           name="startDate"
                           type="date"
                           value="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                           class="form-control" />

                    <div class="form-text">
                        Audit start date
                    </div>

                </div>


                <!-- To -->

                <div class="col-12 col-md-6 col-xl-3">

                    <label for="endDate"
                           class="form-label fw-semibold">
                        To
                    </label>

                    <input id="endDate"
                           name="endDate"
                           type="date"
                           value="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                           class="form-control" />

                    <div class="form-text">
                        Includes the selected day
                    </div>

                </div>

            </div>


            <div class="d-flex
                        flex-wrap
                        justify-content-between
                        align-items-center
                        gap-3
                        mt-4">

                <div class="small text-muted">

                    @if (Model.HasActiveFilters)
                    {
                        <span>
                            Showing
                            <strong class="text-body">
                                @Model.Runs.Count
                            </strong>
                            of
                            <strong class="text-body">
                                @Model.TotalAvailableRuns
                            </strong>
                            audit runs.
                        </span>
                    }
                    else
                    {
                        <span>
                            @Model.TotalAvailableRuns
                            audit
                            @(Model.TotalAvailableRuns == 1
                                ? "run"
                                : "runs")
                            available.
                        </span>
                    }

                </div>


                <div class="d-flex
                            flex-wrap
                            gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Apply Filters
                    </button>


                    @if (Model.HasActiveFilters)
                    {
                        <a asp-controller="AuthenticatedAudits"
                           asp-action="History"
                           class="btn btn-outline-secondary">
                            Clear Filters
                        </a>
                    }

                </div>

            </div>

        </form>

    </div>

</section>


<!-- =========================================================
     Saved reports
     ========================================================= -->

<section aria-labelledby="saved-audits-heading">

    <div class="d-flex
                flex-wrap
                justify-content-between
                align-items-end
                gap-2
                mb-3">

        <div>

            <h2 id="saved-audits-heading"
                class="h3 mb-1">
                Saved Audit Reports
            </h2>

            <p class="text-muted mb-0">
                Open a report for detailed findings or download the
                formatted PDF version.
            </p>

        </div>


        @if (Model.TotalAvailableRuns > 0)
        {
            <span class="badge
                         text-bg-light
                         border
                         text-dark
                         px-3
                         py-2">

                @if (Model.HasActiveFilters)
                {
                    <span>
                        @Model.Runs.Count of
                        @Model.TotalAvailableRuns reports
                    </span>
                }
                else
                {
                    <span>
                        @Model.Runs.Count
                        report@(Model.Runs.Count == 1 ? "" : "s")
                    </span>
                }

            </span>
        }

    </div>


    @if (Model.Runs.Count == 0)
    {
        <div class="card shadow-sm">

            <div class="card-body
                        text-center
                        py-5">

                @if (Model.TotalAvailableRuns == 0)
                {
                    <h3 class="h5">
                        No Audit Reports Yet
                    </h3>

                    <p class="text-muted mb-3">
                        Completed authenticated audits will appear here.
                    </p>

                    <a asp-controller="AuthenticatedAudits"
                       asp-action="Index"
                       class="btn btn-primary">
                        Start Authenticated Audit
                    </a>
                }
                else
                {
                    <h3 class="h5">
                        No Audits Match These Filters
                    </h3>

                    <p class="text-muted mb-3">
                        Change or clear the current filters to view
                        other saved audit reports.
                    </p>

                    <a asp-controller="AuthenticatedAudits"
                       asp-action="History"
                       class="btn btn-outline-primary">
                        Clear Filters
                    </a>
                }

            </div>

        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="table-responsive">

                <table class="table
                              table-hover
                              align-middle
                              mb-0">

                    <caption class="visually-hidden">
                        Saved authenticated accessibility audit reports
                    </caption>


                    <thead>

                        <tr>

                            <th scope="col">
                                Audit
                            </th>

                            <th scope="col">
                                Status
                            </th>

                            <th scope="col">
                                Date
                            </th>

                            <th scope="col">
                                Workflow Coverage
                            </th>

                            <th scope="col">
                                Technical
                            </th>

                            <th scope="col">
                                <span class="visually-hidden">
                                    Actions
                                </span>
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var run in Model.Runs)
                        {
                            string normalizedStatus =
                                run.Status?.Trim() ??
                                string.Empty;


                            string statusBadgeClass =
                                normalizedStatus.ToLowerInvariant()
                                switch
                                {
                                    "completed" =>
                                        "text-bg-success",

                                    "running" =>
                                        "text-bg-primary",

                                    "failed" =>
                                        "text-bg-danger",

                                    "cancelled" =>
                                        "text-bg-warning",

                                    "interrupted" =>
                                        "text-bg-warning",

                                    _ =>
                                        "text-bg-secondary"
                                };


                            string statusBorderClass =
                                normalizedStatus.ToLowerInvariant()
                                switch
                                {
                                    "completed" =>
                                        "border-success",

                                    "running" =>
                                        "border-primary",

                                    "failed" =>
                                        "border-danger",

                                    "cancelled" =>
                                        "border-warning",

                                    "interrupted" =>
                                        "border-warning",

                                    _ =>
                                        "border-secondary"
                                };


                            <tr class="border-start
                                       @statusBorderClass
                                       border-3">

                                <!-- Audit identity -->

                                <td style="min-width: 270px;">

                                    <div class="small
                                                text-muted
                                                mb-1">
                                        Audit Run #@run.Id
                                    </div>


                                    <div class="fw-semibold">
                                        @run.ApplicationName
                                    </div>


                                    <details class="small mt-2">

                                        <summary>
                                            View Starting URL
                                        </summary>

                                        <div class="text-muted
                                                    text-break
                                                    mt-1"
                                             style="max-width: 420px;">
                                            @run.StartingUrl
                                        </div>

                                    </details>


                                    @if (!string.IsNullOrWhiteSpace(
                                        run.ErrorMessage))
                                    {
                                        <details class="small mt-2">

                                            <summary class="text-danger
                                                            fw-semibold">
                                                View Run Error
                                            </summary>

                                            <div class="text-danger
                                                        text-break
                                                        mt-1"
                                                 style="max-width: 420px;">
                                                @run.ErrorMessage
                                            </div>

                                        </details>
                                    }

                                </td>


                                <!-- Status -->

                                <td>

                                    <span class="badge
                                                 @statusBadgeClass">
                                        @run.Status
                                    </span>

                                </td>


                                <!-- Date -->

                                <td class="text-nowrap">

                                    <div class="fw-semibold">
                                        @run.StartedAt.ToString(
                                            "MMM d, yyyy")
                                    </div>

                                    <div class="small text-muted">

                                        Started
                                        @run.StartedAt.ToString(
                                            "h:mm tt")

                                        UTC

                                    </div>


                                    @if (run.CompletedAt.HasValue)
                                    {
                                        <div class="small
                                                    text-muted
                                                    mt-1">

                                            Completed
                                            @run.CompletedAt.Value.ToString(
                                                "h:mm tt")

                                            UTC

                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small
                                                    text-muted
                                                    mt-1">
                                            Not completed
                                        </div>
                                    }

                                </td>


                                <!-- Workflow coverage -->

                                <td style="min-width: 190px;">

                                    <div class="d-flex
                                                align-items-baseline
                                                gap-2">

                                        <span class="fs-5 fw-bold">
                                            @run.StepCount
                                        </span>

                                        <span class="small text-muted">
                                            state@(run.StepCount == 1
                                                ? ""
                                                : "s")
                                        </span>

                                    </div>


                                    <div class="small mt-1">

                                        <span class="text-success
                                                     fw-semibold">
                                            @run.SuccessfulStepCount
                                        </span>

                                        successful

                                    </div>


                                    @if (run.FailedStepCount > 0)
                                    {
                                        <div class="small">

                                            <span class="text-danger
                                                         fw-semibold">
                                                @run.FailedStepCount
                                            </span>

                                            failed

                                        </div>
                                    }


                                    @if (run.FinalStepNumber.HasValue)
                                    {
                                        <div class="small
                                                    text-muted
                                                    mt-1">
                                            Final scanned state:
                                            Step @run.FinalStepNumber
                                        </div>
                                    }

                                </td>


                                <!-- Technical details -->

                                <td style="min-width: 140px;">

                                    <details class="small">

                                        <summary>
                                            View Details
                                        </summary>


                                        <div class="mt-2">

                                            <div class="text-muted">
                                                Accessibility engine
                                            </div>

                                            <div class="fw-semibold">
                                                @run.AccessibilityEngine
                                            </div>

                                        </div>

                                    </details>

                                </td>


                                <!-- Actions -->

                                <td class="text-end"
                                    style="min-width: 185px;">

                                    <div class="d-flex
                                                flex-column
                                                align-items-stretch
                                                gap-2">

                                        <a asp-controller="AuthenticatedAudits"
                                           asp-action="Details"
                                           asp-route-id="@run.Id"
                                           class="btn
                                                  btn-sm
                                                  btn-primary">
                                            View Report
                                        </a>


                                        <a asp-action="DownloadPdf"
                                           asp-route-id="@run.Id"
                                           class="btn
                                                  btn-sm
                                                  btn-outline-secondary">
                                            Download PDF
                                        </a>


                                        @if (string.Equals(
                                            run.Status,
                                            "Completed",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <a asp-controller="AccessibilityWorkflowRetests"
                                               asp-action="Index"
                                               asp-route-originalAuditRunId="@run.Id"
                                               class="btn
                                                      btn-sm
                                                      btn-outline-primary">
                                                Compare Retest
                                            </a>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</section>
