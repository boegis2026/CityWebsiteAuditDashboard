    <!-- =====================================================
         Run Automatic Workflow
         ===================================================== -->

    <script>
        async function runAuthenticatedAuditWorkflow(
            button) {

            const form =
                document.getElementById(
                    "runAutomaticWorkflowForm");

            const loadingText =
                document.getElementById(
                    "automaticWorkflowLoading");

            const resultContainer =
                document.getElementById(
                    "automaticWorkflowResult");


            if (!form ||
                !loadingText ||
                !resultContainer) {

                alert(
                    "The automatic workflow controls were not found.");

                return;
            }


            const maximumInput =
                document.getElementById(
                    "automaticMaximumStateCount");

            const maximumStateCount =
                Number(
                    maximumInput?.value);


            if (!Number.isInteger(
                    maximumStateCount) ||
                maximumStateCount < 1 ||
                maximumStateCount > 25) {

                alert(
                    "Maximum states must be between 1 and 25.");

                return;
            }


            button.disabled = true;

            loadingText.classList.remove(
                "d-none");

            resultContainer.className =
                "alert alert-secondary mt-3 mb-0";

            resultContainer.textContent =
                "The automatic workflow is running. Keep the " +
                "controlled Edge window open.";


            try {

                const response =
                    await fetch(
                        form.action,
                        {
                            method: "POST",
                            body: new FormData(
                                form),
                            credentials: "same-origin",
                            headers: {
                                "Accept": "application/json"
                            }
                        });


                const responseText =
                    await response.text();

                let result;


                try {
                    result =
                        JSON.parse(
                            responseText);
                }
                catch {
                    throw new Error(
                        "The server returned an unexpected response. " +
                        `HTTP status: ${response.status}.`);
                }


                if (!response.ok) {
                    throw new Error(
                        result.message ??
                        "The automatic workflow could not be completed.");
                }


                const scannedStateCountValue =
                    document.getElementById(
                        "scannedStateCountValue");

                const currentStateNumberValue =
                    document.getElementById(
                        "currentStateNumberValue");


                const lastCycle =
                    Array.isArray(
                        result.cycles)
                        ? result.cycles[
                            result.cycles.length - 1]
                        : null;


                const lastScannedStepNumber =
                    Number(
                        lastCycle?.scannedStepNumber);


                if (Number.isInteger(
                    lastScannedStepNumber)) {

                    if (scannedStateCountValue) {
                        scannedStateCountValue.textContent =
                            String(
                                lastScannedStepNumber);
                    }

                    if (currentStateNumberValue) {
                        currentStateNumberValue.textContent =
                            String(
                                lastScannedStepNumber + 1);
                    }
                }


                const stoppedSafely =
                    result.status ===
                        "ManualActionRequired" ||
                    result.status ===
                        "MaximumReached" ||
                    result.status ===
                        "LoopDetected" ||
                    result.status ===
                        "StoppedByUser";


                resultContainer.className =
                    result.status ===
                        "Completed"
                        ? "alert alert-success mt-3 mb-0"
                        : stoppedSafely
                            ? "alert alert-warning mt-3 mb-0"
                            : "alert alert-danger mt-3 mb-0";


                resultContainer.replaceChildren();


                const heading =
                    document.createElement(
                        "div");

                heading.className =
                    "fw-bold fs-5 mb-2";

                heading.textContent =
                    `Automatic workflow: ${result.status}`;


                const counts =
                    document.createElement(
                        "div");

                counts.textContent =
                    `Scanned states: ${result.scannedStateCount} | ` +
                    `Successful advances: ${result.advancedStateCount} | ` +
                    `Maximum allowed: ${result.maximumStateCount}`;


                resultContainer.append(
                    heading,
                    counts);


                if (result.finalUrl) {

                    const finalUrl =
                        document.createElement(
                            "div");

                    finalUrl.className =
                        "mt-2 small text-break";

                    finalUrl.textContent =
                        `Final URL: ${result.finalUrl}`;

                    resultContainer.append(
                        finalUrl);
                }


                if (result.message) {

                    const message =
                        document.createElement(
                            "div");

                    message.className =
                        "mt-2";

                    message.textContent =
                        result.message;

                    resultContainer.append(
                        message);
                }


                if (result.stopReason) {

                    const stopReason =
                        document.createElement(
                            "div");

                    stopReason.className =
                        "mt-2 fw-semibold";

                    stopReason.textContent =
                        `Stop reason: ${result.stopReason}`;

                    resultContainer.append(
                        stopReason);
                }


                if (result.status ===
                        "ManualActionRequired" ||
                    result.status ===
                        "LoopDetected" ||
                    result.status ===
                        "StoppedByUser") {

                    const resumeInstructions =
                        document.createElement(
                            "div");

                    resumeInstructions.className =
                        "alert alert-light border mt-3 mb-0";


                    if (result.status ===
                        "LoopDetected") {

                        resumeInstructions.textContent =
                            "The workflow returned to an earlier state. " +
                            "Review or advance the current page manually " +
                            "in Edge, then resume the workflow.";
                    }
                    else if (result.status ===
                        "StoppedByUser") {

                        resumeInstructions.textContent =
                            "The workflow was stopped. Review the " +
                            "current Edge page, then resume when ready.";
                    }
                    else {

                        resumeInstructions.textContent =
                            "Complete the current step manually in the " +
                            "controlled Edge window, then resume the " +
                            "workflow.";
                    }


                    resultContainer.append(
                        resumeInstructions);

                    button.textContent =
                        "Resume Automatic Workflow";
                }
                else {

                    button.textContent =
                        "Run Automatic Workflow";
                }


                if (Array.isArray(
                        result.cycles) &&
                    result.cycles.length > 0) {

                    const cycleSummary =
                        document.createElement(
                            "div");

                    cycleSummary.className =
                        "mt-3";


                    const cycleHeading =
                        document.createElement(
                            "div");

                    cycleHeading.className =
                        "fw-semibold mb-2";

                    cycleHeading.textContent =
                        "State History";


                    const list =
                        document.createElement(
                            "ol");

                    list.className =
                        "mb-0";


                    for (const cycle
                        of result.cycles) {

                        const item =
                            document.createElement(
                                "li");

                        const navigation =
                            cycle.navigationResult;

                        item.textContent =
                            `State ${
                                cycle.scannedStepNumber ??
                                "Unknown"}: ` +
                            `${
                                navigation?.status ??
                                "No navigation result"}`;

                        list.append(
                            item);
                    }


                    cycleSummary.append(
                        cycleHeading,
                        list);

                    resultContainer.append(
                        cycleSummary);
                }
            }
            catch (error) {

                console.error(error);

                resultContainer.className =
                    "alert alert-danger mt-3 mb-0";

                resultContainer.textContent =
                    error instanceof Error
                        ? error.message
                        : "The automatic workflow could not be completed.";
            }
            finally {

                button.disabled = false;

                loadingText.classList.add(
                    "d-none");
            }
        }
    </script>


    <!-- =====================================================
         Stop Automatic Workflow
         ===================================================== -->

    <script>
        async function stopAuthenticatedAuditWorkflow(
            button) {

            const form =
                document.getElementById(
                    "runAutomaticWorkflowForm");

            const resultContainer =
                document.getElementById(
                    "automaticWorkflowStopResult");

            const stopUrl =
                button.dataset.stopUrl;


            if (!form ||
                !resultContainer ||
                !stopUrl) {

                alert(
                    "The automatic workflow stop controls were not found.");

                return;
            }


            button.disabled = true;

            resultContainer.className =
                "alert alert-secondary mt-2 mb-0";

            resultContainer.textContent =
                "Requesting workflow stop...";


            try {

                const response =
                    await fetch(
                        stopUrl,
                        {
                            method: "POST",
                            body: new FormData(
                                form),
                            credentials: "same-origin",
                            headers: {
                                "Accept": "application/json"
                            }
                        });


                const responseText =
                    await response.text();

                let result;


                try {
                    result =
                        JSON.parse(
                            responseText);
                }
                catch {
                    throw new Error(
                        "The server returned an unexpected response. " +
                        `HTTP status: ${response.status}.`);
                }


                if (!response.ok) {
                    throw new Error(
                        result.message ??
                        "The stop request could not be completed.");
                }


                resultContainer.className =
                    result.stopRequested
                        ? "alert alert-warning mt-2 mb-0"
                        : "alert alert-info mt-2 mb-0";


                resultContainer.textContent =
                    result.message ??
                    "The stop request was processed.";
            }
            catch (error) {

                console.error(error);

                resultContainer.className =
                    "alert alert-danger mt-2 mb-0";

                resultContainer.textContent =
                    error instanceof Error
                        ? error.message
                        : "The stop request could not be completed.";
            }
            finally {

                button.disabled = false;
            }
        }
    </script>
}
