@model CityWebsiteAuditDashboard.ViewModels.AuthenticatedAuditDashboardViewModel
@using CityWebsiteAuditDashboard.Services.AuthenticatedAuditing

@{
    ViewData["Title"] = "Authenticated Audit";
}


<!-- =========================================================
     Page heading
     ========================================================= -->

<header class="mb-4">

    <div class="d-flex
                flex-wrap
                justify-content-between
                align-items-start
                gap-3">

        <div style="max-width: 780px;">

            <div class="small
                        fw-bold
                        text-uppercase
                        text-muted
                        mb-2"
                 style="letter-spacing: 0.06em;">
                Accessibility Auditing
            </div>

            <h1 class="h2 mb-2">
                Authenticated Audit
            </h1>

            <p class="text-muted mb-0">
                Audit protected application workflows using the
                controlled Edge browser and authenticated session.
            </p>

        </div>


        <a asp-controller="AuthenticatedAudits"
           asp-action="History"
           class="btn btn-outline-primary">
            Audit History
        </a>

    </div>

</header>


<!-- =========================================================
     Messages
     ========================================================= -->

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>
}


@if (!string.IsNullOrWhiteSpace(
    Model.StatusMessage))
{
    <div class="alert alert-info"
         role="status">
        @Model.StatusMessage
    </div>
}


@if (!Model.SessionIsActive)
{
    <!-- =====================================================
         Start audit
         ===================================================== -->

    <section aria-labelledby="start-audit-heading"
             class="row g-4">

        <div class="col-12 col-xl-8">

            <div class="card shadow-sm">

                <div class="card-header">

                    <h2 id="start-audit-heading"
                        class="h5 mb-1">
                        Start Authenticated Audit
                    </h2>

                    <p class="small text-muted mb-0">
                        Launch a controlled browser session for the
                        application you want to audit.
                    </p>

                </div>


                <div class="card-body">

                    <form asp-controller="AuthenticatedAudits"
                          asp-action="Start"
                          method="post"
                          id="authenticatedAuditStartForm">

                        @Html.AntiForgeryToken()


                        <div class="mb-4">

                            <label asp-for="StartInput.ApplicationName"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="StartInput.ApplicationName"
                                   class="form-control"
                                   placeholder="Example: CSR" />

                            <span asp-validation-for="StartInput.ApplicationName"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Use a clear application name that will
                                identify this audit in reports and history.
                            </div>

                        </div>


                        <div class="mb-4">

                            <label asp-for="StartInput.StartingUrl"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="StartInput.StartingUrl"
                                   class="form-control"
                                   placeholder="https://example.lacity.org/" />

                            <span asp-validation-for="StartInput.StartingUrl"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Enter the page where the browser should
                                begin the authentication process.
                            </div>

                        </div>


                        <div class="card
                                    border-primary
                                    bg-light
                                    mb-4">

                            <div class="card-body py-3">

                                <div class="fw-semibold mb-1">
                                    Manual Sign-In
                                </div>

                                <div class="small text-muted">
                                    Credentials are entered directly in
                                    the controlled Edge browser, not in
                                    this dashboard.
                                </div>

                            </div>

                        </div>


                        <button type="submit"
                                class="btn btn-primary"
                                id="authenticatedAuditStartButton">
                            Start Browser Session
                        </button>


                        <div id="authenticatedAuditStartProgress"
                             class="alert
                                    alert-primary
                                    mt-3
                                    mb-0
                                    d-none"
                             role="status"
                             aria-live="polite">

                            <strong>
                                Starting browser session.
                            </strong>

                            Please wait while the controlled Edge
                            window opens.

                        </div>

                    </form>

                </div>

            </div>

        </div>


        <div class="col-12 col-xl-4">

            <aside class="card shadow-sm h-100">

                <div class="card-header">

                    <h2 class="h5 mb-0">
                        Audit Process
                    </h2>

                </div>


                <div class="card-body">

                    <div class="d-flex gap-3 mb-4">

                        <div>
                            <span class="badge text-bg-primary">
                                1
                            </span>
                        </div>

                        <div>

                            <div class="fw-semibold">
                                Start Browser
                            </div>

                            <div class="small text-muted">
                                Enter the application and starting URL.
                            </div>

                        </div>

                    </div>


                    <div class="d-flex gap-3 mb-4">

                        <div>
                            <span class="badge text-bg-primary">
                                2
                            </span>
                        </div>

                        <div>

                            <div class="fw-semibold">
                                Sign In
                            </div>

                            <div class="small text-muted">
                                Authenticate directly in the Edge
                                window.
                            </div>

                        </div>

                    </div>


                    <div class="d-flex gap-3">

                        <div>
                            <span class="badge text-bg-primary">
                                3
                            </span>
                        </div>

                        <div>

                            <div class="fw-semibold">
                                Run Audit
                            </div>

                            <div class="small text-muted">
                                Scan individual states, known URLs, or
                                the supported workflow.
                            </div>

                        </div>

                    </div>

                </div>

            </aside>

        </div>

    </section>
}
else
{
    <!-- =====================================================
         Active session overview
         ===================================================== -->

    <section aria-labelledby="active-session-heading"
             class="card
                    shadow-sm
                    border-start
                    border-success
                    border-4
                    mb-4">

        <div class="card-body">

            <div class="d-flex
                        flex-wrap
                        justify-content-between
                        align-items-start
                        gap-4">

                <div>

                    <div class="d-flex
                                flex-wrap
                                align-items-center
                                gap-2
                                mb-2">

                        <h2 id="active-session-heading"
                            class="h4 mb-0">
                            @Model.ApplicationName
                        </h2>

                        <span class="badge text-bg-success">
                            Browser Session Active
                        </span>

                    </div>


                    <div class="small text-muted text-break">
                        @Model.StartingUrl
                    </div>


                    <div class="small text-muted mt-2">

                        @Model.AccessibilityEngine

                        @if (Model.StartedAt.HasValue)
                        {
                            <span aria-hidden="true">
                                ·
                            </span>

                            <span>
                                Started
                                @Model.StartedAt.Value.ToString(
                                    "MMM d, yyyy h:mm tt")
                                UTC
                            </span>
                        }

                    </div>

                </div>


                <div class="d-flex
                            flex-wrap
                            gap-4">

                    <div>

                        <div class="dashboard-card-label">
                            States Scanned
                        </div>

                        <div id="scannedStateCountValue"
                             class="fs-2 fw-bold">
                            @Model.ScannedStateCount
                        </div>

                    </div>


                    <div>

                        <div class="dashboard-card-label">
                            Current State
                        </div>

                        <div id="currentStateNumberValue"
                             class="fs-2 fw-bold">
                            @Model.CurrentStateNumber
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         Primary automatic workflow
         ===================================================== -->

    <section aria-labelledby="automatic-workflow-heading"
             class="card shadow-sm mb-4">

        <div class="card-header">

            <div class="d-flex
                        flex-wrap
                        justify-content-between
                        align-items-center
                        gap-2">

                <div>

                    <h2 id="automatic-workflow-heading"
                        class="h5 mb-1">
                        Automatic Workflow
                    </h2>

                    <p class="small text-muted mb-0">
                        Scan supported rendered states and advance
                        through the workflow.
                    </p>

                </div>

                <span class="badge text-bg-primary">
                    Primary Workflow
                </span>

            </div>

        </div>


        <div class="card-body">

            <form id="runAutomaticWorkflowForm"
                  asp-controller="AuthenticatedAudits"
                  asp-action="RunAutomaticWorkflow"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="sessionId"
                       value="@Model.SessionId" />


                <div class="row
                            g-3
                            align-items-end">

                    <div class="col-12 col-md-4 col-xl-3">

                        <label for="automaticMaximumStateCount"
                               class="form-label fw-semibold">
                            Maximum States
                        </label>

                        <input type="number"
                               id="automaticMaximumStateCount"
                               name="maximumStateCount"
                               class="form-control"
                               value="25"
                               min="1"
                               max="25"
                               required />

                        <div class="form-text">
                            Maximum supported workflow states: 25.
                        </div>

                    </div>


                    <div class="col-12 col-md-8 col-xl-9">

                        <div class="d-flex
                                    flex-wrap
                                    gap-2">

                            <button type="button"
                                    id="runAutomaticWorkflowButton"
                                    class="btn btn-primary"
                                    onclick="runAuthenticatedAuditWorkflow(this)">
                                Run Automatic Workflow
                            </button>


                            <button type="button"
                                    id="stopAutomaticWorkflowButton"
                                    class="btn btn-outline-danger"
                                    data-stop-url="@Url.Action(
                                        "StopAutomaticWorkflow",
                                        "AuthenticatedAudits")"
                                    onclick="stopAuthenticatedAuditWorkflow(this)">
                                Stop Workflow
                            </button>

                        </div>


                        <div id="automaticWorkflowLoading"
                             class="small
                                    text-muted
                                    mt-2
                                    d-none">
                            Scanning and navigating workflow states...
                        </div>

                    </div>

                </div>


                <div id="automaticWorkflowResult"
                     class="mt-3 d-none"
                     aria-live="polite">
                </div>

                <div id="automaticWorkflowStopResult"
                     class="mt-2 d-none"
                     aria-live="polite">
                </div>

            </form>

        </div>

    </section>


    <!-- =====================================================
         Manual / diagnostic controls
         ===================================================== -->

    <section aria-labelledby="manual-controls-heading"
             class="card shadow-sm mb-4">

        <div class="card-header">

            <div class="d-flex
                        flex-wrap
                        justify-content-between
                        align-items-center
                        gap-2">

                <div>

                    <h2 id="manual-controls-heading"
                        class="h5 mb-1">
                        Current State Controls
                    </h2>

                    <p class="small text-muted mb-0">
                        Scan, inspect, fill, preview, or advance the
                        current rendered browser state.
                    </p>

                </div>

                <span class="badge
                             text-bg-light
                             border">
                    Manual Controls
                </span>

            </div>

        </div>


        <div class="card-body">

            <div class="d-flex
                        flex-wrap
                        align-items-center
                        gap-2">

                <!-- Scan Current Step -->

                <form asp-controller="AuthenticatedAudits"
                      asp-action="Scan"
                      method="post"
                      id="authenticatedAuditScanForm"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="SessionId"
                           value="@Model.SessionId" />

                    <input type="hidden"
                           name="ApplicationName"
                           value="@Model.ApplicationName" />

                    <input type="hidden"
                           name="StartingUrl"
                           value="@Model.StartingUrl" />

                    <input type="hidden"
                           name="AccessibilityEngine"
                           value="@Model.AccessibilityEngine" />

                    <input type="hidden"
                           name="StartedAt"
                           value="@Model.StartedAt?.ToString("O")" />


                    <button type="submit"
                            class="btn btn-primary"
                            id="authenticatedAuditScanButton">

                        <span id="authenticatedAuditScanButtonText">
                            Scan Current Step
                        </span>

                        <span id="authenticatedAuditScanSpinner"
                              class="spinner-border
                                     spinner-border-sm
                                     ms-2
                                     d-none"
                              aria-hidden="true">
                        </span>

                    </button>

                </form>


                <!-- Analyze -->

                <button type="button"
                        id="analyzeCurrentStateButton"
                        class="btn btn-outline-primary"
                        data-session-id="@Model.SessionId"
                        onclick="analyzeAuthenticatedAuditState(this)">
                    Analyze Current State
                </button>


                <!-- Fill -->

                <form id="fillCurrentStateForm"
                      asp-controller="AuthenticatedAudits"
                      asp-action="FillCurrentState"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="sessionId"
                           value="@Model.SessionId" />

                    <button type="button"
                            id="fillCurrentStateButton"
                            class="btn btn-outline-success"
                            onclick="fillAuthenticatedAuditState(this)">
                        Fill Current State
                    </button>

                </form>


                <!-- Preview -->

                <form id="previewAutomaticStepForm"
                      asp-controller="AuthenticatedAudits"
                      asp-action="PreviewAutomaticStep"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="sessionId"
                           value="@Model.SessionId" />

                    <button type="button"
                            id="previewAutomaticStepButton"
                            class="btn btn-outline-secondary"
                            onclick="previewAuthenticatedAuditStep(this)">
                        Preview Next Step
                    </button>

                </form>


                <!-- Advance -->

                <form id="advanceAutomaticStepForm"
                      asp-controller="AuthenticatedAudits"
                      asp-action="AdvanceAutomaticStep"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="sessionId"
                           value="@Model.SessionId" />

                    <button type="button"
                            id="advanceAutomaticStepButton"
                            class="btn btn-outline-warning"
                            onclick="advanceAuthenticatedAuditStep(this)">
                        Advance One Step
                    </button>

                </form>


                <!-- Scan + Advance -->

                <form id="scanAndAdvanceAutomaticStepForm"
                      asp-controller="AuthenticatedAudits"
                      asp-action="ScanAndAdvanceAutomaticStep"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="sessionId"
                           value="@Model.SessionId" />

                    <button type="button"
                            id="scanAndAdvanceAutomaticStepButton"
                            class="btn btn-outline-primary"
                            onclick="scanAndAdvanceAuthenticatedAuditStep(this)">
                        Scan and Advance Once
                    </button>

                </form>

            </div>


            <!-- Loading messages -->

            <div class="small text-muted mt-3">

                <span id="navigationAnalysisLoading"
                      class="d-none me-3">
                    Analyzing rendered page...
                </span>

                <span id="fieldFillLoading"
                      class="d-none me-3">
                    Filling supported fields...
                </span>

                <span id="automaticStepPreviewLoading"
                      class="d-none me-3">
                    Preparing automatic step...
                </span>

                <span id="automaticStepAdvanceLoading"
                      class="d-none me-3">
                    Advancing workflow...
                </span>

                <span id="scanAndAdvanceLoading"
                      class="d-none">
                    Scanning and advancing...
                </span>

            </div>


            <!-- AJAX results -->

            <div id="navigationAnalysisResult"
                 class="mt-3 d-none"
                 aria-live="polite">
            </div>

            <div id="fieldFillResult"
                 class="mt-3 d-none"
                 aria-live="polite">
            </div>

            <div id="automaticStepPreviewResult"
                 class="mt-3 d-none"
                 aria-live="polite">
            </div>

            <div id="automaticStepAdvanceResult"
                 class="mt-3 d-none"
                 aria-live="polite">
            </div>

            <div id="scanAndAdvanceResult"
                 class="mt-3 d-none"
                 aria-live="polite">
            </div>


            <!-- Scan progress -->

            <div id="authenticatedAuditScanProgress"
                 class="alert
                        alert-primary
                        mt-3
                        mb-0
                        d-none"
                 role="status"
                 aria-live="polite">

                <strong>
                    Scanning current state.
                </strong>

                Keep the controlled Edge window open while the scan is
                processed.

            </div>


            <div id="authenticatedAuditProgressPanel"
                 class="card
                        border-primary
                        mt-3
                        d-none"
                 aria-live="polite"
                 aria-atomic="true">

                <div class="card-body">

                    <div class="d-flex
                                flex-wrap
                                justify-content-between
                                align-items-center
                                gap-2
                                mb-3">

                        <h3 class="h6 mb-0">
                            Scan Progress
                        </h3>

                        <span id="authenticatedAuditCurrentStep"
                              class="badge text-bg-primary">
                            —
                        </span>

                    </div>


                    <div class="small mb-2">

                        <strong>
                            Current Page:
                        </strong>

                        <span id="authenticatedAuditCurrentUrl"
                              class="text-break">
                            Preparing scan...
                        </span>

                    </div>


                    <div class="small mb-3">

                        <strong>
                            Current Stage:
                        </strong>

                        <span id="authenticatedAuditCurrentStage">
                            Opening page
                        </span>

                    </div>


                    <div class="progress"
                         role="progressbar"
                         aria-label="Current page scan stage"
                         aria-valuemin="0"
                         aria-valuemax="100">

                        <div id="authenticatedAuditProgressBar"
                             class="progress-bar
                                    progress-bar-striped
                                    progress-bar-animated"
                             style="width: 0%;"
                             aria-valuenow="0">
                            0%
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         Authenticated batch
         ===================================================== -->

    <section aria-labelledby="authenticated-batch-heading"
             class="card shadow-sm mb-4">

        <div class="card-header">

            <h2 id="authenticated-batch-heading"
                class="h5 mb-1">
                Authenticated Batch Analysis
            </h2>

            <p class="small text-muted mb-0">
                Scan multiple known protected URLs using the current
                authenticated browser session.
            </p>

        </div>


        <div class="card-body">

            <form asp-controller="AuthenticatedAudits"
                  asp-action="ScanBatch"
                  method="post"
                  id="authenticatedBatchForm"
                  data-starting-url="@Model.StartingUrl">

                @Html.AntiForgeryToken()


                <input asp-for="BatchInput.SessionId"
                       type="hidden"
                       value="@Model.SessionId.GetValueOrDefault()" />


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-3">

                    <div class="col-12 col-md-3">

                        <label asp-for="BatchInput.NumberOfUrls"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="BatchInput.NumberOfUrls"
                               id="authenticatedBatchExpectedCount"
                               class="form-control"
                               type="number"
                               min="1"
                               max="25"
                               placeholder="5" />

                        <span asp-validation-for="BatchInput.NumberOfUrls"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-12 col-md-9">

                        <label asp-for="BatchInput.Urls"
                               class="form-label fw-semibold">
                        </label>

                        <textarea asp-for="BatchInput.Urls"
                                  class="form-control"
                                  rows="6"
                                  id="authenticatedBatchUrls"
                                  placeholder="https://protected-app.example/page-1&#10;https://protected-app.example/page-2"></textarea>

                        <span asp-validation-for="BatchInput.Urls"
                              class="text-danger">
                        </span>


                        <div id="authenticatedBatchUrlStatus"
                             class="alert
                                    alert-secondary
                                    py-2
                                    mt-2
                                    mb-0"
                             role="status"
                             aria-live="polite">
                            No protected URLs detected yet.
                        </div>


                        <div id="authenticatedBatchDomainWarning"
                             class="alert
                                    alert-warning
                                    py-2
                                    mt-2
                                    mb-0
                                    d-none"
                             role="status"
                             aria-live="polite">
                        </div>


                        <div class="form-text">
                            One complete HTTP or HTTPS URL per line.
                            Blank lines are ignored. Maximum: 25 URLs.
                        </div>

                    </div>

                </div>


                <div class="d-flex
                            flex-wrap
                            align-items-center
                            gap-3
                            mt-4">

                    <button type="submit"
                            class="btn btn-primary"
                            id="authenticatedBatchButton">

                        <span id="authenticatedBatchButtonText">
                            Run Authenticated Batch
                        </span>

                        <span id="authenticatedBatchSpinner"
                              class="spinner-border
                                     spinner-border-sm
                                     ms-2
                                     d-none"
                              aria-hidden="true">
                        </span>

                    </button>


                    <span class="small text-muted">
                        Confirm that the controlled Edge browser is
                        still signed in before running the batch.
                    </span>

                </div>


                <div id="authenticatedBatchProgress"
                     class="alert
                            alert-primary
                            mt-3
                            mb-0
                            d-none"
                     role="status"
                     aria-live="polite">

                    <strong>
                        Authenticated batch is running.
                    </strong>

                    Keep the dashboard and controlled Edge browser open
                    until the batch completes.

                </div>

            </form>

        </div>

    </section>


    <!-- =====================================================
         Latest batch results
         ===================================================== -->

    @if (Model.LastBatchResult is not null)
    {
        int totalViolationRules =
            Model.LastBatchResult.Items.Sum(
                item => item.ViolationRuleCount);

        int totalNeedsReviewRules =
            Model.LastBatchResult.Items.Sum(
                item => item.NeedsReviewRuleCount);

        int totalAffectedElements =
            Model.LastBatchResult.Items.Sum(
                item => item.AffectedElementCount);

        int redirectedPageCount =
            Model.LastBatchResult.Items.Count(
                item => item.WasRedirected);

        var attentionItems =
            Model.LastBatchResult.Items
                .Where(item =>
                    !item.Succeeded ||
                    item.WasRedirected)
                .ToList();

        long averageDurationMilliseconds =
            Model.LastBatchResult.Items.Count > 0
                ? (long)Model.LastBatchResult.Items.Average(
                    item => item.DurationMilliseconds)
                : 0;

        TimeSpan averagePageDuration =
            TimeSpan.FromMilliseconds(
                averageDurationMilliseconds);

        TimeSpan totalBatchDuration =
            TimeSpan.FromMilliseconds(
                Model.LastBatchResult.DurationMilliseconds);


        <section aria-labelledby="latest-batch-results-heading"
                 class="card shadow-sm mb-4">

            <div class="card-header">

                <div class="d-flex
                            flex-wrap
                            justify-content-between
                            align-items-center
                            gap-3">

                    <div>

                        <h2 id="latest-batch-results-heading"
                            class="h5 mb-1">
                            Latest Batch Results
                        </h2>

                        <p class="small text-muted mb-0">
                            Results from the most recently completed
                            authenticated URL batch.
                        </p>

                    </div>


                    <div class="d-flex
                                flex-wrap
                                gap-2">

                        <span class="badge text-bg-light border">
                            @Model.LastBatchResult.RequestedCount
                            requested
                        </span>

                        <span class="badge text-bg-success">
                            @Model.LastBatchResult.SucceededCount
                            succeeded
                        </span>

                        @if (Model.LastBatchResult.FailedCount > 0)
                        {
                            <span class="badge text-bg-danger">
                                @Model.LastBatchResult.FailedCount
                                failed
                            </span>
                        }

                        <span class="badge text-bg-secondary">
                            @totalBatchDuration.ToString(@"m\:ss")
                        </span>

                    </div>

                </div>

            </div>


            <div class="card-body border-bottom">

                <div class="row
                            row-cols-2
                            row-cols-lg-4
                            g-3">

                    <div class="col">

                        <div class="border rounded p-3 h-100">

                            <div class="dashboard-card-label">
                                Violations
                            </div>

                            <div class="fs-3 fw-bold">
                                @totalViolationRules
                            </div>

                        </div>

                    </div>


                    <div class="col">

                        <div class="border rounded p-3 h-100">

                            <div class="dashboard-card-label">
                                Needs Review
                            </div>

                            <div class="fs-3 fw-bold">
                                @totalNeedsReviewRules
                            </div>

                        </div>

                    </div>


                    <div class="col">

                        <div class="border rounded p-3 h-100">

                            <div class="dashboard-card-label">
                                Affected Elements
                            </div>

                            <div class="fs-3 fw-bold">
                                @totalAffectedElements
                            </div>

                        </div>

                    </div>


                    <div class="col">

                        <div class="border rounded p-3 h-100">

                            <div class="dashboard-card-label">
                                Average Page Time
                            </div>

                            <div class="fs-3 fw-bold">
                                @averagePageDuration.ToString(
                                    @"m\:ss\.fff")
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            @if (attentionItems.Count > 0)
            {
                <div class="card-body border-bottom">

                    <div class="d-flex
                                flex-wrap
                                gap-2">

                        <form asp-controller="AuthenticatedAudits"
                              asp-action="LoadAttentionUrls"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()


                            @foreach (var attentionItem
                                in attentionItems)
                            {
                                <input type="hidden"
                                       name="urls"
                                       value="@attentionItem.Url" />
                            }


                            <button type="submit"
                                    class="btn
                                           btn-sm
                                           btn-outline-warning">

                                Load Attention URLs

                                <span class="badge
                                             text-bg-warning
                                             ms-1">
                                    @attentionItems.Count
                                </span>

                            </button>

                        </form>


                        <button type="button"
                                class="btn
                                       btn-sm
                                       btn-outline-secondary"
                                id="authenticatedBatchAttentionFilterButton">
                            Show Attention Only
                        </button>

                    </div>

                </div>
            }


            @if (redirectedPageCount > 0)
            {
                <div class="alert
                            alert-warning
                            rounded-0
                            border-start-0
                            border-end-0
                            mb-0">

                    <strong>
                        Navigation Review:
                    </strong>

                    @redirectedPageCount
                    requested URL@(redirectedPageCount == 1 ? "" : "s")
                    ended on a different final page.

                </div>
            }


            <div class="table-responsive">

                <table class="table
                              table-hover
                              align-middle
                              mb-0">

                    <caption class="visually-hidden">
                        Latest authenticated batch scan results
                    </caption>

                    <thead>

                        <tr>

                            <th scope="col">
                                Requested URL
                            </th>

                            <th scope="col">
                                Navigation
                            </th>

                            <th scope="col">
                                Result
                            </th>

                            <th scope="col">
                                Scan Time
                            </th>

                            <th scope="col">
                                State
                            </th>

                            <th scope="col"
                                class="text-end">
                                Violations
                            </th>

                            <th scope="col"
                                class="text-end">
                                Needs Review
                            </th>

                            <th scope="col"
                                class="text-end">
                                Elements
                            </th>

                        </tr>

                    </thead>


                    <tbody id="authenticatedBatchResultsBody">

                        @foreach (
                            AuthenticatedAuditBatchItemResult item
                            in Model.LastBatchResult.Items)
                        {
                            TimeSpan itemDuration =
                                TimeSpan.FromMilliseconds(
                                    item.DurationMilliseconds);


                            <tr data-attention="@(
                                (!item.Succeeded ||
                                 item.WasRedirected)
                                    .ToString()
                                    .ToLowerInvariant())">

                                <!-- URL -->

                                <td style="min-width: 260px;">

                                    <a href="@item.Url"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="text-break">
                                        @item.Url
                                    </a>


                                    @if (!string.IsNullOrWhiteSpace(
                                        item.ErrorMessage))
                                    {
                                        <div class="small
                                                    text-danger
                                                    mt-1">
                                            @item.ErrorMessage
                                        </div>
                                    }

                                </td>


                                <!-- Navigation -->

                                <td>

                                    @if (item.WasRedirected)
                                    {
                                        <span class="badge
                                                     text-bg-warning">
                                            Redirected
                                        </span>


                                        @if (!string.IsNullOrWhiteSpace(
                                            item.FinalUrl))
                                        {
                                            <details class="small mt-2">

                                                <summary>
                                                    Final URL
                                                </summary>

                                                <a href="@item.FinalUrl"
                                                   target="_blank"
                                                   rel="noopener noreferrer"
                                                   class="d-block
                                                          text-break
                                                          mt-1">
                                                    @item.FinalUrl
                                                </a>

                                            </details>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge
                                                     text-bg-success">
                                            Requested Page
                                        </span>
                                    }

                                </td>


                                <!-- Result -->

                                <td>

                                    @if (item.Succeeded)
                                    {
                                        <span class="badge
                                                     text-bg-success">
                                            Saved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge
                                                     text-bg-danger">
                                            Failed
                                        </span>
                                    }

                                </td>


                                <!-- Duration -->

                                <td class="text-nowrap">
                                    @itemDuration.ToString(
                                        @"m\:ss\.fff")
                                </td>


                                <!-- State -->

                                <td>

                                    @if (item.StepNumber.HasValue)
                                    {
                                        <div class="fw-semibold">
                                            Step @item.StepNumber
                                        </div>


                                        @if (!string.IsNullOrWhiteSpace(
                                            item.StepName))
                                        {
                                            <div class="small text-muted">
                                                @item.StepName
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <td class="text-end fw-semibold">
                                    @item.ViolationRuleCount
                                </td>

                                <td class="text-end">
                                    @item.NeedsReviewRuleCount
                                </td>

                                <td class="text-end">
                                    @item.AffectedElementCount
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <div class="card-footer">

                <div class="small text-muted">
                    Detailed rule-level findings are available from
                    Audit History after the session is completed.
                </div>

            </div>

        </section>
    }


    <!-- =====================================================
         Last scanned state
         ===================================================== -->

    @if (Model.LastStepResult is not null)
    {
        AuthenticatedAuditStepResult step =
            Model.LastStepResult;


        <section aria-labelledby="last-scanned-state-heading"
                 class="card shadow-sm mb-4">

            <div class="card-header">

                <div class="d-flex
                            flex-wrap
                            justify-content-between
                            align-items-center
                            gap-2">

                    <div>

                        <h2 id="last-scanned-state-heading"
                            class="h5 mb-1">
                            Last Scanned State
                        </h2>

                        <p class="small text-muted mb-0">
                            Step @step.StepNumber · @step.StepName
                        </p>

                    </div>


                    @if (step.ScanSucceeded)
                    {
                        <span class="badge text-bg-success">
                            Scan Succeeded
                        </span>
                    }
                    else
                    {
                        <span class="badge text-bg-danger">
                            Scan Failed
                        </span>
                    }

                </div>

            </div>


            <div class="card-body">

                <div class="row
                            row-cols-2
                            row-cols-md-4
                            g-3
                            mb-3">

                    <div class="col">

                        <div class="border rounded p-3 h-100">

                            <div class="dashboard-card-label">
                                Violations
                            </div>

                            <div class="fs-3 fw-bold">
                                @step.ViolationRuleCount
                            </div>

                        </div>

                    </div>


                    <div class="col">

                        <div class="border rounded p-3 h-100">

                            <div class="dashboard-card-label">
                                Affected Elements
                            </div>

                            <div class="fs-3 fw-bold">
                                @step.AffectedElementCount
                            </div>

                        </div>

                    </div>


                    <div class="col">

                        <div class="border rounded p-3 h-100">

                            <div class="dashboard-card-label">
                                Needs Review
                            </div>

                            <div class="fs-3 fw-bold">
                                @step.NeedsReviewRuleCount
                            </div>

                        </div>

                    </div>


                    <div class="col">

                        <div class="border rounded p-3 h-100">

                            <div class="dashboard-card-label">
                                Passed Rules
                            </div>

                            <div class="fs-3 fw-bold text-success">
                                @step.PassedRuleCount
                            </div>

                        </div>

                    </div>

                </div>


                <details class="border rounded p-3">

                    <summary class="fw-semibold">
                        Technical State Details
                    </summary>


                    <dl class="row mt-3 mb-0">

                        <dt class="col-md-3">
                            Page Title
                        </dt>

                        <dd class="col-md-9">
                            @(step.PageTitle ?? "Not detected")
                        </dd>


                        <dt class="col-md-3">
                            Main Heading
                        </dt>

                        <dd class="col-md-9">
                            @(step.Heading ?? "Not detected")
                        </dd>


                        <dt class="col-md-3">
                            Current URL
                        </dt>

                        <dd class="col-md-9 text-break">
                            @step.Url
                        </dd>


                        <dt class="col-md-3">
                            DOM Fingerprint
                        </dt>

                        <dd class="col-md-9">

                            <code class="text-break">
                                @(step.DomFingerprint ??
                                    "Not generated")
                            </code>

                        </dd>


                        <dt class="col-md-3">
                            Visible Forms
                        </dt>

                        <dd class="col-md-9">
                            @step.VisibleFormCount
                        </dd>


                        <dt class="col-md-3">
                            Visible Fields
                        </dt>

                        <dd class="col-md-9">
                            @step.VisibleFieldCount
                        </dd>


                        <dt class="col-md-3">
                            Visible Buttons
                        </dt>

                        <dd class="col-md-9">
                            @step.VisibleButtonCount
                        </dd>

                    </dl>

                </details>


                @if (!string.IsNullOrWhiteSpace(
                    step.ErrorMessage))
                {
                    <div class="alert alert-danger mt-3 mb-0">

                        <strong>
                            Scan Error:
                        </strong>

                        @step.ErrorMessage

                    </div>
                }

            </div>

        </section>
    }


    <!-- =====================================================
         Complete session
         ===================================================== -->

    <section aria-labelledby="complete-session-heading"
             class="card
                    border-danger
                    shadow-sm">

        <div class="card-header">

            <h2 id="complete-session-heading"
                class="h5 mb-1">
                Complete Audit Session
            </h2>

            <p class="small text-muted mb-0">
                Finish the current audit and close the controlled Edge
                browser.
            </p>

        </div>


        <div class="card-body">

            <form asp-controller="AuthenticatedAudits"
                  asp-action="Stop"
                  method="post"
                  id="authenticatedAuditStopForm">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       name="SessionId"
                       value="@Model.SessionId" />

                <input type="hidden"
                       name="ApplicationName"
                       value="@Model.ApplicationName" />

                <input type="hidden"
                       name="StartingUrl"
                       value="@Model.StartingUrl" />

                <input type="hidden"
                       name="AccessibilityEngine"
                       value="@Model.AccessibilityEngine" />

                <input type="hidden"
                       name="StartedAt"
                       value="@Model.StartedAt?.ToString("O")" />


                <div class="form-check mb-3">

                    <input class="form-check-input"
                           type="checkbox"
                           name="MarkLastStepAsFinal"
                           value="true"
                           checked
                           id="markLastStepAsFinal" />

                    <input type="hidden"
                           name="MarkLastStepAsFinal"
                           value="false" />


                    <label class="form-check-label"
                           for="markLastStepAsFinal">
                        Mark the last scanned state as final
                    </label>

                </div>


                <button type="submit"
                        class="btn btn-danger"
                        id="authenticatedAuditStopButton">
                    Complete and Close Browser
                </button>


                <div id="authenticatedAuditStopProgress"
                     class="alert
                            alert-secondary
                            mt-3
                            mb-0
                            d-none"
                     role="status"
                     aria-live="polite">

                    Completing the audit and closing the controlled
                    browser...

                </div>

            </form>

        </div>

    </section>
}


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />


    <!-- =====================================================
         Start / stop progress
         ===================================================== -->

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const startForm =
                    document.getElementById(
                        "authenticatedAuditStartForm");

                const startProgress =
                    document.getElementById(
                        "authenticatedAuditStartProgress");

                const startButton =
                    document.getElementById(
                        "authenticatedAuditStartButton");

                if (startForm && startProgress) {
                    startForm.addEventListener(
                        "submit",
                        function () {

                            startProgress.classList.remove(
                                "d-none");

                            if (startButton) {
                                window.setTimeout(
                                    function () {
                                        startButton.disabled = true;
                                    },
                                    0);
                            }
                        });
                }


                const stopForm =
                    document.getElementById(
                        "authenticatedAuditStopForm");

                const stopProgress =
                    document.getElementById(
                        "authenticatedAuditStopProgress");

                const stopButton =
                    document.getElementById(
                        "authenticatedAuditStopButton");

                if (stopForm && stopProgress) {
                    stopForm.addEventListener(
                        "submit",
                        function () {

                            stopProgress.classList.remove(
                                "d-none");

                            if (stopButton) {
                                window.setTimeout(
                                    function () {
                                        stopButton.disabled = true;
                                    },
                                    0);
                            }
                        });
                }
            });
    </script>


    <!-- =====================================================
         Authenticated batch UI
         ===================================================== -->

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const form =
                    document.getElementById(
                        "authenticatedBatchForm");

                const button =
                    document.getElementById(
                        "authenticatedBatchButton");

                const buttonText =
                    document.getElementById(
                        "authenticatedBatchButtonText");

                const spinner =
                    document.getElementById(
                        "authenticatedBatchSpinner");

                const progress =
                    document.getElementById(
                        "authenticatedBatchProgress");

                const urlsTextarea =
                    document.getElementById(
                        "authenticatedBatchUrls");

                const expectedCountInput =
                    document.getElementById(
                        "authenticatedBatchExpectedCount");

                const urlStatus =
                    document.getElementById(
                        "authenticatedBatchUrlStatus");

                const domainWarning =
                    document.getElementById(
                        "authenticatedBatchDomainWarning");


                function updateAuthenticatedBatchDomainWarning(
                    urls) {

                    if (!form || !domainWarning) {
                        return;
                    }

                    domainWarning.classList.add(
                        "d-none");

                    domainWarning.textContent = "";

                    const startingUrlValue =
                        form.dataset.startingUrl;

                    if (!startingUrlValue ||
                        urls.length === 0) {
                        return;
                    }

                    let startingHost;

                    try {
                        startingHost =
                            new URL(
                                startingUrlValue)
                                .hostname
                                .toLowerCase();
                    }
                    catch {
                        return;
                    }

                    const differentHosts =
                        new Set();

                    urls.forEach(
                        function (url) {

                            try {
                                const currentHost =
                                    new URL(url)
                                        .hostname
                                        .toLowerCase();

                                if (currentHost !==
                                    startingHost) {

                                    differentHosts.add(
                                        currentHost);
                                }
                            }
                            catch {
                            }
                        });

                    if (differentHosts.size === 0) {
                        return;
                    }

                    domainWarning.textContent =
                        "Authentication warning: this batch contains " +
                        "URL(s) from a different domain than the " +
                        "starting application: " +
                        Array.from(
                            differentHosts)
                            .join(", ") +
                        ".";

                    domainWarning.classList.remove(
                        "d-none");
                }


                function updateAuthenticatedBatchStatus() {

                    if (!expectedCountInput ||
                        !urlsTextarea ||
                        !urlStatus) {
                        return;
                    }

                    const urls =
                        urlsTextarea.value
                            .split(/\r?\n/)
                            .map(
                                function (url) {
                                    return url.trim();
                                })
                            .filter(
                                function (url) {
                                    return url.length > 0;
                                });

                    updateAuthenticatedBatchDomainWarning(
                        urls);

                    const expectedCount =
                        Number.parseInt(
                            expectedCountInput.value,
                            10);

                    const invalidLineNumbers = [];
                    const duplicateLineNumbers = [];
                    const previouslySeenUrls =
                        new Set();


                    urls.forEach(
                        function (url, index) {

                            let validUrl = false;

                            try {
                                const parsedUrl =
                                    new URL(url);

                                validUrl =
                                    parsedUrl.protocol ===
                                        "http:" ||
                                    parsedUrl.protocol ===
                                        "https:";
                            }
                            catch {
                                validUrl = false;
                            }


                            if (!validUrl) {
                                invalidLineNumbers.push(
                                    index + 1);
                            }


                            const duplicateKey =
                                url.toLowerCase();

                            if (previouslySeenUrls.has(
                                duplicateKey)) {

                                duplicateLineNumbers.push(
                                    index + 1);
                            }
                            else {
                                previouslySeenUrls.add(
                                    duplicateKey);
                            }
                        });


                    urlStatus.classList.remove(
                        "alert-secondary",
                        "alert-info",
                        "alert-success",
                        "alert-warning",
                        "alert-danger");


                    if (urls.length === 0) {

                        urlStatus.classList.add(
                            "alert-secondary");

                        urlStatus.textContent =
                            "No protected URLs detected yet.";

                        return;
                    }


                    if (invalidLineNumbers.length > 0) {

                        urlStatus.classList.add(
                            "alert-danger");

                        urlStatus.textContent =
                            urls.length +
                            " non-empty URL(s) detected. " +
                            "Invalid URL line(s): " +
                            invalidLineNumbers.join(", ") +
                            ".";

                        return;
                    }


                    if (Number.isInteger(
                            expectedCount) &&
                        expectedCount !==
                            urls.length) {

                        urlStatus.classList.add(
                            "alert-warning");

                        urlStatus.textContent =
                            urls.length +
                            " non-empty URL(s) detected, but Number " +
                            "of URLs is " +
                            expectedCount +
                            ".";

                        return;
                    }


                    if (duplicateLineNumbers.length > 0) {

                        urlStatus.classList.add(
                            "alert-warning");

                        urlStatus.textContent =
                            urls.length +
                            " valid URL(s) detected. Duplicate URL " +
                            "line(s): " +
                            duplicateLineNumbers.join(", ") +
                            ".";

                        return;
                    }


                    if (!Number.isInteger(
                        expectedCount)) {

                        urlStatus.classList.add(
                            "alert-info");

                        urlStatus.textContent =
                            urls.length +
                            " valid URL(s) detected. Enter the same " +
                            "number above.";

                        return;
                    }


                    urlStatus.classList.add(
                        "alert-success");

                    urlStatus.textContent =
                        urls.length +
                        " valid URL(s) detected. The batch is ready " +
                        "to run.";
                }


                if (expectedCountInput &&
                    urlsTextarea) {

                    expectedCountInput.addEventListener(
                        "input",
                        updateAuthenticatedBatchStatus);

                    urlsTextarea.addEventListener(
                        "input",
                        updateAuthenticatedBatchStatus);

                    updateAuthenticatedBatchStatus();
                }


                if (form && button) {

                    let submitted = false;

                    form.addEventListener(
                        "submit",
                        function (event) {

                            if (submitted) {
                                event.preventDefault();
                                return;
                            }

                            submitted = true;

                            if (buttonText) {
                                buttonText.textContent =
                                    "Scanning Protected URLs";
                            }

                            if (spinner) {
                                spinner.classList.remove(
                                    "d-none");
                            }

                            if (progress) {
                                progress.classList.remove(
                                    "d-none");
                            }

                            window.setTimeout(
                                function () {
                                    button.disabled = true;
                                },
                                0);
                        });
                }


                const attentionFilterButton =
                    document.getElementById(
                        "authenticatedBatchAttentionFilterButton");

                const batchResultRows =
                    document.querySelectorAll(
                        "#authenticatedBatchResultsBody " +
                        "tr[data-attention]");


                if (attentionFilterButton &&
                    batchResultRows.length > 0) {

                    let showingAttentionOnly =
                        false;

                    attentionFilterButton.addEventListener(
                        "click",
                        function () {

                            showingAttentionOnly =
                                !showingAttentionOnly;

                            batchResultRows.forEach(
                                function (row) {

                                    const requiresAttention =
                                        row.dataset.attention ===
                                        "true";

                                    row.classList.toggle(
                                        "d-none",
                                        showingAttentionOnly &&
                                        !requiresAttention);
                                });


                            if (showingAttentionOnly) {

                                attentionFilterButton.textContent =
                                    "Show All Results";

                                attentionFilterButton.classList.remove(
                                    "btn-outline-secondary");

                                attentionFilterButton.classList.add(
                                    "btn-secondary");
                            }
                            else {

                                attentionFilterButton.textContent =
                                    "Show Attention Only";

                                attentionFilterButton.classList.remove(
                                    "btn-secondary");

                                attentionFilterButton.classList.add(
                                    "btn-outline-secondary");
                            }
                        });
                }
            });
    </script>


    <!-- =====================================================
         Scan Current State progress
         ===================================================== -->

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const scanForm =
                    document.getElementById(
                        "authenticatedAuditScanForm");

                if (!scanForm) {
                    return;
                }


                const progressPanel =
                    document.getElementById(
                        "authenticatedAuditProgressPanel");

                const scanProgress =
                    document.getElementById(
                        "authenticatedAuditScanProgress");

                const currentUrlElement =
                    document.getElementById(
                        "authenticatedAuditCurrentUrl");

                const currentStepElement =
                    document.getElementById(
                        "authenticatedAuditCurrentStep");

                const currentStageElement =
                    document.getElementById(
                        "authenticatedAuditCurrentStage");

                const progressBar =
                    document.getElementById(
                        "authenticatedAuditProgressBar");

                const submitButton =
                    document.getElementById(
                        "authenticatedAuditScanButton");

                const spinner =
                    document.getElementById(
                        "authenticatedAuditScanSpinner");

                const buttonText =
                    document.getElementById(
                        "authenticatedAuditScanButtonText");


                let progressTimer = null;


                function updateAuthenticatedAuditProgress(
                    progress) {

                    if (!currentUrlElement ||
                        !currentStepElement ||
                        !currentStageElement ||
                        !progressBar) {
                        return;
                    }

                    const stagePercent =
                        Math.max(
                            0,
                            Math.min(
                                Number(
                                    progress.stagePercent) ||
                                0,
                                100));


                    currentUrlElement.textContent =
                        progress.currentUrl ||
                        "Preparing page...";

                    currentStepElement.textContent =
                        progress.currentPageNumber > 0
                            ? progress.currentPageNumber
                            : "—";

                    currentStageElement.textContent =
                        progress.stage ||
                        "Preparing scan";

                    progressBar.style.width =
                        `${stagePercent}%`;

                    progressBar.textContent =
                        `${stagePercent}%`;

                    progressBar.setAttribute(
                        "aria-valuenow",
                        stagePercent);
                }


                async function loadAuthenticatedAuditProgress(
                    sessionId) {

                    try {

                        const progressUrl =
                            "@Url.Action(
                                "Progress",
                                "AuthenticatedAudits")" +
                            `?sessionId=${
                                encodeURIComponent(
                                    sessionId)}`;


                        const response =
                            await fetch(
                                progressUrl,
                                {
                                    cache: "no-store",
                                    credentials: "same-origin"
                                });


                        if (!response.ok) {
                            return;
                        }


                        const progress =
                            await response.json();


                        updateAuthenticatedAuditProgress(
                            progress);
                    }
                    catch {
                    }
                }


                scanForm.addEventListener(
                    "submit",
                    async function (event) {

                        event.preventDefault();


                        const sessionInput =
                            scanForm.querySelector(
                                '[name="SessionId"]');

                        const sessionId =
                            sessionInput?.value;


                        if (!sessionId) {
                            scanForm.submit();
                            return;
                        }


                        if (progressPanel) {
                            progressPanel.classList.remove(
                                "d-none");
                        }

                        if (scanProgress) {
                            scanProgress.classList.remove(
                                "d-none");
                        }

                        if (spinner) {
                            spinner.classList.remove(
                                "d-none");
                        }

                        if (buttonText) {
                            buttonText.textContent =
                                "Scanning Current Step";
                        }

                        if (submitButton) {
                            submitButton.disabled = true;
                        }


                        updateAuthenticatedAuditProgress({
                            stage: "Opening page",
                            stagePercent: 10,
                            currentUrl: null,
                            currentPageNumber: 0
                        });


                        progressTimer =
                            window.setInterval(
                                function () {
                                    loadAuthenticatedAuditProgress(
                                        sessionId);
                                },
                                250);


                        await loadAuthenticatedAuditProgress(
                            sessionId);


                        try {

                            const response =
                                await fetch(
                                    scanForm.action,
                                    {
                                        method: "POST",
                                        body: new FormData(
                                            scanForm),
                                        credentials: "same-origin"
                                    });


                            window.clearInterval(
                                progressTimer);


                            await loadAuthenticatedAuditProgress(
                                sessionId);


                            window.location.href =
                                response.url ||
                                "@Url.Action(
                                    "Index",
                                    "AuthenticatedAudits")";
                        }
                        catch {

                            window.clearInterval(
                                progressTimer);


                            if (submitButton) {
                                submitButton.disabled = false;
                            }

                            if (spinner) {
                                spinner.classList.add(
                                    "d-none");
                            }

                            if (currentStageElement) {
                                currentStageElement.textContent =
                                    "The scan request could not be completed.";
                            }

                            if (progressBar) {
                                progressBar.classList.remove(
                                    "progress-bar-animated");
                            }
                        }
                    });
            });
    </script>


