                            <!-- =================================
                                 Needs manual review
                                 ================================= -->

                            @if (needsReviewFindings.Count > 0)
                            {
                                <section aria-labelledby="review-step-@step.StepNumber">

                                    <div class="d-flex
                                                flex-wrap
                                                justify-content-between
                                                align-items-end
                                                gap-2
                                                mb-3">

                                        <div>

                                            <h4 id="review-step-@step.StepNumber"
                                                class="h5 mb-1">
                                                Needs Manual Review
                                            </h4>

                                            <p class="small
                                                      text-muted
                                                      mb-0">
                                                Findings requiring
                                                additional evaluation.
                                            </p>

                                        </div>


                                        <span class="badge
                                                     text-bg-warning">
                                            @needsReviewFindings.Count
                                        </span>

                                    </div>


                                    <div class="d-flex
                                                flex-column
                                                gap-3">

                                        @foreach (var finding
                                            in needsReviewFindings)
                                        {
                                            string impactBadgeClass =
                                                finding.Impact?
                                                    .ToLowerInvariant()
                                                switch
                                                {
                                                    "critical" =>
                                                        "text-bg-danger",

                                                    "serious" =>
                                                        "text-bg-danger",

                                                    "moderate" =>
                                                        "text-bg-warning",

                                                    "minor" =>
                                                        "text-bg-info",

                                                    _ =>
                                                        "text-bg-secondary"
                                                };


                                            bool isFixFirst =
                                                (
                                                    string.Equals(
                                                        finding.Impact,
                                                        "critical",
                                                        StringComparison.OrdinalIgnoreCase) ||

                                                    string.Equals(
                                                        finding.Impact,
                                                        "serious",
                                                        StringComparison.OrdinalIgnoreCase)
                                                ) &&
                                                (
                                                    string.Equals(
                                                        finding.WcagLevel,
                                                        "A",
                                                        StringComparison.OrdinalIgnoreCase) ||

                                                    string.Equals(
                                                        finding.WcagLevel,
                                                        "AA",
                                                        StringComparison.OrdinalIgnoreCase)
                                                );


                                            <article class="border
                                                            border-warning
                                                            rounded
                                                            overflow-hidden">

                                                <div class="p-3">

                                                    <div class="d-flex
                                                                flex-wrap
                                                                justify-content-between
                                                                align-items-start
                                                                gap-3">

                                                        <div style="max-width: 800px;">

                                                            <div class="small
                                                                        text-muted
                                                                        mb-1">
                                                                @finding.RuleId
                                                            </div>


                                                            <h5 class="h6 mb-1">

                                                                @(string.IsNullOrWhiteSpace(
                                                                    finding.Help)
                                                                    ? finding.RuleId
                                                                    : finding.Help)

                                                            </h5>


                                                            @if (!string.IsNullOrWhiteSpace(
                                                                finding.Description))
                                                            {
                                                                <p class="small
                                                                          text-muted
                                                                          mb-0">
                                                                    @finding.Description
                                                                </p>
                                                            }

                                                        </div>


                                                        <div class="d-flex
                                                                    flex-wrap
                                                                    gap-2">

                                                            @if (isFixFirst)
                                                            {
                                                                <span class="badge
                                                                             text-bg-danger">
                                                                    Fix First
                                                                </span>
                                                            }


                                                            <span class="badge
                                                                         @impactBadgeClass">

                                                                @(string.IsNullOrWhiteSpace(
                                                                    finding.Impact)
                                                                    ? "Unknown"
                                                                    : finding.Impact)

                                                            </span>


                                                            @if (!string.IsNullOrWhiteSpace(
                                                                finding.WcagLevel))
                                                            {
                                                                <span class="badge
                                                                             text-bg-primary">
                                                                    WCAG
                                                                    @finding.WcagLevel
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge
                                                                             text-bg-secondary">
                                                                    Other / Best Practice
                                                                </span>
                                                            }


                                                            <span class="badge
                                                                         text-bg-dark">
                                                                @finding.AffectedElementCount
                                                                affected
                                                            </span>

                                                        </div>

                                                    </div>


                                                    @if (!string.IsNullOrWhiteSpace(
                                                        finding.WcagTags))
                                                    {
                                                        <div class="small
                                                                    text-muted
                                                                    mt-3">

                                                            <strong>
                                                                WCAG tags:
                                                            </strong>

                                                            @finding.WcagTags

                                                        </div>
                                                    }


                                                    <div class="d-flex
                                                                flex-wrap
                                                                gap-2
                                                                mt-3">

                                                        @if (!string.IsNullOrWhiteSpace(
                                                            finding.HelpUrl))
                                                        {
                                                            <a href="@finding.HelpUrl"
                                                               target="_blank"
                                                               rel="noopener noreferrer"
                                                               class="btn
                                                                      btn-sm
                                                                      btn-outline-primary">

                                                                Rule Guidance

                                                                <span class="visually-hidden">
                                                                    opens in a new tab
                                                                </span>

                                                            </a>
                                                        }


                                                        @if (finding.RemediationItemId.HasValue)
