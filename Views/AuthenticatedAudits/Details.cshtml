                                                                      btn-sm
                                                                      btn-success">

                                                                View Remediation

                                                                @if (!string.IsNullOrWhiteSpace(
                                                                    finding.RemediationStatus))
                                                                {
                                                                    <span>
                                                                        ·
                                                                        @finding.RemediationStatus
                                                                    </span>
                                                                }

                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <form asp-controller="AccessibilityRemediations"
                                                                  asp-action="Start"
                                                                  method="post"
                                                                  class="d-inline">

                                                                @Html.AntiForgeryToken()

                                                                <input type="hidden"
                                                                       name="findingId"
                                                                       value="@finding.Id" />

                                                                <input type="hidden"
                                                                       name="auditRunId"
                                                                       value="@Model.Id" />

                                                                <button type="submit"
                                                                        class="btn
                                                                               btn-sm
                                                                               btn-success">
                                                                    Start Remediation
                                                                </button>

                                                            </form>
                                                        }

                                                    </div>


                                                    @if (finding.Nodes.Count > 0)
                                                    {
                                                        <details class="border-top
                                                                        mt-3
                                                                        pt-3">

                                                            <summary class="fw-semibold">
                                                                Technical Affected Elements
                                                                (@finding.Nodes.Count)
                                                            </summary>


                                                            <div class="mt-3">

                                                                @for (
                                                                    int nodeIndex = 0;
                                                                    nodeIndex < finding.Nodes.Count;
                                                                    nodeIndex++)
                                                                {
                                                                    var node =
                                                                        finding.Nodes[nodeIndex];


                                                                    <div class="border
                                                                                rounded
                                                                                p-3
                                                                                mb-3">

                                                                        <h6 class="mb-3">
                                                                            Affected Element
                                                                            @(nodeIndex + 1)
                                                                        </h6>


                                                                        <div class="mb-3">

                                                                            <div class="small
                                                                                        fw-semibold
                                                                                        mb-1">
                                                                                CSS Selector / Target
                                                                            </div>

                                                                            <code class="d-block
                                                                                         border
                                                                                         rounded
                                                                                         bg-light
                                                                                         p-2
                                                                                         text-break">

                                                                                @(string.IsNullOrWhiteSpace(
                                                                                    node.Target)
                                                                                    ? "Target not available"
                                                                                    : node.Target)

                                                                            </code>

                                                                        </div>


                                                                        @if (!string.IsNullOrWhiteSpace(
                                                                            node.FailureSummary))
                                                                        {
                                                                            <div class="mb-3">

                                                                                <div class="small
                                                                                            fw-semibold
                                                                                            mb-1">
                                                                                    Why This Element Failed
                                                                                </div>

                                                                                <div class="border
                                                                                            rounded
                                                                                            p-2"
                                                                                     style="white-space: pre-line;">
                                                                                    @node.FailureSummary
                                                                                </div>

                                                                            </div>
                                                                        }


                                                                        @if (!string.IsNullOrWhiteSpace(
                                                                            node.ElementFixGuidance))
                                                                        {
                                                                            <div class="alert
                                                                                        alert-success
                                                                                        mb-3">

                                                                                <div class="fw-semibold
                                                                                            mb-1">
                                                                                    Element Fix Guidance
                                                                                </div>

                                                                                <div style="white-space: pre-line;">
                                                                                    @node.ElementFixGuidance
                                                                                </div>

                                                                            </div>
                                                                        }


                                                                        @if (!string.IsNullOrWhiteSpace(
                                                                            node.Html))
                                                                        {
                                                                            <div>

                                                                                <div class="small
                                                                                            fw-semibold
                                                                                            mb-1">
                                                                                    HTML Snippet
                                                                                </div>

                                                                                <pre class="border
                                                                                            rounded
                                                                                            bg-light
                                                                                            p-2
                                                                                            mb-0
                                                                                            text-wrap"><code>@node.Html</code></pre>

                                                                            </div>
                                                                        }

                                                                    </div>
                                                                }

                                                            </div>

                                                        </details>
                                                    }

                                                </div>

                                            </article>
                                        }

                                    </div>

                                </section>
                            }
                        }

                    </div>

                </article>
            }

        </div>
    }

</section>
