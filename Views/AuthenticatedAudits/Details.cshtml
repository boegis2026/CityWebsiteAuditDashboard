@model CityWebsiteAuditDashboard.ViewModels.AuthenticatedAuditDetailsViewModel

@{
    ViewData["Title"] =
        $"Authenticated Audit Run #{Model.Id}";

    string statusBadgeClass =
        Model.Status switch
        {
            "Completed" =>
                "text-bg-success",

            "Running" =>
                "text-bg-primary",

            "Failed" =>
                "text-bg-danger",

            "Cancelled" =>
                "text-bg-warning",

            "Interrupted" =>
                "text-bg-warning",

            _ =>
                "text-bg-secondary"
        };


    var allAuditFindings =
        Model.Steps
            .SelectMany(step =>
                step.Findings)
            .ToList();


    int criticalFindingCount =
        allAuditFindings.Count(finding =>
            string.Equals(
                finding.Impact,
                "critical",
                StringComparison.OrdinalIgnoreCase));


    int seriousFindingCount =
        allAuditFindings.Count(finding =>
            string.Equals(
                finding.Impact,
                "serious",
                StringComparison.OrdinalIgnoreCase));


    int moderateFindingCount =
        allAuditFindings.Count(finding =>
            string.Equals(
                finding.Impact,
                "moderate",
                StringComparison.OrdinalIgnoreCase));


    int minorFindingCount =
        allAuditFindings.Count(finding =>
            string.Equals(
                finding.Impact,
                "minor",
                StringComparison.OrdinalIgnoreCase));


    int wcagLevelACount =
        allAuditFindings.Count(finding =>
            string.Equals(
                finding.WcagLevel,
                "A",
                StringComparison.OrdinalIgnoreCase));


    int wcagLevelAaCount =
        allAuditFindings.Count(finding =>
            string.Equals(
                finding.WcagLevel,
                "AA",
                StringComparison.OrdinalIgnoreCase));


    int otherFindingCount =
        allAuditFindings.Count(finding =>
            string.IsNullOrWhiteSpace(
                finding.WcagLevel));


    int violationFindingCount =
        allAuditFindings.Count(finding =>
            string.Equals(
                finding.FindingType,
                "Violation",
                StringComparison.OrdinalIgnoreCase));


    int needsReviewFindingCount =
        allAuditFindings.Count(finding =>
            string.Equals(
                finding.FindingType,
                "NeedsReview",
                StringComparison.OrdinalIgnoreCase));


    int fixFirstFindingCount =
        allAuditFindings.Count(finding =>
            (
                string.Equals(
                    finding.Impact,
                    "critical",
                    StringComparison.OrdinalIgnoreCase) ||

                string.Equals(
                    finding.Impact,
                    "serious",
                    StringComparison.OrdinalIgnoreCase)
            ) &&
            (
                string.Equals(
                    finding.WcagLevel,
                    "A",
                    StringComparison.OrdinalIgnoreCase) ||

                string.Equals(
                    finding.WcagLevel,
                    "AA",
                    StringComparison.OrdinalIgnoreCase)
            ));


    int trackedFindingCount =
        allAuditFindings.Count(finding =>
            finding.RemediationItemId.HasValue);
}


<!-- =========================================================
     Page heading
     ========================================================= -->

<header class="mb-4">

    <div class="d-flex
                flex-wrap
                justify-content-between
                align-items-start
                gap-3">

        <div>

            <div class="small
                        fw-bold
                        text-uppercase
                        text-muted
                        mb-2"
                 style="letter-spacing: 0.06em;">
                Authenticated Accessibility Audit
            </div>


            <div class="d-flex
                        flex-wrap
                        align-items-center
                        gap-2
                        mb-2">

                <h1 class="h2 mb-0">
                    @Model.ApplicationName
                </h1>

                <span class="badge @statusBadgeClass">
                    @Model.Status
                </span>

            </div>


            <p class="text-muted mb-0">
                Audit Run #@Model.Id ·
                @Model.Steps.Count rendered
                state@(Model.Steps.Count == 1 ? "" : "s") scanned
            </p>

        </div>


        <div class="d-flex
                    flex-wrap
                    gap-2">

            <a asp-controller="AuthenticatedAudits"
               asp-action="History"
               class="btn btn-outline-secondary">
                Back to History
            </a>

            <a asp-action="DownloadPdf"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Download PDF
            </a>

            <a asp-controller="AuthenticatedAudits"
               asp-action="Index"
               class="btn btn-outline-primary">
                Start New Audit
            </a>

        </div>

    </div>

</header>


@if (!string.IsNullOrWhiteSpace(
    Model.ErrorMessage))
{
    <div class="alert alert-danger mb-4">

        <strong>
            Run error:
        </strong>

        @Model.ErrorMessage

    </div>
}


<!-- =========================================================
     Primary audit summary
     ========================================================= -->

<section aria-labelledby="audit-summary-heading"
         class="mb-4">

    <div class="mb-3">

        <h2 id="audit-summary-heading"
            class="h3 mb-1">
            Audit Summary
        </h2>

        <p class="text-muted mb-0">
            Key results from this authenticated workflow audit.
        </p>

    </div>


    <div class="row g-3">

        <div class="col-12 col-sm-6 col-xl-3">

            <article class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="dashboard-card-label">
                        States Scanned
                    </div>

                    <div class="dashboard-card-value">
                        @Model.Steps.Count
                    </div>

                    <div class="small text-muted">
                        @Model.SuccessfulStepCount successful,
                        @Model.FailedStepCount failed
                    </div>

                </div>

            </article>

        </div>


        <div class="col-12 col-sm-6 col-xl-3">

            <article class="card
                            shadow-sm
                            h-100
                            border-start
                            border-danger
                            border-4">

                <div class="card-body">

                    <div class="dashboard-card-label">
                        Fix First
                    </div>

                    <div class="dashboard-card-value text-danger">
                        @fixFirstFindingCount
                    </div>

                    <div class="small text-muted">
                        Critical or serious A/AA findings
                    </div>

                </div>

            </article>

        </div>


        <div class="col-12 col-sm-6 col-xl-3">

            <article class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="dashboard-card-label">
                        Violations
                    </div>

                    <div class="dashboard-card-value">
                        @violationFindingCount
                    </div>

                    <div class="small text-muted">
                        Saved rule-level violations
                    </div>

                </div>

            </article>

        </div>


        <div class="col-12 col-sm-6 col-xl-3">

            <article class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="dashboard-card-label">
                        Affected Elements
                    </div>

                    <div class="dashboard-card-value">
                        @Model.TotalAffectedElementCount
                    </div>

                    <div class="small text-muted">
                        Element occurrences across scanned states
                    </div>

                </div>

            </article>

        </div>

    </div>

</section>


<!-- =========================================================
     Priority breakdown
     ========================================================= -->

<section aria-labelledby="priority-summary-heading"
         class="card shadow-sm mb-4">

    <div class="card-header">

        <div class="d-flex
                    flex-wrap
                    justify-content-between
                    align-items-center
                    gap-2">

            <div>

                <h2 id="priority-summary-heading"
                    class="h5 mb-1">
                    Finding Priority
                </h2>

                <p class="small text-muted mb-0">
                    Severity, review, WCAG, and remediation summary.
                </p>

            </div>

            <span class="badge text-bg-light border">
                @trackedFindingCount tracked for remediation
            </span>

        </div>

    </div>


    <div class="card-body">

        <div class="row
                    row-cols-2
                    row-cols-md-4
                    g-3">

            <div class="col">

                <div class="border rounded p-3 h-100">

                    <div class="dashboard-card-label">
                        Critical
                    </div>

                    <div class="fs-3 fw-bold text-danger">
                        @criticalFindingCount
                    </div>

                </div>

            </div>


            <div class="col">

                <div class="border rounded p-3 h-100">

                    <div class="dashboard-card-label">
                        Serious
                    </div>

                    <div class="fs-3 fw-bold">
                        @seriousFindingCount
                    </div>

                </div>

            </div>


            <div class="col">

                <div class="border rounded p-3 h-100">

                    <div class="dashboard-card-label">
                        Moderate
                    </div>

                    <div class="fs-3 fw-bold">
                        @moderateFindingCount
                    </div>

                </div>

            </div>


            <div class="col">

                <div class="border rounded p-3 h-100">

                    <div class="dashboard-card-label">
                        Minor
                    </div>

                    <div class="fs-3 fw-bold">
                        @minorFindingCount
                    </div>

                </div>

            </div>


            <div class="col">

                <div class="border rounded p-3 h-100">

                    <div class="dashboard-card-label">
                        Needs Review
                    </div>

                    <div class="fs-3 fw-bold">
                        @needsReviewFindingCount
                    </div>

                </div>

            </div>


            <div class="col">

                <div class="border rounded p-3 h-100">

                    <div class="dashboard-card-label">
                        WCAG Level A
                    </div>

                    <div class="fs-3 fw-bold">
                        @wcagLevelACount
                    </div>

                </div>

            </div>


            <div class="col">

                <div class="border rounded p-3 h-100">

                    <div class="dashboard-card-label">
                        WCAG Level AA
                    </div>

                    <div class="fs-3 fw-bold">
                        @wcagLevelAaCount
                    </div>

                </div>

            </div>


            <div class="col">

                <div class="border rounded p-3 h-100">

                    <div class="dashboard-card-label">
                        Other / Best Practice
                    </div>

                    <div class="fs-3 fw-bold">
                        @otherFindingCount
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     Run information
     ========================================================= -->

<section aria-labelledby="run-information-heading"
         class="card shadow-sm mb-4">

    <div class="card-header">

        <h2 id="run-information-heading"
            class="h5 mb-0">
            Run Information
        </h2>

    </div>


    <div class="card-body">

        <dl class="row mb-0">

            <dt class="col-md-3">
                Application
            </dt>

            <dd class="col-md-9">
                @Model.ApplicationName
            </dd>


            <dt class="col-md-3">
                Starting URL
            </dt>

            <dd class="col-md-9 text-break">
                @Model.StartingUrl
            </dd>


            <dt class="col-md-3">
                Accessibility Engine
            </dt>

            <dd class="col-md-9">
                @Model.AccessibilityEngine
            </dd>


            <dt class="col-md-3">
                Started
            </dt>

            <dd class="col-md-9">

                @Model.StartedAt.ToString(
                    "MMM d, yyyy h:mm tt")

                <span class="text-muted">
                    UTC
                </span>

            </dd>


            <dt class="col-md-3">
                Completed
            </dt>

            <dd class="col-md-9">

                @if (Model.CompletedAt.HasValue)
                {
                    @Model.CompletedAt.Value.ToString(
                        "MMM d, yyyy h:mm tt")

                    <span class="text-muted">
                        UTC
                    </span>
                }
                else
                {
                    <span class="text-muted">
                        Not completed
                    </span>
                }

            </dd>

        </dl>

    </div>

</section>


<!-- =========================================================
     Workflow states
     ========================================================= -->

<section aria-labelledby="workflow-results-heading"
         class="mb-4">

    <div class="mb-3">

        <h2 id="workflow-results-heading"
            class="h3 mb-1">
            Workflow State Results
        </h2>

        <p class="text-muted mb-0">
            Accessibility results for each rendered state captured
            during the audit.
        </p>

    </div>


    @if (Model.Steps.Count == 0)
    {
        <div class="card shadow-sm">

            <div class="card-body py-4">

                <p class="text-muted mb-0">
                    No rendered states were scanned during this audit.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="d-flex
                    flex-column
                    gap-4">

            @foreach (var step
                in Model.Steps
                    .OrderBy(step =>
                        step.StepNumber))
            {
                string stepBorderClass =
                    step.ScanSucceeded
                        ? "border-success"
                        : "border-danger";


                var violationFindings =
                    step.Findings
                        .Where(finding =>
                            string.Equals(
                                finding.FindingType,
                                "Violation",
                                StringComparison.OrdinalIgnoreCase))
                        .OrderBy(finding =>
                            finding.PriorityRank)
                        .ThenBy(finding =>
                            finding.RuleId)
                        .ToList();


                var needsReviewFindings =
                    step.Findings
                        .Where(finding =>
                            string.Equals(
                                finding.FindingType,
                                "NeedsReview",
                                StringComparison.OrdinalIgnoreCase))
                        .OrderBy(finding =>
                            finding.PriorityRank)
                        .ThenBy(finding =>
                            finding.RuleId)
                        .ToList();


                <article class="card
                                shadow-sm
                                @stepBorderClass">

                    <!-- =========================================
                         State header
                         ========================================= -->

                    <div class="card-header">

                        <div class="d-flex
                                    flex-wrap
                                    justify-content-between
                                    align-items-start
                                    gap-3">

                            <div>

                                <div class="small
                                            fw-bold
                                            text-uppercase
                                            text-muted
                                            mb-1"
                                     style="letter-spacing: 0.05em;">
                                    Workflow State @step.StepNumber
                                </div>

                                <h3 class="h5 mb-1">
                                    @step.StepName
                                </h3>

                                @if (!string.IsNullOrWhiteSpace(
                                    step.PageTitle))
                                {
                                    <div class="small text-muted">
                                        @step.PageTitle
                                    </div>
                                }

                            </div>


                            <div class="d-flex
                                        flex-wrap
                                        gap-2">

                                @if (step.WasFinalStep)
                                {
                                    <span class="badge text-bg-dark">
                                        Final Scanned State
                                    </span>
                                }

                                @if (step.ScanSucceeded)
                                {
                                    <span class="badge text-bg-success">
                                        Scan Succeeded
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-danger">
                                        Scan Failed
                                    </span>
                                }

                            </div>

                        </div>

                    </div>


                    <div class="card-body">

                        <!-- =====================================
                             State result summary
                             ===================================== -->

                        <div class="row
                                    row-cols-2
                                    row-cols-md-4
                                    g-3
                                    mb-4">

                            <div class="col">

                                <div class="border
                                            rounded
                                            p-3
                                            text-center
                                            h-100">

                                    <div class="fs-3 fw-bold">
                                        @step.ViolationRuleCount
                                    </div>

                                    <div class="small text-muted">
                                        Violations
                                    </div>

                                </div>

                            </div>


                            <div class="col">

                                <div class="border
                                            rounded
                                            p-3
                                            text-center
                                            h-100">

                                    <div class="fs-3 fw-bold">
                                        @step.AffectedElementCount
                                    </div>

                                    <div class="small text-muted">
                                        Affected Elements
                                    </div>

                                </div>

                            </div>


                            <div class="col">

                                <div class="border
                                            rounded
                                            p-3
                                            text-center
                                            h-100">

                                    <div class="fs-3 fw-bold">
                                        @step.NeedsReviewRuleCount
                                    </div>

                                    <div class="small text-muted">
                                        Needs Review
                                    </div>

                                </div>

                            </div>


                            <div class="col">

                                <div class="border
                                            rounded
                                            p-3
                                            text-center
                                            h-100">

                                    <div class="fs-3 fw-bold text-success">
                                        @step.PassedRuleCount
                                    </div>

                                    <div class="small text-muted">
                                        Passed Rules
                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- =====================================
                             Technical state information
                             ===================================== -->

                        <details class="border
                                        rounded
                                        p-3
                                        mb-4">

                            <summary class="fw-semibold">
                                Technical State Details
                            </summary>


                            <div class="mt-3">

                                <dl class="row mb-0">

                                    <dt class="col-md-3">
                                        Current URL
                                    </dt>

                                    <dd class="col-md-9 text-break">
                                        @step.Url
                                    </dd>


                                    <dt class="col-md-3">
                                        Main Heading
                                    </dt>

                                    <dd class="col-md-9">
                                        @(step.Heading ??
                                            "Not detected")
                                    </dd>


                                    <dt class="col-md-3">
                                        Scanned
                                    </dt>

                                    <dd class="col-md-9">

                                        @step.ScannedAt.ToString(
                                            "MMM d, yyyy h:mm:ss tt")

                                        <span class="text-muted">
                                            UTC
                                        </span>

                                    </dd>


                                    <dt class="col-md-3">
                                        DOM Fingerprint
                                    </dt>

                                    <dd class="col-md-9">

                                        <code class="text-break">
                                            @(step.DomFingerprint ??
                                                "Not generated")
                                        </code>

                                    </dd>


                                    <dt class="col-md-3">
                                        Visible Forms
                                    </dt>

                                    <dd class="col-md-9">
                                        @step.VisibleFormCount
                                    </dd>


                                    <dt class="col-md-3">
                                        Visible Fields
                                    </dt>

                                    <dd class="col-md-9">
                                        @step.VisibleFieldCount
                                    </dd>


                                    <dt class="col-md-3">
                                        Visible Buttons
                                    </dt>

                                    <dd class="col-md-9">
                                        @step.VisibleButtonCount
                                    </dd>

                                </dl>

                            </div>

                        </details>


                        @if (!string.IsNullOrWhiteSpace(
                            step.ErrorMessage))
                        {
                            <div class="alert alert-danger mb-4">

                                <strong>
                                    Step error:
                                </strong>

                                @step.ErrorMessage

                            </div>
                        }


                        <!-- =====================================
                             No saved findings
                             ===================================== -->

                        @if (step.Findings.Count == 0)
                        {
                            <div class="alert
                                        alert-light
                                        border
                                        mb-0">

                                No rule-level violations or
                                needs-review findings were saved for
                                this rendered state.

                                @if (step.ScanSucceeded &&
                                     (
                                         step.ViolationRuleCount > 0 ||
                                         step.NeedsReviewRuleCount > 0
                                     ))
                                {
                                    <div class="small text-muted mt-2">

                                        This may be an older scan created
                                        before individual finding storage
                                        was added.

                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <!-- =================================
                                 Violations
                                 ================================= -->

                            @if (violationFindings.Count > 0)
                            {
                                <section aria-labelledby="violations-step-@step.StepNumber"
                                         class="mb-4">

                                    <div class="d-flex
                                                flex-wrap
                                                justify-content-between
                                                align-items-end
                                                gap-2
                                                mb-3">

                                        <div>

                                            <h4 id="violations-step-@step.StepNumber"
                                                class="h5 mb-1">
                                                Violations
                                            </h4>

                                            <p class="small
                                                      text-muted
                                                      mb-0">
                                                Ordered by remediation
                                                priority.
                                            </p>

                                        </div>


                                        <span class="badge
                                                     text-bg-danger">
                                            @violationFindings.Count
                                        </span>

                                    </div>


                                    <div class="d-flex
                                                flex-column
                                                gap-3">

                                        @foreach (var finding
                                            in violationFindings)
                                        {
                                            string impactBadgeClass =
                                                finding.Impact?
                                                    .ToLowerInvariant()
                                                switch
                                                {
                                                    "critical" =>
                                                        "text-bg-danger",

                                                    "serious" =>
                                                        "text-bg-danger",

                                                    "moderate" =>
                                                        "text-bg-warning",

                                                    "minor" =>
                                                        "text-bg-info",

                                                    _ =>
                                                        "text-bg-secondary"
                                                };


                                            bool isFixFirst =
                                                (
                                                    string.Equals(
                                                        finding.Impact,
                                                        "critical",
                                                        StringComparison.OrdinalIgnoreCase) ||

                                                    string.Equals(
                                                        finding.Impact,
                                                        "serious",
                                                        StringComparison.OrdinalIgnoreCase)
                                                ) &&
                                                (
                                                    string.Equals(
                                                        finding.WcagLevel,
                                                        "A",
                                                        StringComparison.OrdinalIgnoreCase) ||

                                                    string.Equals(
                                                        finding.WcagLevel,
                                                        "AA",
                                                        StringComparison.OrdinalIgnoreCase)
                                                );


                                            <article class="border
                                                            border-danger
                                                            rounded
                                                            overflow-hidden">

                                                <div class="p-3">

                                                    <div class="d-flex
                                                                flex-wrap
                                                                justify-content-between
                                                                align-items-start
                                                                gap-3">

                                                        <div style="max-width: 800px;">

                                                            <div class="small
                                                                        text-muted
                                                                        mb-1">
                                                                @finding.RuleId
                                                            </div>


                                                            <h5 class="h6 mb-1">

                                                                @(string.IsNullOrWhiteSpace(
                                                                    finding.Help)
                                                                    ? finding.RuleId
                                                                    : finding.Help)

                                                            </h5>


                                                            @if (!string.IsNullOrWhiteSpace(
                                                                finding.Description))
                                                            {
                                                                <p class="small
                                                                          text-muted
                                                                          mb-0">
                                                                    @finding.Description
                                                                </p>
                                                            }

                                                        </div>


                                                        <div class="d-flex
                                                                    flex-wrap
                                                                    gap-2">

                                                            @if (isFixFirst)
                                                            {
                                                                <span class="badge
                                                                             text-bg-danger">
                                                                    Fix First
                                                                </span>
                                                            }


                                                            <span class="badge
                                                                         @impactBadgeClass">

                                                                @(string.IsNullOrWhiteSpace(
                                                                    finding.Impact)
                                                                    ? "Unknown"
                                                                    : finding.Impact)

                                                            </span>


                                                            @if (!string.IsNullOrWhiteSpace(
                                                                finding.WcagLevel))
                                                            {
                                                                <span class="badge
                                                                             text-bg-primary">
                                                                    WCAG
                                                                    @finding.WcagLevel
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge
                                                                             text-bg-secondary">
                                                                    Other / Best Practice
                                                                </span>
                                                            }


                                                            <span class="badge
                                                                         text-bg-dark">
                                                                @finding.AffectedElementCount
                                                                affected
                                                            </span>

                                                        </div>

                                                    </div>


                                                    @if (!string.IsNullOrWhiteSpace(
                                                        finding.WcagTags))
                                                    {
                                                        <div class="small
                                                                    text-muted
                                                                    mt-3">

                                                            <strong>
                                                                WCAG tags:
                                                            </strong>

                                                            @finding.WcagTags

                                                        </div>
                                                    }


                                                    <!-- =====================
                                                         Finding actions
                                                         ===================== -->

                                                    <div class="d-flex
                                                                flex-wrap
                                                                gap-2
                                                                mt-3">

                                                        @if (!string.IsNullOrWhiteSpace(
                                                            finding.HelpUrl))
                                                        {
                                                            <a href="@finding.HelpUrl"
                                                               target="_blank"
                                                               rel="noopener noreferrer"
                                                               class="btn
                                                                      btn-sm
                                                                      btn-outline-primary">

                                                                Rule Guidance

                                                                <span class="visually-hidden">
                                                                    opens in a new tab
                                                                </span>

                                                            </a>
                                                        }


                                                        @if (finding.RemediationItemId.HasValue)
                                                        {
                                                            <a asp-controller="AccessibilityRemediations"
                                                               asp-action="Details"
                                                               asp-route-id="@finding.RemediationItemId.Value"
                                                               class="btn
                                                                      btn-sm
                                                                      btn-success">

                                                                View Remediation

                                                                @if (!string.IsNullOrWhiteSpace(
