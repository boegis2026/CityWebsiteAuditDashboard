@model CityWebsiteAuditDashboard.Services.AuditAgent.AuditAgentConnectionStatus

@{
    ViewData["Title"] = "Audit Agent connection";

    var losAngelesTimeZone =
        TimeZoneInfo.FindSystemTimeZoneById("Pacific Standard Time");

    bool recentlySeen =
        Model is not null &&
        DateTimeOffset.UtcNow - Model.LastSeenAt <
            TimeSpan.FromSeconds(45);
}

<h1>Your Audit Agent</h1>
<p>Signed in as <strong>@User.Identity?.Name</strong>. Browser controls use the Agent connected for this account.</p>
@if (ViewBag.LocalAgentStatus is string localStatus)
{
    <p class="alert alert-info" role="status">@localStatus</p>
}
else
{
    <p>Open City Website Audit Agent on your workstation. It signs in using your Windows account; no pairing key is needed.</p>
}


<p>
    Check the workstation connection and open a URL in Edge on that workstation.
</p>

@if (Model is null)
{
    <p class="alert alert-secondary" role="status">
        No Agent is connected for your account.
    </p>
}
else
{
    <p class="alert @(recentlySeen ? "alert-success" : "alert-warning")"
       role="status">
        @(recentlySeen
            ? "Agent connected."
            : "Agent connection may have been lost.")
    </p>

    <dl>
        <dt>Workstation</dt>
        <dd>@Model.MachineName</dd>

        <dt>Connected at — Los Angeles time</dt>
        <dd>
            @TimeZoneInfo.ConvertTime(
                Model.ConnectedAt,
                losAngelesTimeZone
            ).ToString("MM/dd/yyyy h:mm:ss tt")
        </dd>

        <dt>Last contact — Los Angeles time</dt>
        <dd>
            @TimeZoneInfo.ConvertTime(
                Model.LastSeenAt,
                losAngelesTimeZone
            ).ToString("MM/dd/yyyy h:mm:ss tt")
        </dd>
    </dl>
}

@if (TempData["AgentOpenUrlStatus"] is string message)
{
    <p class="alert alert-info" role="status">@message</p>
}

<form method="post" action="@Url.Action("OpenUrl", "AuditAgent")">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label for="startingUrl" class="form-label">URL to open on the workstation</label>
        <input id="startingUrl"
               name="startingUrl"
               type="url"
               class="form-control"
               placeholder="https://example.org/"
               maxlength="2048"
               required />
    </div>
    @if (recentlySeen)
    {
        <button type="submit" class="btn btn-primary">Open URL in Edge</button>
    }
    else
    {
        <button type="submit" class="btn btn-primary" disabled>Open URL in Edge</button>
    }
</form>

<p class="mt-3">
    This opens a separate Edge window on the Agent workstation.
    Use Start Audit on the authenticated audits page to create a scannable session.
</p>

<p>
    <a asp-controller="AuditAgent"
       asp-action="Index"
       class="btn btn-primary">
        Refresh connection status
    </a>
</p>

<p>
    Start, Scan, Batch, and automatic workflow controls now use the connected workstation Agent. This diagnostic button is unavailable while an audit session is active.
</p>

<p>
    <a asp-controller="AuthenticatedAudits"
       asp-action="Index">
        Return to authenticated audits
    </a>
</p>
